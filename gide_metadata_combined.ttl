        <https://idr.openmicroscopy.org/study/idr0020/#screen-biosample-1> ;
    schema1:author <https://idr.openmicroscopy.org/study/idr0020/#person-1> ;
    schema1:copyrightNotice "Barr et al, CC-BY-4.0, 2017" ;
    schema1:datePublished "2017-01-18" ;
    schema1:description "We used a sensitised RNAi screen to identify genes that genetically interact with the evolutionary conserved, spindle assembly protein, ch-TOG/CKAP5.  Briefly, we generated cell lines carrying doxycycline inducible non-silencing (NS) shRNA or a ch-TOG specific shRNA.  We performed an siRNA screen in these two backgrounds to find genes that modify the ch-TOG mitotic phenotype." ;
    schema1:identifier "idr0020" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Identifying a ch-TOG genetic interaction network required for spindle assembly" ;
    schema1:publisher <https://idr.openmicroscopy.org/> ;
    schema1:size <https://idr.openmicroscopy.org/study/idr0020/#file-count>,
        <https://idr.openmicroscopy.org/study/idr0020/#total-dataset-size> ;
    schema1:thumbnailUrl "https://idr.openmicroscopy.org/webgateway/render_thumbnail/1911858/" ;
    rdfs:seeAlso <https://doi.org/10.1038/srep10564> .

