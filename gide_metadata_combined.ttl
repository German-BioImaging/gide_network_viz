<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1176#3ca1c627-5044-4d3b-a6aa-a5393a736c30> a schema1:LabProtocol ;
    schema1:description "A Plan-Apochromat 20x objective with a 1x camera adapter was used in conjunction with a pco.edge 4.2 4MP camera. Images were captured at 20X objective magnification with a pixel size of 0.326 µm. Autofocus was employed with 7 focal planes acquired using a 5 µm step size. Flat field correction was enabled with intensity statistics for compensation. Four filter sets were employed: Dapi-Q (20 ms exposure, 9% excitation intensity), Cy5-Q (20 ms exposure, 68% excitation intensity), FITC (25 ms exposure, 55% excitation intensity), and TRITC (20 ms exposure, 10% excitation intensity). All channels were acquired with 8-bit depth and saved in JPEG format at 90% quality." ;
    schema1:labEquipment "Pannoramic SCAN 150 scanner" ;
    schema1:measurementTechnique obo:FBbi_00000345 ;
    schema1:name "IF-Imaging-Set2" .

