<https://ssbd.riken.jp/repository/ssbd-repos-000406/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000265,
        <https://ssbd.riken.jp/repository/ssbd-repos-000406/#imaging-protocol-1> ;
    schema1:about obo:NCBITaxon_9606 ;
    schema1:author <https://ssbd.riken.jp/repository/ssbd-repos-000406/#auth-001> ;
    schema1:datePublished "2025-03-26" ;
    schema1:description "HT1080 human sarcoma cells were transduced with lentivirus expressing  a two-color fluorescent ubiquitination-based cell cycle indicator [Fucci(CA)] (Sakaue-Sawano, A. et al., Mol. Cell 68 (3): 626-640.e5 (2017). PMID 29107535). The cells were subjected to time-lapse imaging using KEYENCE BZ-X800 with a PlanFluor ×20 objective lens (NA = 0.45, WD = 8.80–7.50 mm, Ph1; KEYENCE).  In KEYENCE BZ-X810, Fucci mCherry and mVenus signals were detected using a TRITC filter (Ex, 545/25 nm; Em, 605/70 nm; KEYENCE) and mVenus filter (Ex, 500/20; Em, 535/30 nm; M SQUARE), respectively. 67.3 um x 67.3 um images were acquired every 15 min for 76.5 hours." ;
    schema1:identifier "ssbd-repos-000406" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Time lapse images of HT1080 cells expressing Fucci cell cycle reporter" ;
    schema1:publisher <https://ssbd.riken.jp/repository> ;
    schema1:size <https://ssbd.riken.jp/repository/ssbd-repos-000406/#file-count>,
