<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD976> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000249,
        obo:FBbi_00000253,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD976#2e2b115e-afab-45d2-9303-25b51b28b6db>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD976#3f7f198a-106f-4568-83cb-922b9dd8afe5> ;
    schema1:about obo:NCBITaxon_10090,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD976#1a22f81e-ed3e-42ff-a7e1-3243c9a1eefe> ;
    schema1:author <https://orcid.org/0000-0002-2214-2806>,
        <https://orcid.org/0000-0003-0357-7422>,
        <https://orcid.org/0000-0003-0960-6781> ;
    schema1:datePublished "2023-12-20" ;
    schema1:description "Most neurological disorders share a phenotype of synaptic dysfunction. High-content microscopy is indispensable in the drug discovery process but the sensitivity relies on the accuracy of mature synapse detection. We present a workflow whereby synchronous calcium bursting is measured in GCaMP6f-transduced neurons. The same cultures are then subjected to Proximity Ligation Assay (PLA) to label mature synapses, the neurite network and nuclei. The integration of functional and morphological information provides a rich fingerprint of neuronal connectivity, deployable in different experimental conditions. " ;
    schema1:identifier "S-BIAD976" ;
    schema1:keywords "High-content microscopy",
        "Neuronal Connectivity" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "Quantification of morpho-functional synaptic connectivity in dissociated neuronal cultures " ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD976#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD976#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
    schema1:thumbnailUrl "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD976/9c6c0f48-d0b7-4bcc-a2ae-15db411e1170/f16951dd-4df9-4e21-a736-d1e860016e8a.png" .

