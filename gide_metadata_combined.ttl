    schema1:about obo:CLO_0008172,
        <https://ssbd.riken.jp/v3/project/378-Minegishi-MetastaticNiche#biosample-1>,
        <https://ssbd.riken.jp/v3/project/378-Minegishi-MetastaticNiche#biosample-2>,
        <https://ssbd.riken.jp/v3/project/378-Minegishi-MetastaticNiche#biosample-3>,
        <https://www.ncbi.nlm.nih.gov/datasets/taxonomy/10090> ;
    schema1:author <https://ssbd.riken.jp/v3/project/378-Minegishi-MetastaticNiche#auth-001>,
        <https://ssbd.riken.jp/v3/project/378-Minegishi-MetastaticNiche#auth-002>,
        <https://ssbd.riken.jp/v3/project/378-Minegishi-MetastaticNiche#auth-003>,
        <https://ssbd.riken.jp/v3/project/378-Minegishi-MetastaticNiche#auth-004>,
        <https://ssbd.riken.jp/v3/project/378-Minegishi-MetastaticNiche#auth-005>,
        <https://ssbd.riken.jp/v3/project/378-Minegishi-MetastaticNiche#auth-006>,
        <https://ssbd.riken.jp/v3/project/378-Minegishi-MetastaticNiche#auth-007> ;
    schema1:datePublished "2024-12-23" ;
    schema1:description "Cancer cells inevitably interact with neighboring host tissue-resident cells during the process of metastatic colonization, establishing a metastatic niche to fuel their survival, growth, and invasion. However, the underlying mechanisms in the metastatic niche are yet to be fully elucidated owing to the lack of methodologies for comprehensively studying the mechanisms of cell–cell interactions in the niche. The authors improve a split green fluorescent protein (GFP)-based genetically encoded system to develop secretory glycosylphosphatidylinositol-anchored reconstitution-activated proteins to highlight intercellular connections (sGRAPHIC) for efficient fluorescent labeling of metastatic niche between tissue-resident cells and cancer cells." ;
    schema1:funder <https://ssbd.riken.jp/v3/project/378-Minegishi-MetastaticNiche#grant-001> ;
    schema1:identifier "378-Minegishi-MetastaticNiche" ;
    schema1:keywords "Cell Communication",
        "Microscopy, Confocal, Time-Lapse Imaging",
        "NIH 3T3 Cells" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Fluorescent labeling of cell-cell interaction using sGRAPHIC" ;
    schema1:publisher <https://ssbd.riken.jp/database> ;
    schema1:size <https://ssbd.riken.jp/v3/project/378-Minegishi-MetastaticNiche#file-count>,
        <https://ssbd.riken.jp/v3/project/378-Minegishi-MetastaticNiche#total-dataset-size> ;
    schema1:thumbnailUrl "https://ssbd.riken.jp/ssbd-omero/v1/projects/1401/render_thumbnail/" ;
    rdf:seeAlso <https://doi.org/1038/s41467-023-43855-2> .

