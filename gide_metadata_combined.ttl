<https://ssbd.riken.jp/v3/project/306-Kamei-microglia> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000249,
        obo:FBbi_00000254,
        <https://ssbd.riken.jp/v3/project/306-Kamei-microglia#imaging-protocol-1>,
        <https://ssbd.riken.jp/v3/project/306-Kamei-microglia#imaging-protocol-2> ;
    schema1:about <https://ssbd.riken.jp/v3/project/306-Kamei-microglia#biosample-1>,
        <https://www.ncbi.nlm.nih.gov/datasets/taxonomy/10090> ;
    schema1:author <https://ssbd.riken.jp/v3/project/306-Kamei-microglia#auth-001>,
        <https://ssbd.riken.jp/v3/project/306-Kamei-microglia#auth-002> ;
    schema1:datePublished "2024-12-14" ;
    schema1:description "The phagocytosis of dead cells by microglia is essential in brain development and homeostasis. However, the mechanism underlying the efficient removal of cell corpses by ramified microglia remains poorly understood. Here, the authors investigated the phagocytosis of dead cells by ramified microglia in the hippocampal dentate gyrus, where adult neurogenesis and homeostatic cell clearance occur. Two-color imaging of microglia and apoptotic newborn neurons revealed two important characteristics. Firstly, frequent environmental surveillance and rapid engulfment reduced the time required for dead cell clearance. The motile microglial processes frequently contacted and enwrapped apoptotic neurons at the protrusion tips and completely digested them within 3–6 h of the initial contact. Secondly, while a single microglial process engaged in phagocytosis, the remaining processes continued environmental surveil- lance and initiated the removal of other dead cells. The simultaneous removal of multiple dead cells increases the clearance capacity of a single microglial cell." ;
    schema1:funder <https://ssbd.riken.jp/v3/project/306-Kamei-microglia#grant-001> ;
    schema1:identifier "306-Kamei-microglia" ;
    schema1:keywords "Neuroglia",
        "Neurons",
        "Time-Lapse Imaging" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "In vivo imaging of the phagocytic dynamics underlying efficient clearance of adult-born hippocampal granule cells by ramified microglia" ;
    schema1:publisher <https://ssbd.riken.jp/database> ;
    schema1:size <https://ssbd.riken.jp/v3/project/306-Kamei-microglia#file-count>,
        <https://ssbd.riken.jp/v3/project/306-Kamei-microglia#total-dataset-size> ;
    schema1:thumbnailUrl "https://ssbd.riken.jp/ssbd-omero/v1/projects/1363/render_thumbnail/" ;
    rdf:seeAlso <https://doi.org/10.1002/glia.24379> .

