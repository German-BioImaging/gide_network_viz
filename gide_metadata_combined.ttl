<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1248> a schema1:Dataset ;
    dwciri:measurementMethod <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1248#515d6f9c-e7ee-4f8a-812c-47eb44a9bc64> ;
    schema1:about obo:NCBITaxon_9606,
