<https://www.ebi.ac.uk/biostudies/bioimages/studies/EMPIAR-10672#6db99b69-63d6-4f41-a919-35012da071e8> a schema1:BioSample ;
    schema1:description "Cultured free-living Phaeocystis cordata (strain RCC1383 from Roscoff Culture Collection), used as control for comparison with symbiotic cells. Maintained at 20°C in K5 culture medium at 100 μmol photons m⁻²s⁻¹." ;
    schema1:name "_:Free-living Phaeocystis cordata" ;
    schema1:taxonomicRange obo:NCBITaxon_280463 .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/EMPIAR-10672#a2a9d522-831a-4d6b-9346-3e6d57364e3e> a schema1:LabProtocol ;
    schema1:description "3D acquisition performed using FIB-SEM (Crossbeam 540, Carl Zeiss Microscopy GmbH) with Atlas3D software (Fibics Inc. and Carl Zeiss Microscopy GmbH). A 1-μm platinum protective coat was deposited with 1.5 nA FIB current. Rough trench milled at 15 nA FIB current, followed by polish at 7 nA. 3D acquisition milling conducted with 1.5 nA FIB current. SEM imaging at 1.5 kV/700 pA in analytic mode using energy-selective backscattered detector (1.1 kV grid collector voltage), 8 μs dwell time with no line averaging. Voxel size: 5 or 10 nm. Datasets aligned using Fiji plugin 'Linear Stack Alignment with SIFT' and fine-tuned by AMST (Alignment to Median Smoothed Template)." ;
    schema1:labEquipment "Crossbeam 540 FIB-SEM (Carl Zeiss Microscopy GmbH)" ;
    schema1:measurementTechnique obo:FBbi_00000585 ;
    schema1:name "FIB-SEM 3D imaging protocol" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/EMPIAR-10672#ad6f7ccf-8bbf-46a0-af72-40a28d0b35f5> a schema1:Person ;
