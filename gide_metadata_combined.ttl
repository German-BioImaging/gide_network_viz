<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1157#13ed9b71-21fb-4750-b305-72f6582d2614> a schema1:BioSample ;
    schema1:description "Arabidopsis leaf protoplasts" ;
    schema1:name "Experiment HTI004" ;
    schema1:taxonomicRange obo:NCBITaxon_3702 .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1157#1d54991b-2bed-4128-b976-c974d074460f> a schema1:LabProtocol ;
    schema1:description """leaf protoplasts cultured in coverglass-bottom 96-well plates were imaged using a confocal microscope Cell Voyager (CV7000, Yokogawa), equipped with a 60x water immersion objective (Nikon, NA1.2) using a illumination by 100-200 mW lasers from Coherent (depending on the channel) and filters from Chroma. Images were acquired as 16-bit images using two Neo sCMOS cameras (Andor), pixel size 6.5 µm/M.
For each well, six regions of interest (ROI) corresponding to a field of view of 277 µm x 234 µm with an image format of 2560 x 2160 pixels over 16 z planes with a step of 1 µm. ROIs were randomly chosen without overlap. Imaging time for one well = 90 seconds; Imaging time for one plate (60 wells) = 90 minutes. """ ;
    schema1:labEquipment "Cell Voyager" ;
    schema1:measurementTechnique obo:FBbi_00000243 ;
    schema1:name "High throughput images of leaf protoplasts cultured in multi-well plates" .

