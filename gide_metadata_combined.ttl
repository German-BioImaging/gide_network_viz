<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1200> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1200#1f2527f1-e93c-420d-878f-62dc214e190c> ;
