<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2062#6d64ee44-f70a-4389-bfbd-c7ef1b273baf> a schema1:LabProtocol ;
    schema1:description "The reaction was revealed with 0.03% 3,3-diaminobenzidine (DAB) in PBS/0.03% containing 0.03% hydrogen peroxide, and counterstained with Harris hematoxylin. Images of the sections were obtained under 400x or 600x magnifications and analyzed with the help of the Image Pro software Media Cybernetics. Each islet were evaluated by the Axion Vision s40 4.8 2.0 software (Axion Vs40 4.8 2.0 Carl Zeiss MicroImaging Gmbh)." ;
    schema1:labEquipment "Pancreatic sections of 19-day fetuses were photographed at a magnification of 400 × OR 600x under an optical microscope (Nikon’s Eclipse E600) equipped with a Nikon DP72 CCD digital camera." ;
    schema1:measurementTechnique obo:FBbi_00000243 ;
    schema1:name "Immunohistochemistry for laminin alpha 1" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2062#e03bd4db-a5de-4e11-bb17-3999edf691bb> a schema1:Organization ;
