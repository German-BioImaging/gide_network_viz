<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1389#894af27c-7e78-4cd2-ade8-a10e30f01c24> a schema1:LabProtocol ;
    schema1:description "Images for migration analysis were acquired in 1024x1024 mode using confocal microscope (TCS SP8X; Leica) at 20X magnification with a z stack of 1,5 μm. For in vivo CC analysis: Images were acquired using a Zeiss Axio Observer 7 microscope equipped with a 10x/0.45 plan Apochromat objective controlled by zen 3.3 software, with a CMOS sensor camera (Hamamatsu Orca Flash 4.0 LT Plus). Primary neurons were imaged once every day from DIV3 to DIV10 using a Zeiss Axio Observer 7 microscope equipped with a 10x/0.45 plan Apochromat objective controlled by Zen 3.3 software, with a CMOS sensor camera (Hamamatsu Orca Flash 4.0 LT Plus) and an incubation chamber (37°C, 5% CO2)." ;
    schema1:labEquipment "Nanozommer 2.0HT, C9600 series at 20× resolution for mouse brain at P60. TCS SP8X; Leica for migration studies and Axio Observer 7 microscope for CC analysis and primary neurons recordings." ;
    schema1:measurementTechnique obo:FBbi_00000246,
        obo:FBbi_00000251 ;
    schema1:name "Image acquisition" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1390> a schema1:Dataset ;
    dwciri:measurementMethod <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1390#8e999083-6a8d-4f1e-8b6e-493f756216d4> ;
