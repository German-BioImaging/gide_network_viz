    schema1:datePublished "2024-02-13" ;
    schema1:description "To identify novel secreted proteins that can modulate breast cancer G0 arrest, we performed a secretome-wide, image-based screen for proteins which alter the balance between proliferation and G0 arrest. From a secretome library of 1282 purified proteins, we identified 29 candidates that promote G0 arrest in non-transformed (hTERT-HMEC) and transformed (MCF7) breast epithelial cells. " ;
    schema1:identifier "S-BIAD1013" ;
    schema1:keywords "Cancer",
        "Cell Cycle",
        "Proliferation",
        "Quiescence",
        "Screen",
        "Secretome" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "An image-based screen for secreted proteins involved in breast cancer G0 cell cycle arrest" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
