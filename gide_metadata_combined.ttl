<https://ssbd.riken.jp/v3/project/337-Isoe-BrainRegion> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000369,
        <https://ssbd.riken.jp/v3/project/337-Isoe-BrainRegion#imaging-protocol-1> ;
    schema1:about <https://ssbd.riken.jp/v3/project/337-Isoe-BrainRegion#biosample-1>,
        <https://ssbd.riken.jp/v3/project/337-Isoe-BrainRegion#biosample-2>,
        <https://www.ncbi.nlm.nih.gov/datasets/taxonomy/8090> ;
    schema1:author <https://ssbd.riken.jp/v3/project/337-Isoe-BrainRegion#auth-001>,
        <https://ssbd.riken.jp/v3/project/337-Isoe-BrainRegion#auth-002> ;
    schema1:datePublished "2024-12-14" ;
    schema1:description "The dorsal telencephalon (i.e. the pallium) exhibits high anatomical diversity across vertebrate classes. The non-mammalian dorsal pallium accommodates various compartmentalized structures among species. The developmental, functional, and evolutional diversity of the dorsal pallium remain unillustrated. Here, the authors analyzed the structure and epigenetic landscapes of cell lineages in the telencephalon of medaka fish (Oryzias latipes) that possesses a clearly delineated dorsal pallium (Dd2). They found that pallial anatomical regions, including Dd2, are formed by mutually exclusive clonal units, and that each pallium compartment exhibits a distinct epigenetic landscape." ;
    schema1:funder <https://ssbd.riken.jp/v3/project/337-Isoe-BrainRegion#grant-001> ;
    schema1:identifier "337-Isoe-BrainRegion" ;
    schema1:keywords "Neurogenesis" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "3D medaka brain visualized clonally related units in the pallium" ;
    schema1:publisher <https://ssbd.riken.jp/database> ;
    schema1:size <https://ssbd.riken.jp/v3/project/337-Isoe-BrainRegion#file-count>,
        <https://ssbd.riken.jp/v3/project/337-Isoe-BrainRegion#total-dataset-size> ;
    schema1:thumbnailUrl "https://ssbd.riken.jp/ssbd-omero/v1/projects/1362/render_thumbnail/" ;
    rdf:seeAlso <https://doi.org/10.7554/eLife.85093> .

