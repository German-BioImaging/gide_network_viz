<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1257#8fc4a05b-e581-475a-91b8-903117dfaf3f> a schema1:LabProtocol ;
    schema1:description "TCS SP8 X confocal microscope with a 40X objective (NA 1.3), 4 HyD and 1 PMT detectors, a white light laser that produces a continuous spectral output between 470 and 670 nm as well as 405, 685, and 730 nm lasers. Panels consisted of antibodies conjugated to the following fluorophores and dyes: Hoechst, Alexa Fluor (AF)488, FITC, AF532, phycoerythrin (PE), eF570, AF555, iFluor (iF)594, AF647, eF660, AF680, and AF700. All images were captured at an 8-bit depth, with a line average of 3, and 1024x1024 format with the following pixel dimensions: x (0.284 μm), y (0.284 μm), and z (1 μm). Images were tiled and merged using the LAS X Navigator software (LAS X 3.5.7.23225)." ;
    schema1:labEquipment "Confocal microscope" ;
    schema1:measurementTechnique obo:FBbi_00000251 ;
    schema1:name "confocal microscopy IBEX" .

