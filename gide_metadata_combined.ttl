<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1274#11753e1b-85d1-45bd-aeb8-896d9050bcd1> a schema1:Person ;
    schema1:affiliation <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1274#f9c71eac-d3c3-4095-b28b-a654d9a7f94b> ;
