<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD848> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD848#16bcaee1-e108-4fa3-b22d-5af80941a713> ;
    schema1:about obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD848#7f742f25-d8da-4118-bbed-be7c1de5fb40> ;
    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD848#67ba86a2-c617-42fb-a073-e18b0ab992a0> ;
    schema1:datePublished "2023-08-15" ;
    schema1:description "OME-NGFF converted study from idr0033.  We hypothesized that human genes and disease-associated alleles might be systematically functionally annotated using morphological profiling of cDNA constructs, via a microscopy-based Cell Painting assay. Indeed, 50% of the 220 tested genes yielded detectable morphological profiles, which grouped into biologically meaningful gene clusters consistent with known functional annotation (e.g., the RAS-RAF-MEK-ERK cascade). We used novel subpopulation-based visualization methods to interpret the morphological changes for specific clusters. This unbiased morphologic map of gene function revealed TRAF2/c-REL negative regulation of YAP1/WWTR1-responsive pathways. We confirmed this discovery of functional connectivity between the NF-kB pathway and Hippo pathway effectors at the transcriptional level, thereby expanding knowledge of these two signaling pathways that critically regulate tumor initiation and progression. We make the images and raw data publicly available, providing an initial morphological map of major biological pathways for future study." ;
    schema1:identifier "S-BIAD848" ;
    schema1:keywords "morphological profiling, gene functional annotation, Hippo Pathway, NF-kB pathway" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Systematic morphological profiling of human gene and allele function via Cell Painting (OME-NGFF)" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD848#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD848#480bb0bc-db43-46e5-88ae-071380b9d63c> .

