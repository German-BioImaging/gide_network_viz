    schema1:description "Studying the asymmetry when the strength of regulation for Transcription factor is kept fixed (O1 operator) and the strength of regulation for target is altered (stronger than TF, same as TF or weaker than TF)." ;
    schema1:name "cell" ;
    schema1:taxonomicRange obo:NCBITaxon_562 .

