<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2273> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2273#3324d6d8-6bca-4f82-a11a-39aad8fc9413> ;
    schema1:about obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2273#2ea89bda-aed4-420b-9808-3c94526d3bd3>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2273#7f8a5c8c-eec7-4360-8dfd-410e36108369>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2273#81215f8c-8bd0-4a8e-85cb-3fb90a173bfd>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2273#9ddc8109-6b95-4faa-b190-d3294ecb72a5>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2273#9fbaae41-27f3-498d-aa7a-c80133d5f580>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2273#fad3eb22-68b5-4422-8c14-3b90e14592af> ;
    schema1:author <https://orcid.org/0000-0002-4460-0812>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2273#5aaa852d-b777-42f8-875a-30f581ff6660> ;
    schema1:datePublished "2025-09-10" ;
    schema1:description "Abstract: Relapse and treatment resistance are common in children with high-risk neuroblastoma, and novel therapies are needed. Conventional drug discovery is slow, expensive, often fails in practice, and consequently falls short in addressing pediatric and rare conditions. In such instances, drug repurposing is a promising strategy. Here, we used two independent in silico prediction tools including machine learning to identify approved drugs for repurposing against neuroblastoma. The combination of statins and phenothiazines showed strong synergistic effects in human neuroblastoma organoids, decreased tumor growth and prolonged survival in MYCN-amplified neuroblastoma patient-derived xenografts. The drug combination altered cholesterol metabolism through two different mechanisms and induced a phenotypic change towards an adrenergic state in vitro, which was associated with enhanced chemosensitivity. Integration of the drug combination into standard-of-care chemotherapy regressed tumors and prolonged survival in chemoresistant patient-derived xenografts. Thus, a combination of safe and approved medications added to standard-of-care chemotherapy outperforms chemotherapy alone in chemoresistant neuroblastoma." ;
    schema1:identifier "S-BIAD2273" ;
    schema1:keywords "cancer",
        "chemoresistance",
        "drug repurposing",
        "in silico predictions",
        "machine learning",
        "neuroblastoma",
        "phenothiazine",
        "prochlorperazine",
        "statin" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Repurposing statins and phenothiazines to treat chemoresistant neuroblastoma" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2273#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2273#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
    schema1:thumbnailUrl "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD2273/45155091-d8da-4f36-82ca-f1919e1f199d/static_display_512_512.png" .

