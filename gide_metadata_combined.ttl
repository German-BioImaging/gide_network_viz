        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1800#bf7553d8-6ee2-475b-b11b-a2798913649b> ;
    schema1:about obo:NCBITaxon_4513,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1800#01033014-7b1b-47d4-a148-da58656bfef7>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1800#193ceec8-74e8-4378-b3be-8e3c6e0d984f>,
