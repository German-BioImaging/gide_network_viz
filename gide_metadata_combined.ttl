        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1488#d50a12e9-1815-404c-80f2-2c930106a9d7>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1488#d7724ace-a5e0-48c3-9734-9a2da04a4cda>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1488#f0f3f3ac-5175-41a1-929d-8bd713bab5e0>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1488#f1523fbd-ce75-4d39-b222-21a5393ac963> ;
    schema1:datePublished "2024-12-08" ;
    schema1:description "To extend the resolution of optical microscopy towards that achievable by electron microscopy, whilst allowing multi-color visualization of tissues in 3D, we have developed a potassium (poly)acrylate-based expansion microscopy (ExM) platform, compatible with strong fixation reagents such as GA for better preserving transgenic fluorescence proteins, with an axicon-based Bessel lightsheet microscope equipped with long-working distance objectives and long travelling distance voice-coil stages. The good mechanical strength of our hydrogels could be mounted and translated in 3D for sample scanning via lightsheet imaging. At a tile scanning speed of ~1 min/mm3 with 1012 pixels over 14 hours, we imaged the centimeter-sized fly brain at an effective resolution comparable to electron microscopy." ;
    schema1:identifier "S-BIAD1488" ;
    schema1:keywords "Fly brain",
        "Lightsheet microscopy",
        "expansion microscopy",
        "potassium (poly)acrylate" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Lightsheet Imaging of Potassium Acrylate-based Expansion Microscopy data sets" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1488#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1488#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
