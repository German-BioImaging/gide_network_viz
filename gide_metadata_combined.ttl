    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "High-content live-cell time-lapse imaging predicts cells about to die via apoptosis" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2515#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
