        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1045#6442c8d5-3289-4e5e-99b7-a4eb024ee350>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1045#6dd0f9cd-7a35-4e28-8917-d4a011ef6870>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1045#82004a7a-87eb-46bb-8125-759b207de5c1>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1045#84fd706b-c4d8-4331-bcfc-b6440f5452d6>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1045#9b3e40cd-c48a-42ee-85a5-0e279584a3c1>,
