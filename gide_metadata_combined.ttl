<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2005> a schema1:Dataset ;
    dwciri:measurementMethod <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2005#a6bbb5b3-4226-46e6-bb1b-ebd514e58c53> ;
    schema1:about <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2005#26b57820-3935-4ab6-8d9a-7205faa2e984> ;
    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2005#08e5041c-21cb-4f5c-8616-5719fc1d46b4>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2005#29fb12ad-e440-41ce-8304-e6739f2556cb>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2005#487d85b4-b4c7-4285-951b-e8590c6cbcff>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2005#89b9301e-59a0-4ed4-b726-b441fe2fe4ba>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2005#a2dc31f3-563d-4143-b1fc-0af123fde22d> ;
    schema1:datePublished "2025-06-10" ;
    schema1:description """The data includes images recorded via a towed video frame in the Belgian Part of the North Sea. They show the seafloor, captured at a perpendicular angle, as well as various organisms living on it. Furthermore, text files containing point annotations of the organisms created with the program "papara(zz)i" are included. A label tree exported from the web tool "BIIGLE" is included as well. The goal of the associated project was to transform the existing point annotations to polygons and to attach a label from the included label tree to the newly created annotations. 

This data was selected as part of the AI4Life Open Calls 2023 for image analysis consultation and deep-learning applications.""" ;
    schema1:identifier "S-BIAD2005" ;
    schema1:keywords "AI4Life Open Call" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "AI4Life OC2 Project #11: Automated species annotation in turbid waters" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2005#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
