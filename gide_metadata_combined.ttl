        "Spheroids, Cellular",
        "Time-Lapse Imaging/instrumentation",
        "Time-Lapse Imaging/methods[major]",
        "Tumor Cells, Cultured",
        "Zebrafish" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Time-lapse 3D imaging data of cell nuclei" ;
    schema1:publisher <https://ssbd.riken.jp/repository> ;
