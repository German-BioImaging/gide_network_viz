        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1176#7bffce9c-19fe-4c18-9003-f915de93afad> ;
    schema1:about obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1176#76527dff-48bd-4afe-bc56-29cad3e3fb0c> ;
    schema1:author <https://orcid.org/0000-0002-0008-5513>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1176#49baad05-3778-4f34-bf48-ef9d7117fe1e>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1176#856e1804-8852-4f98-87af-4ce50d4b4b54>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1176#90e35895-22d8-414e-9683-bc3eca37eda6>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1176#cc636a2a-7c94-4547-b58f-4056ce9bcca0> ;
    schema1:datePublished "2025-08-10" ;
    schema1:description "Tumor heterogeneity drives drug resistance and relapse in breast cancer. This study examined spatial proteomic heterogeneity using integrated multi-region spatial mass spectrometry proteomics, exome sequencing, and imaging across 280 tumor regions. For the imaging component, 121 regions from 47 tissue sections across 11 tumors were analyzed. Consecutive tissue slices underwent different staining and imaging techniques. Pathologist-selected regions (based on H-DAB staining for ER, PR, HER2, and panCK) were laser captured for proteomic analysis. Additional staining for immune and stromal markers (CD31, alpha-SMA, Pan-CK, CD68, CD3, and DAPI) allowed for the assessment of blood vessel coverage, spatial distribution of tumor and immune cells, and stromal composition within and surrounding these regions." ;
    schema1:identifier "S-BIAD1176" ;
    schema1:keywords "breast cancer",
        "intra tumor heterogeneity ",
        "spatial proteomics",
        "tumor microenvironment" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Integrated spatial proteomic analysis of breast cancer heterogeneity unravels mechanisms of cancer cell phenotypic plasticity" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1176#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1176#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
    schema1:thumbnailUrl "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD1176/11972a9b-cf3f-481f-b8f2-54781672ecf1/static_display_512_512.png" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1176#1037e7dd-b10a-47a1-885c-1f3b2998ff1c> a <https://www.ebi.ac.uk/biostudies/bioimages/studies/QuantitiveValue> ;
    schema1:unitCode "http://purl.obolibrary.org/obo/UO_0000189" ;
