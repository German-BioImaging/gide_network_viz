<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD705#d5bd9beb-c7eb-44fb-82b2-2f912f733c9c> a schema1:LabProtocol ;
    schema1:description "Hydrogels containing optically-coded micro-particles (with or without cells) in culture medium were gently loaded on a glass-bottom 6 well plate (MatTek Corporation) covered by a round-shaped cover glass (Matsunami Corp.). Unit images were recorded on InCellAnalyzer6000 (GE Healthcare) at x10 magnification. For each view, z-stack images (5-um pitch) at five channels (DAPI, FITC, dsRed, Cy5, brightfield) as well as a phase contrast image at the central z-position. " ;
    schema1:labEquipment "InCellAnalyzer6000 (GE Healthcare)" ;
    schema1:measurementTechnique obo:FBbi_00000246 ;
    schema1:name "Image acquisition" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD709> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000251,
