<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1404#56750343-6304-443f-b91f-e238b809b6aa> a schema1:LabProtocol ;
    schema1:description "Unknown" ;
    schema1:labEquipment "Traditional microscopic acquisition " ;
    schema1:measurementTechnique obo:FBbi_00000241 ;
    schema1:name "Primary and lymph node (LN) tumor tissue sections from 10 HPV(+)OPSCC cases and 10 matched controls were interrogated by IMC using a panel of antibodies to immune and tumor cell markers (Table S1). Tissue sectioning and staining were performed by the Mayo Clinic Pathology Research Core. H&E-stained adjacent sections were used to select two to seven regions of interest (ROIs) per tissue section (approximately 4 m2 total per tissue), focusing on areas of primarily tumor, tumor and immune infiltrate, or tumor and stroma. Data from the ROIs were acquired by the Mayo Clinic Immune Monitoring Core using the Hyperion Imaging System (Standard BioTools, San Francisco, CA, USA)." .

