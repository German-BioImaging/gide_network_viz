<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1536#78750b5f-4b04-4f81-9e40-a4ef19f554de> a schema1:LabProtocol ;
    schema1:description "Coverslips were imaged with a Nikon Eclipse Ti using a Nikon Plan Apo λ 60x NA 1.40 with oil immersion or Nikon Plan Apo λ 20x NA 0.75 dry objective and the NIS Elements software. DAPI was imaged with DAPI filter (EX 390/18 DM 416 EM 460/60) with exposure time of 500 ms and analog gain of 1x. SIRF biosensor was imaged with EGFP filter (EX 472/39 DM 495 EM 520/35) with exposure time of 1 s and analog gain of 1x. Alexa594 stained proteins were imaged with TexasRED filter (EX 562/40 DM 593 EM 624/40) at 500 ms and analog gain of 1x. Alexa647 stained proteins were imaged with Cy5 filter (EX 632/22 DM 660 EM 692/40) at 1 s and analog gain of 1x. EX = excitation wavelength; DM = dichroic mirror; EM = emission wavelength. Notation: center wavelength [nm]/bandwidth [nm]." ;
    schema1:labEquipment "Inverted Nikon Ti2" ;
    schema1:measurementTechnique obo:FBbi_00000246 ;
    schema1:name "Inverted Nikon Ti2" .

