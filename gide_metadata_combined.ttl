        "Reward[major]",
        "Stereotaxic Techniques",
        "Virtual Reality",
        "Zebrafish/physiology[major]" ;
    schema1:license "https://creativecommons.org/licenses/by-nc/4.0/" ;
    schema1:name "Adult zebrafish's telencephalic neural activity and behavior data during the GO/NOGO tasks in the virtual reality environment." ;
    schema1:publisher <https://ssbd.riken.jp/repository> ;
    schema1:size <https://ssbd.riken.jp/repository/ssbd-repos-000223/#file-count>,
