    schema1:keywords "Cancer",
        "Cell Adhesion",
        "Cell Interaction",
        "Dissemination",
        "Human",
        "Human Cells",
        "MSC",
        "Mesenchymal Stromal Cells",
        "Metastasis",
        "Multiple Myeloma",
        "Plasma Cells",
        "Survival",
        "Time-lapse Microscopy" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Modelling Myeloma Dissemination in vitro with hMSC-Interacting Subpopulations of INA-6 Cells and their Aggregation/Detachment Dynamics" ;
