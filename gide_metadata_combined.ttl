<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1176#63334d70-8092-481d-a25b-77ce5dd722af> a schema1:LabProtocol ;
    schema1:description "A Plan-Apochromat 20x objective with a 1x camera adapter was used in conjunction with a pco.edge 4.2 4MP camera. Images were captured at 20X objective magnification with a pixel size of 0.326 µm. Autofocus was employed with 7 focal planes acquired using a 5 µm step size. Flat field correction was enabled with intensity statistics for compensation. Four filter sets were employed: Dapi-Q (20 ms exposure, 9% excitation intensity), Cy5-Q (85 ms exposure, 100% excitation intensity), FITC (20 ms exposure, 10% excitation intensity), and TRITC (20 ms exposure, 45% excitation intensity). All channels were acquired with 8-bit depth and saved in JPEG format at 90% quality." ;
    schema1:labEquipment "Pannoramic SCAN 150 scanner" ;
    schema1:measurementTechnique obo:FBbi_00000345 ;
    schema1:name "IF-Imaging-Set1" .

