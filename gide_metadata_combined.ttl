<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1673#5c0ecc65-4543-44b1-b6dc-0196ee4309e0> a schema1:LabProtocol ;
    schema1:description "Images were captured using a Zeiss LSM710 Confocal Laser Scanning Microscope equipped with an AxioCam (Zeiss) and C-Apochromat 40x water immersion objective. For all pictures the pinhole was set 1 airy unit for the longest wavelength and dimensions of 980 x 980 pixels was chosen. The EGFP fluorochrome (emission maximum: 509 nm) was excited at a wavelength of 488 nm by an argon laser and detected using a 488 nm single channel photomultiplier (PMT) and a 493-557 nm bandpass filter. The Spy650DNA was excited at a wavelength of 633 nm by helium-neon-laser and detected using a 644 - 735 nm bandpass filter. " ;
    schema1:labEquipment "Zeiss LSM 710" ;
    schema1:name "Foci Assay" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1673#9fb6ef2b-5627-4eee-9d7d-1ad9d2695ef7> a schema1:Person ;
