<https://www.ebi.ac.uk/biostudies/bioimages/studies/EMPIAR-12160#59cdd100-1c7e-4006-8e28-4f924aae6324> a schema1:LabProtocol ;
    schema1:description "Multiple coarse trenches were milled using a 30 kV@30 nA probe to choose regions of interest. Large trenches were smoothened using a 30 kV@1.5 nA FIB probe, followed by 30 kV@700 pA probe current for serial FIB milling. InLens secondary and backscattered electron microscopy images were simultaneously collected at 2.0 kV acceleration voltage with 500 pA probe current. Backscattered grid was set to -902 V. For noise reduction, images were acquired using line average (n=1) and dwell time of 3.0 μs. Atlas 3D software (Atlas Engine v5.3.3) was used for imaging control." ;
    schema1:labEquipment "Zeiss Crossbeam 550 FIB-SEM, Carl Zeiss" ;
    schema1:measurementTechnique obo:FBbi_00000243 ;
    schema1:name "FIB-SEM" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/EMPIAR-12160#b8b3b159-687b-4da1-ac0e-044c08cb0287> a schema1:BioSample ;
    schema1:description "NF54/iGP2 strain P. falciparum parasites cultured in human red blood cells, including both sexual stage gametocytes and asexual blood stages. Gametocytogenesis was induced by removal of glucosamine from culture medium." ;
