    schema1:author <https://ssbd.riken.jp/repository/ssbd-repos-000451/#auth-001>,
        <https://ssbd.riken.jp/repository/ssbd-repos-000451/#auth-002> ;
    schema1:datePublished "2025-11-28" ;
    schema1:description """HPLC-MS analysis revealed the presence of an\r
unreported peptide in the extract of the marine sponge Neopetrosia\r
sp. Its structure was determined as a tripeptide, named\r
neopetromin (1), composed of two tyrosine and one tryptophan\r
residues with a heteroaromatic C−N cross-link between side\r
chains. The absolute configuration of amino acids was determined\r
using Marfey’s method after ozonolysis and hydrolysis of 1.\r
Compound 1 promoted vacuole fragmentation in an actin-\r
independent manner in tobacco BY-2 cells.""" ;
    schema1:identifier "ssbd-repos-000451" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "The shape of vacuole and F-actin in tobacco BY-2 cells treated with neopetromin, a newly found peptide" ;
    schema1:publisher <https://ssbd.riken.jp/repository> ;
    schema1:size <https://ssbd.riken.jp/repository/ssbd-repos-000451/#file-count>,
        <https://ssbd.riken.jp/repository/ssbd-repos-000451/#total-dataset-size> ;
    rdf:seeAlso <https://doi.org/10.1021/acs.jnatprod.4c00158> .

