<https://ssbd.riken.jp/v2/project/299-Satoh-Endosome> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        obo:FBbi_00000249,
        obo:FBbi_00000251,
        <https://ssbd.riken.jp/v2/project/299-Satoh-Endosome#imaging-protocol-1>,
        <https://ssbd.riken.jp/v2/project/299-Satoh-Endosome#imaging-protocol-2>,
        <https://ssbd.riken.jp/v2/project/299-Satoh-Endosome#imaging-protocol-3> ;
    schema1:about obo:CLO_0001591,
        obo:GO_0005739,
        obo:GO_0005768,
        obo:GO_0005769,
        obo:GO_0005770,
        obo:GO_0007173,
        obo:GO_0048388,
        obo:GO_0070925,
        <https://ssbd.riken.jp/v2/project/299-Satoh-Endosome#biosample-1>,
        <https://www.ncbi.nlm.nih.gov/datasets/taxonomy/9606> ;
    schema1:author <https://ssbd.riken.jp/v2/project/299-Satoh-Endosome#auth-001>,
        <https://ssbd.riken.jp/v2/project/299-Satoh-Endosome#auth-002>,
        <https://ssbd.riken.jp/v2/project/299-Satoh-Endosome#auth-003> ;
    schema1:datePublished "2024-12-14" ;
    schema1:description "Intracellular organelles of mammalian cells communicate with one another during various cellular processes. The functions and molecular mechanisms of such interorganelle association remain largely unclear, however. The authors identify voltage-dependent anion channel 2 (VDAC2), a mitochondrial outer membrane protein, as a binding partner of phosphoinositide 3-kinase (PI3K), a regulator of clathrin-independent endocytosis downstream of the small GTPase Ras. VDAC2 tethers endosomes positive for the Ras-PI3K complex to mitochondria in response to cell stimulation with epidermal growth factor and promotes clathrin-independent endocytosis, as well as endosome maturation at membrane association sites. With an optogenetics system to induce mitochondrion-endosome association, the authors find that, in addition to its structural role in such association, VDAC2 is functionally implicated in the promotion of endosome maturation." ;
    schema1:identifier "299-Satoh-Endosome" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Endosome maturation promoted by interorganelle association between mitochondria and endosomes" ;
    schema1:publisher <https://ssbd.riken.jp/database> ;
    schema1:size <https://ssbd.riken.jp/v2/project/299-Satoh-Endosome#file-count>,
        <https://ssbd.riken.jp/v2/project/299-Satoh-Endosome#total-dataset-size> ;
    schema1:thumbnailUrl "https://ssbd.riken.jp/ssbd-omero/v1/projects/1355/render_thumbnail/" ;
    rdf:seeAlso <https://doi.org/10.1016/j.celrep.2023.112229> .

