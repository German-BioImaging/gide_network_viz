        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1287#76cb7428-4d33-470d-8081-e9f5ae9fc263> ;
    schema1:author <https://orcid.org/0000-0001-6389-0213>,
        <https://orcid.org/0000-0001-7446-9256>,
        <https://orcid.org/0000-0001-7482-1299>,
        <https://orcid.org/0000-0002-0926-1480>,
        <https://orcid.org/0000-0002-1016-2447>,
        <https://orcid.org/0000-0002-2542-3582>,
        <https://orcid.org/0000-0002-3033-674X>,
        <https://orcid.org/0000-0002-4445-0826>,
        <https://orcid.org/0000-0002-4881-405X>,
        <https://orcid.org/0000-0002-5551-0417>,
