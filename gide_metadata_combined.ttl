<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1044#a16eb43c-37b5-49f1-b369-63bf8e0194ed> a schema1:LabProtocol ;
    schema1:description "Beads were suspended in 25 µL Lysis Buffer and loaded into flow chambers prepared by attaching clean #1 coverslips (VWR Cat#112614-9) to microscope slides using two layers of double-sided adhesive tape (Tesa Cat# 05338). Beads were identified using brightfield and then imaged in the brightfield, blue, green and red channels. Exposure was optimized for the greatest dynamic range possible for each channel separately and then kept constant throughout the imaging session. The 2.83 megapixels monochrome CCD camera chip was used to collect 14-bit TIF images using no pixel binning (Keyence setting: \"high resolution\")." ;
    schema1:labEquipment "BZ-X810 epifluorescence microscope (Keyence) equipped with a PlanFluor 10x objective with 0.30 numerical aperture (NA) objective and three Chroma filter cubes: blue (Cat# 49028), green (Cat# 49308), and red (\"mCherry\"). " ;
    schema1:measurementTechnique obo:FBbi_00000246 ;
    schema1:name "Epifluorescence Microscopy of Agarose Beads" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1044#a514d2fc-0269-44ff-bab2-9ea85a6f6a77> a schema1:BioSample ;
    schema1:description "Flp-In-3T3 cells (Thermo Fisher Scientific)" ;
    schema1:name "3T3 cells" ;
    schema1:taxonomicRange obo:NCBITaxon_10090 .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1044#a88b4bb6-5cfd-42af-9661-b4cca49d55e3> a schema1:Person ;
    schema1:affiliation <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1044#b9969662-4afa-4161-be7c-305f10c6b054> ;
    schema1:name "Ronith Dasari" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1044#abb05057-b78c-42b4-9cfa-f810467cd46c> a schema1:BioSample ;
    schema1:description "Kif3a-/-; Kif3b-/- 3T3 cells derived via CRISPR/Cas9 (Engelke et al., 2019) from Flp-In-3T3 cells (Thermo Fisher Scientific)" ;
    schema1:name "Kif3a-/-; Kif3b-/- cells" ;
    schema1:taxonomicRange obo:NCBITaxon_10090 .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1044#abc474b6-0593-4daf-9d2f-4bd9a14fe444> a schema1:Person ;
    schema1:affiliation <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1044#b9969662-4afa-4161-be7c-305f10c6b054> ;
    schema1:email "jmadam5@ilstu.edu" ;
    schema1:name "Jessica M Adams" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1044#ac9e1aa8-b525-4000-9ab9-0daa98b46119> a schema1:LabProtocol ;
    schema1:description "Fixed and mounted specimens were imaged on the BZ-X810 microscope. Transfected cells were located in the green channel and expression in the red channel was confirmed when applicable. Exposure was optimized for the greatest dynamic range possible for each channel separately and then kept constant throughout the imaging session. For Figures 1 and 2, the presence of cilia was evaluated in the red (acetylated tubulin staining) and/or infrared channel (ARL13B staining). If cilia were present, cilia were used for focusing, else focusing was done in the channel in which transfected cells had been selected. For Figure 4, the Golgi apparatus was visualized in the infrared channel (GOLGB1 staining). All cells were imaged in the blue channel (DAPI staining) to visualize nuclei. The 2.83 megapixels monochrome CCD camera chip was used to collect 14-bit TIF images using no pixel binning (Keyence setting: \"high resolution\")." ;
    schema1:labEquipment "BZ-X810 epifluorescence microscope (Keyence) equipped with a Plan Apochromate 40x, 0.95 numerical aperture (NA) objective, and four Chroma filter cubes: blue (Cat# 49028), green (Cat# 49308), red (\"mCherry\"), and infrared (Cat# 49009)." ;
    schema1:measurementTechnique obo:FBbi_00000246 ;
    schema1:name "Epifluorescence Microscopy of fixed cells" .

