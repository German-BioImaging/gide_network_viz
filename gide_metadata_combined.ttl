<https://idr.openmicroscopy.org/study/idr0133/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://idr.openmicroscopy.org/study/idr0133/#screen-protocol-1-0>,
        <https://idr.openmicroscopy.org/study/idr0133/#screen-protocol-1-1>,
        <https://idr.openmicroscopy.org/study/idr0133/#screen-protocol-1-2>,
        <https://idr.openmicroscopy.org/study/idr0133/#screen-protocol-1-3>,
        <https://idr.openmicroscopy.org/study/idr0133/#screen-protocol-1-4>,
        <https://idr.openmicroscopy.org/study/idr0133/#screen-protocol-1-5> ;
    schema1:about obo:NCBITaxon_9606,
        <https://idr.openmicroscopy.org/study/idr0133/#screen-biosample-1> ;
    schema1:author <https://orcid.org/0000-0003-4151-9944> ;
    schema1:copyrightNotice "Dahlin & Hua et al, CC-BY-4.0, 2022" ;
    schema1:datePublished "2022-07-05" ;
    schema1:description "Robust, generalizable approaches to efficiently identify compounds with undesirable mechanisms of action in complex cellular assays remain elusive. Such a process would be useful for hit triage during high-throughput screening and, ultimately, predictive toxicology during drug development. Here, we report on the generation of Cell Painting and cellular health profiles for 218 prototypical cytotoxic and nuisance compounds in U-2 OS cells in a concentration-response format. Compounds causing cellular damage such as cytoskeletal poisons, genotoxins, nonspecific electrophiles, and redox-active compounds produced bioactive Cell Painting morphologies. Further, we show that lower-quality lysine acetyltransferase inhibitors and nonspecific electrophiles can be distinguished from more selective counter-parts. We propose that the purposeful inclusion of cytotoxic and nuisance reference compounds such as those profiled in this Resource will help with assay optimization and compound prioritization in complex cellular assays like Cell Painting." ;
    schema1:identifier "idr0133" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Reference compounds for characterizing cellular injury in high-content cellular morphology assays" ;
    schema1:publisher <https://idr.openmicroscopy.org/> ;
    schema1:thumbnailUrl "https://idr.openmicroscopy.org/webgateway/render_thumbnail/14002649/" ;
    rdfs:seeAlso <https://doi.org/10.1038/s41467-023-36829-x> .

<https://idr.openmicroscopy.org/study/idr0133/#screen-biosample-1> a schema1:BioSample ;
    schema1:description "We screened 218 prototypical cytotoxic and nuisance compounds in U-2 OS cells in concentration-response format using the Cell Painting assay. From a previous Cell Painting experiment, an additional 283 compounds with either high or no correlation to a gross cell injury morphology were re-tested in single-concentration format." ;
    schema1:name "cell" ;
    schema1:taxonomicRange obo:NCBITaxon_9606 .

<https://idr.openmicroscopy.org/study/idr0133/#screen-protocol-1-0> a schema1:LabProtocol ;
    schema1:description "We screened 218 prototypical cytotoxic and nuisance compounds in U-2 OS cells in concentration-response format using the Cell Painting assay. From a previous Cell Painting experiment, an additional 283 compounds with either high or no correlation to a gross cell injury morphology were re-tested in single-concentration format." ;
    schema1:measurementTechnique obo:FBbi_00000246 ;
    schema1:name "fluorescence microscopy" .

