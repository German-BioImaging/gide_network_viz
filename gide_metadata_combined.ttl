<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2260> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000251,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2260#22e83b63-7f9d-4f73-bb4d-3e0ebcbb776b> ;
    schema1:about obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2260#43b04121-75ff-4b52-beec-c913f8bdc3ce> ;
    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2260#761b83dd-8770-47ed-8f55-ef32c19e0706>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2260#9edd3d60-bf1e-404d-af65-5bca644d25f3>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2260#a91e95f1-1ca3-47d9-9c98-97688a556400>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2260#ab87840e-5f60-4045-a546-5fa772e35f23> ;
    schema1:datePublished "2025-12-01" ;
    schema1:description "Biomolecular condensates mediate dynamic compartmentalization of cellular processes. The multivalent interactions that underlie biomolecular condensation are often promoted by intrinsically disordered regions (IDRs) within proteins. While the role of IDRs in biomolecular condensates is well appreciated, predicting whether an IDR forms condensates in cells remains challenging. Here, we developed a machine learning model to accurately predict the condensation behavior of IDRs, analyzing 215 IDRs from fusion oncoproteins in HEK293T cells. We identified distinct sequence-derived physicochemical features associated with condensation. Leveraging these data, our model predicts that ~12% of the ~13,000 IDRs in the human proteome are likely to form cellular condensates, establishing a robust framework for proteome-wide analysis of IDR-mediated biomolecular condensation. Notably, proteins with condensate-forming IDRs are significantly enriched in RNA processing and splicing functions and are predominantly localized to membrane-less organelles (MLOs), highlighting a central role of IDR-mediated biomolecular condensation in cellular organization and RNA biology. " ;
    schema1:identifier "S-BIAD2260" ;
    schema1:keywords "biomolecular condensates",
        "disordered protein",
        "light microscopy" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "Proteome-wide computational analyses reveal links between protein condensate formation and RNA biology" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2260#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2260#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
    schema1:thumbnailUrl "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD2260/5f8cd8bf-5b72-4ba2-bde6-766927128189/static_display_512_512.png" .

