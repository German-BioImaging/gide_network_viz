        "Mitochondrial Proteins/genetics",
        "Mitochondrial Proteins/metabolism",
        "Oxidation-Reduction[major]",
        "Phosphorylation",
        "Signal Transduction" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Immunostaining of phosphorylated ATM in normal human fibroblasts" ;
    schema1:publisher <https://ssbd.riken.jp/repository> ;
    schema1:size <https://ssbd.riken.jp/repository/ssbd-repos-000440/#file-count>,
