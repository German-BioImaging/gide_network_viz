<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2006#c36e4977-706e-4eed-a8c6-f2a58726ba15> a schema1:LabProtocol ;
    schema1:description "100X objective and with 15 z-sections of 0.3 μm intervals. Appropriate lasers were used (405 nm and 488 nm) with a typical laser intensity set to 5-10% transmission of the maximum intensity for methylated histones, Ki67 and ROS, and 30-40% for phosphorylated histones. Exposure time and binning were established separately to assure avoidance of signal saturation." ;
    schema1:labEquipment "Confocal image acquisition was performed using the Ti2 Yokogawa CSU-W1 Spinning Disk (Nikon)." ;
    schema1:measurementTechnique obo:FBbi_00000253 ;
    schema1:name "Image aquisition" .

