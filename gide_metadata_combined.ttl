<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD746#947d8f9a-520c-4c0b-9d4f-a27581766c96> a schema1:LabProtocol ;
    schema1:description "Cells expressing EglN1-GFP were cultured on coverslips in 24-well plates, and were exposed to normoxia or hypoxia for 24 h at 37°C incubator. Cells were washed once with PBS after MitoTracker staining for 30 minutes at 37°C incubator and were fixed with 4% paraformaldehyde for 20 minutes at room temperature. The nucleus was stained with 4,6-diamidino-2-phenylindole (DAPI). DAPI(blue):405nm laser, GFP(green):488nm laser, Red:594nm laser." ;
    schema1:labEquipment "Zeiss LSM880 with Airyscan confocal microscopy" ;
    schema1:measurementTechnique obo:FBbi_00000251 ;
    schema1:name "Confocal Microscopy " .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD748> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD748#cdacd779-7fe9-447f-a2e0-53918847ec68> ;
    schema1:about obo:NCBITaxon_10090,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD748#f211027d-00aa-4220-bf30-a564b0080051> ;
    schema1:author <https://orcid.org/0000-0002-9548-7709>,
        <https://orcid.org/0000-0003-4612-6752>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD748#f8254b30-b962-4f48-9658-29decfeb81e5> ;
    schema1:datePublished "2024-02-16" ;
    schema1:description "Primary cilia are essential signaling organelles that protrude from most cells in the body. Heterodimeric kinesin-2 (KIF3A/KIF3B/KAP3) powers several intracellular transport processes, including intraflagellar transport (IFT), essential for ciliogenesis. A long-standing question is how a motor protein is differentially regulated for specific cargos. Since phosphorylation of the KIF3A tail domain was suggested to regulate the activity of kinesin-2 for ciliogenesis, similarly as for the cytosolic cargo N-Cadherin, we set out to map the phosphosites involved in this regulation. Using well-characterized Kif3a-/-; Kif3b-/- mouse embryonic fibroblasts, we perform ciliogenesis rescue assays with a library of phosphomimetic mutants comprising all predicted phosphosites in the KIF3A tail domain. In contrast to previous reports, we find that KIF3A tail domain phosphorylation is dispensable for ciliogenesis in mammals. Thus, mammalian kinesin-2 is differently regulated for IFT than currently thought, consistent with the idea of differential regulation for ciliary and cytosolic cargo." ;
    schema1:identifier "S-BIAD748" ;
    schema1:keywords "cell biology, intraflagellar transport, motor protein regulation, KIF3A/KIF3B/KAP3, phosphorylation, primary cilia" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name """KIF3A tail domain phosphorylation is not required for ciliogenesis in mouse embryonic fibroblasts
""" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD748#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
