<https://ssbd.riken.jp/v2/project/334-Hashimoto-SARSorganoid> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://ssbd.riken.jp/v2/project/334-Hashimoto-SARSorganoid#imaging-protocol-1> ;
    schema1:about obo:GO_0005737,
        obo:GO_0010506,
        obo:GO_0016032,
        <https://ssbd.riken.jp/v2/project/334-Hashimoto-SARSorganoid#biosample-1>,
        <https://www.ncbi.nlm.nih.gov/datasets/taxonomy/9606> ;
    schema1:author <https://ssbd.riken.jp/v2/project/334-Hashimoto-SARSorganoid#auth-001>,
        <https://ssbd.riken.jp/v2/project/334-Hashimoto-SARSorganoid#auth-002> ;
    schema1:datePublished "2024-11-25" ;
    schema1:description "To deal with the broad spectrum of coronaviruses, including severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2), that threaten human health, it is essential to not only drugs develop that target viral proteins but also consider drugs that target host proteins/cellular processes to protect them from being hijacked for viral infection and replication. To this end, it has been reported that autophagy is deeply involved in coronavirus infection. In this study, they used airway organoids to screen a chemical library of autophagic modulators to identify compounds that could potentially be used to fight against infections by a broad range of coronaviruses. Among the 80 autophagy-related compounds tested, cycloheximide and thapsigargin reduced SARS-CoV-2 infection efficiency in a dose-dependent manner." ;
    schema1:identifier "334-Hashimoto-SARSorganoid" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Inhibition of SARS-CoV-2 virus infection to human airway organoids by autophagy-related compounds." ;
    schema1:publisher <https://ssbd.riken.jp/database> ;
    schema1:size <https://ssbd.riken.jp/v2/project/334-Hashimoto-SARSorganoid#file-count>,
        <https://ssbd.riken.jp/v2/project/334-Hashimoto-SARSorganoid#total-dataset-size> ;
    schema1:thumbnailUrl "https://ssbd.riken.jp/ssbd-omero/v1/projects/1253/render_thumbnail/" ;
    rdf:seeAlso <https://doi.org/10.1021/acs.molpharmaceut.3c00114> .

