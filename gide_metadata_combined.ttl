<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1445> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000251,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1445#c85976f0-8605-49cf-820d-c15d648010c8>,
