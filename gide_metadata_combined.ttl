        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1396#1eadaed8-3efc-434c-b6b8-99c47832e5fa> ;
    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1396#30d00904-66d3-4d52-9cad-0e89849bf02e>,
