<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2428#8a65ea98-57dc-46e1-9c17-9e57cd3720f4> a schema1:LabProtocol ;
    schema1:description "Bright-field images of colorimetric WMISH samples were acquired with a Leica CTR 5000 microscope. Fluorescent confocal images of samples/ sections were acquired with either a Zeiss LSM780 or LSM980 confocal microscopes. Image processing (contrast and brightness, z-projection, auto-blend layers, transversal and sagittal views) was performedack using FIJI and Abode Photoshop. Figures were assembled with Adobe Illustrator. EdU and TUNEL cell counts were performed using IMARIS 9.5.0 (Oxford Instruments)" ;
    schema1:labEquipment "Leica CTR 5000 microscope (bright-field); Zeiss LSM780 or LSM980 (confocal)" ;
    schema1:measurementTechnique obo:FBbi_00000243,
        obo:FBbi_00000251 ;
    schema1:name "Confocal scanning and bright-field microscopy" .

