<https://idr.openmicroscopy.org/study/idr0101/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000251,
        <https://idr.openmicroscopy.org/study/idr0101/#experiment-protocol-1-0>,
        <https://idr.openmicroscopy.org/study/idr0101/#experiment-protocol-2-0> ;
    schema1:about <https://idr.openmicroscopy.org/study/idr0101/#experiment-biosample-1>,
        <https://idr.openmicroscopy.org/study/idr0101/#experiment-biosample-2> ;
    schema1:author <https://orcid.org/0000-0001-9958-3987>,
        <https://orcid.org/0000-0002-0419-3351>,
        <https://orcid.org/0000-0003-2308-3649> ;
    schema1:copyrightNotice "Payne et al, CC-BY-4.0, 2021" ;
    schema1:datePublished "2021-09-21" ;
    schema1:description "Understanding genome organization requires integration of DNA sequence and 3D spatial context, however, existing genome-wide methods lack either base-pair sequence resolution or direct spatial localization. Here, we describe in situ genome sequencing (IGS), a method for simultaneously sequencing and imaging genomes within intact biological samples. We applied IGS to human fibroblasts and early mouse embryos, spatially localizing thousands of genomic loci in individual nuclei. Using these data, we characterized parent-specific changes in genome structure across embryonic stages, revealed single-cell chromatin domains in zygotes, and uncovered epigenetic memory of global chromosome positioning within individual embryos. These results demonstrate how in situ genome sequencing can directly connect sequence and structure across length scales from single base pairs to whole organisms." ;
    schema1:identifier "idr0101" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "In situ genome sequencing resolves DNA sequence and structure in intact biological samples" ;
    schema1:publisher <https://idr.openmicroscopy.org/> ;
    schema1:size <https://idr.openmicroscopy.org/study/idr0101/#file-count>,
        <https://idr.openmicroscopy.org/study/idr0101/#total-dataset-size> ;
    schema1:thumbnailUrl "https://idr.openmicroscopy.org/webgateway/render_thumbnail/13457423/" ;
    rdfs:seeAlso <https://doi.org/10.1126/science.aay3446> .

