<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2274> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2274#413756e4-f5b9-4d79-9b35-dd486e5b457c> ;
    schema1:about obo:NCBITaxon_3702,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2274#ce09bfd3-fef7-496c-af53-f4014be75e87> ;
    schema1:author <https://orcid.org/0000-0003-1109-4279> ;
    schema1:datePublished "2025-10-01" ;
    schema1:description """In plants with indeterminate inflorescences, the number of flowers produced is determined by 
the activity of the inflorescence meristem. We combined quantitative imaging of the inflorescence meristem using light sheet microscopy with the manipulation of cytokinin levels and distribution to investigate how meristem activity is regulated. We further show that the duration of flowering and cytokinin signaling in the inflorescence meristem is influenced by nitrate availability. Taken together, these data suggest that cytokinin functions as a systemic signal that integrates information about ongoing reproductive effort and plant nutrient 
status to control flower production.""" ;
    schema1:identifier "S-BIAD2274" ;
    schema1:keywords "Arabidopsis",
        "CLV3",
        "DR5",
        "Development",
        "Light sheet microscopy",
        "TCSn",
        "WUS",
        "nitrate",
        "proliferative arrest",
        "pruning",
        "shoot apical meristem" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "Cytokinin acts as a systemic signal coordinating reproductive effort in Arabidopsis " ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2274#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2274#480bb0bc-db43-46e5-88ae-071380b9d63c> .

