    schema1:datePublished "2024-06-28" ;
    schema1:description "This is the dataset that was used for the manuscript \"Decreased GABA levels during development results in increased connectivity in the larval zebrafish tectum.\" The paper authors are Yang Liu, Yongkai Chen, Carly R. Duffy, Ariel J VanLeuven, John Branson Byers, Hannah C. Schriever, Rebecca E. Ball, Jessica M. Carpenter, Chelsea E. Gunderson, Nikolay M. Filipov, Ping Ma, Peter A. Kner, and James D. Lauderdale." ;
    schema1:identifier "S-BIAD1200" ;
    schema1:keywords "GABAergic signaling",
        "Zebrafish",
        "light-sheet microscopy" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "Zebrafish CNS Imaging: Reduced GABA levels result in increased neural connectivity" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1200#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
