<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD859> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD859#cb1665d0-43ec-49f0-a7b0-a9057829200c> ;
    schema1:about obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD859#0b7bafec-a805-404c-83df-311dbd7e6509> ;
    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD859#19d70c80-f0f7-4b4c-b055-24ee99a8d204>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD859#be91e90a-d671-4c12-95b2-c3be9352cb74> ;
    schema1:datePublished "2023-12-01" ;
    schema1:description "In autoimmune Type 1 diabetes (T1D), immune cells progressively infiltrate and destroy the islets of Langerhans – islands of endocrine tissue dispersed throughout the pancreas. However, it is unclear how this process, called ‘insulitis’, develops and progresses within this organ. Here, using highly multiplexed CO-Detection by indEXing (CODEX) tissue imaging and cadaveric pancreas samples from autoantibody positive, T1D, and non-diabetic donors, we examine pseudotemporal-spatial patterns of insulitis and exocrine inflammation within large pancreatic tissue sections. " ;
    schema1:identifier "S-BIAD859" ;
    schema1:keywords "CODEX",
        "Type 1 Diabetes" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "High-Parameter Spatial Profiling of the Pancreas in Human Type 1 Diabetes" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD859#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD859#480bb0bc-db43-46e5-88ae-071380b9d63c> .

