<https://idr.openmicroscopy.org/study/idr0170/> a schema1:Dataset ;
    dwciri:measurementMethod <https://idr.openmicroscopy.org/study/idr0170/#experiment-protocol-1-0>,
        <https://idr.openmicroscopy.org/study/idr0170/#experiment-protocol-1-1>,
