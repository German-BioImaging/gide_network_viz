<https://ssbd.riken.jp/repository/ssbd-repos-000442/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000265,
        <https://ssbd.riken.jp/repository/ssbd-repos-000442/#imaging-protocol-1> ;
    schema1:about obo:NCBITaxon_10090 ;
    schema1:author <https://ssbd.riken.jp/repository/ssbd-repos-000442/#auth-001>,
        <https://ssbd.riken.jp/repository/ssbd-repos-000442/#auth-002> ;
    schema1:datePublished "2025-06-10" ;
    schema1:description "Regulated neural-metabolic-inflammatory responses are essential for maintaining physiological homeostasis. However, the molecular machinery that coordinates neural, metabolic, and inflammatory responses is largely unknown. Here, we show that semaphorin 6D (SEMA6D) coordinates anxiogenic, metabolic, and inflammatory outputs from the amygdala by maintaining synaptic homeostasis. Using genome-wide approaches, we identify SEMA6D as a pleiotropic gene for both psychiatric and metabolic traits in human. Sema6d deficiency increases anxiety in mice. When fed a high-fat diet, Sema6d(-/-) mice display attenuated obesity and enhanced myelopoiesis compared with control mice due to higher sympathetic activity via the beta3-adrenergic receptor. Genetic manipulation and spatial and single-nucleus transcriptomics reveal that SEMA6D in amygdalar interneurons is responsible for regulating anxiogenic and autonomic responses. Mechanistically, SEMA6D is required for synaptic maturation and gamma-aminobutyric acid transmission. These results demonstrate that SEMA6D is important for the normal functioning of the neural circuits in the amygdala, coupling emotional, metabolic, and inflammatory responses." ;
    schema1:identifier "ssbd-repos-000442" ;
    schema1:keywords "Amygdala/metabolism[major]",
        "Animals",
        "Anxiety/metabolism",
        "Diet, High-Fat",
        "Emotions/physiology",
        "Humans",
        "Inflammation/metabolism",
        "Interneurons/metabolism",
        "Male",
        "Mice",
        "Mice, Inbred C57BL",
        "Mice, Knockout",
        "Obesity/metabolism",
        "Semaphorins/genetics[major]",
        "Semaphorins/metabolism[major]" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Semaphorin 6D tunes amygdalar circuits for emotional, metabolic, and inflammatory outputs" ;
    schema1:publisher <https://ssbd.riken.jp/repository> ;
    schema1:size <https://ssbd.riken.jp/repository/ssbd-repos-000442/#file-count>,
        <https://ssbd.riken.jp/repository/ssbd-repos-000442/#total-dataset-size> ;
    rdf:seeAlso <https://doi.org/10.1016/j.neuron.2024.06.017> .

