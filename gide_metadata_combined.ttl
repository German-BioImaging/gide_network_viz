        "single-particle tracking" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Single-particle tracking (SPT) data of HER2 labeled with a non-activating nanobody in HeLa cells activated with the ligands EGF, TGFα, EREG, NRGβ1" ;
