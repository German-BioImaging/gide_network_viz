<https://ssbd.riken.jp/repository/ssbd-repos-000458/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000265,
        <https://ssbd.riken.jp/repository/ssbd-repos-000458/#imaging-protocol-1> ;
    schema1:about obo:NCBITaxon_9606 ;
    schema1:author <https://ssbd.riken.jp/repository/ssbd-repos-000458/#auth-001>,
        <https://ssbd.riken.jp/repository/ssbd-repos-000458/#auth-002> ;
    schema1:datePublished "2025-09-08" ;
    schema1:description "The interaction of tumor cells and their microenvironment is thought to be a key factor in tumor development. We present spatial RNA profiles obtained from 30 lung adenocarcinoma patients at the non-invasive and later invasive stages. We use spatial transcriptome sequencing data in conjunction with in situ RNA profiling to conduct higher resolution analyses. The detailed examination of each case, as well as the subsequent computational analyses based on the observed diverse profiles, reveals that significant changes in the phenotypic appearances of tumor cells are frequently associated with changes in immune cell features. The phenomenon coincides with the induction of a series of cellular expression programs that enable tumor cells to transform and break through the immune cell barrier, allowing them to progress further. The study shows how lung tumors develop through interaction in their microenvironments." ;
    schema1:identifier "ssbd-repos-000458" ;
