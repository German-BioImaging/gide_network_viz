<https://idr.openmicroscopy.org/study/idr0145/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000253,
        <https://idr.openmicroscopy.org/study/idr0145/#screen-protocol-1-0>,
        <https://idr.openmicroscopy.org/study/idr0145/#screen-protocol-1-1>,
