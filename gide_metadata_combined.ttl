<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1540#c2a7c896-38d9-4c44-9bf7-9bd99a83aed6> a schema1:LabProtocol ;
    schema1:description "FSS immunostained slides were imaged on a confocal microscope (Carl Zeiss, LSM 980) using a Plan-Apochromat 20x/0.8 NA Ph2 air objective and 63x/1.4 NA oil objective. For each samplerandom positions throughout the flow slide were selected and Z-stacks covering the entire depth of the monolayer were acquired. Slides were imaged with a two-channel setup, with channel one using the 488 and 633 lasers and channel two using the 405 and 561 lasers. Pinhole size was set to 1AU for both channels. ZEN version 3.4.91.00000 was used for image acquisition, Fiji was used for max projection and export to tiff file format." ;
    schema1:labEquipment "Carl Zeiss, LSM 980" ;
    schema1:measurementTechnique obo:FBbi_00000251 ;
    schema1:name "LSM 980" .

