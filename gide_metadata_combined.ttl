<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1257#4a8b5807-b8ee-4f74-8c4e-5a2aefd953f0> a schema1:LabProtocol ;
    schema1:description "20X (NA 0.16, 0.299 μm/pixel) water-immersion objective with 9-11 z-stacks with 2 µm-step. Channels: DAPI (excitation 355-385 nm, emission 430-500 nm), Atto 425 (ex. 435-460 nm, em. 470-515 nm), Opal 520 (ex. 460-490 nm, em. 500-550 nm), Opal 570 (ex. 530-560 nm, em. 570-620 nm), Opal 650 (ex. 615-645 nm, em. 655-760 nm). Confocal image stacks were stitched as individual z-stacks using proprietary Acapella scripts provided by Perkin Elmer, and visualised using OMERO Plus (Glencoe Software)." ;
    schema1:labEquipment "Perkin Elmer Operetta CLS High Content Analysis System" ;
    schema1:measurementTechnique obo:FBbi_00000253 ;
    schema1:name "Imaging RNAscope" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1257#5dc08af0-2412-424e-a8ea-d066934822b3> a schema1:BioSample ;
