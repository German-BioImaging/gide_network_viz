<https://idr.openmicroscopy.org/study/idr0015/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000251,
        <https://idr.openmicroscopy.org/study/idr0015/#screen-protocol-1-0> ;
    schema1:about obo:NCBITaxon_1427524,
        <https://idr.openmicroscopy.org/study/idr0015/#screen-biosample-1> ;
    schema1:author <https://idr.openmicroscopy.org/study/idr0015/#person-1> ;
    schema1:copyrightNotice "Colin et al, CC-BY-4.0, 2016" ;
    schema1:datePublished "2016-04-27" ;
    schema1:description "We present a 3D-fluorescence imaging and classification tool for high throughput analysis of microbial eukaryotes in environmental samples. It entails high-content feature extraction that permits accurate automated taxonomic classification and quantitative data about organism ultrastructures and interactions. Using plankton samples from the Tara Oceans expeditions, we validate its applicability to taxonomic profiling and ecosystem analyses, and discuss its potential for future integration of eukaryotic cell biology into evolutionary and ecological studies. This study is subject to the data release policy described here: http://www.embl.de/tara-oceans/start/Tara-Oceans-Data-Release-Policy.pdf" ;
    schema1:identifier "idr0015" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Quantitative 3D-imaging for cell biology and ecology of environmental microbial eukaryotes" ;
    schema1:publisher <https://idr.openmicroscopy.org/> ;
    schema1:size <https://idr.openmicroscopy.org/study/idr0015/#file-count>,
        <https://idr.openmicroscopy.org/study/idr0015/#total-dataset-size> ;
    schema1:thumbnailUrl "https://idr.openmicroscopy.org/webgateway/render_thumbnail/1845698/" ;
    rdfs:seeAlso <https://doi.org/10.7554/eLife.26066> .

