<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1444> a schema1:Dataset ;
    dwciri:measurementMethod <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1444#6213e5f2-3e12-43ad-85ce-508f091b9901> ;
    schema1:about obo:NCBITaxon_3702,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1444#0d7d09cf-2bc9-48c1-bb55-bc98805f91cd> ;
    schema1:author <https://orcid.org/0000-0002-1451-5967>,
        <https://orcid.org/0000-0002-9458-1779> ;
    schema1:datePublished "2024-10-31" ;
    schema1:description "TRAPP (transport protein particle) tethering complexes are known for their function as Rab-GTPase exchange factors (GEFs). In yeast and animal cells, TRAPPIII is an activator the Rab1 family (RabD in plants) which regulates ER-to-Golgi trafficking and autophagy. In Arabidopsis thaliana, the TRAPPIII complex has been identified and its subunit composition established, but little is known about its functions. We study here the TRAPPC8 subunit of the Arabidopsis thaliana TRAPPIII complex. The purpose of this experiment was to establish whether a loss-of-function mutation of TRAPPC8 causes changes in ER or Golgi morphology in Arabidopsis thaliana. Methodology described in detail in accompanying preprint (BioRxiv): doi: https://doi.org/10.1101/2024.01.11.575191." ;
    schema1:identifier "S-BIAD1444" ;
    schema1:keywords "TRAPPIII, TRAPPC8, plant, endoplasmic reticulum" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "Transmission electron microscopy (TEM) images of root cells of trappc8-1 and wild-type Arabidopsis thaliana seedlings" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1444#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
