<https://ssbd.riken.jp/v3/project/380-Wang-ActininTensionSensor> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000249,
        obo:FBbi_00000251,
        obo:FBbi_00000367,
        <https://ssbd.riken.jp/v3/project/380-Wang-ActininTensionSensor#imaging-protocol-1>,
        <https://ssbd.riken.jp/v3/project/380-Wang-ActininTensionSensor#imaging-protocol-2>,
        <https://ssbd.riken.jp/v3/project/380-Wang-ActininTensionSensor#imaging-protocol-3> ;
    schema1:about <https://ssbd.riken.jp/v3/project/380-Wang-ActininTensionSensor#biosample-1>,
        <https://www.ncbi.nlm.nih.gov/datasets/taxonomy/10090> ;
    schema1:author <https://ssbd.riken.jp/v3/project/380-Wang-ActininTensionSensor#auth-001>,
        <https://ssbd.riken.jp/v3/project/380-Wang-ActininTensionSensor#auth-002>,
        <https://ssbd.riken.jp/v3/project/380-Wang-ActininTensionSensor#auth-003>,
        <https://ssbd.riken.jp/v3/project/380-Wang-ActininTensionSensor#auth-004>,
        <https://ssbd.riken.jp/v3/project/380-Wang-ActininTensionSensor#auth-005>,
        <https://ssbd.riken.jp/v3/project/380-Wang-ActininTensionSensor#auth-006> ;
    schema1:datePublished "2024-12-14" ;
    schema1:description "FRET-based sensors are utilized for real-time measurements of cellular tension. However, transfection of the sensor gene shows low efficacy and is only effective for a short period. Reporter mice expressing such sensors have been developed, but sensor fluorescence has not been measured successfully using conventional confocal microscopy. Therefore, methods for spatiotemporal measurement of cellular tension in vivo or ex vivo are still limited. The authors established a reporter mouse line expressing FRET-based actinin tension sensors consisting of EGFP as the donor and mCherry as the acceptor and whose FRET ratio change is observable with confocal microscopy. Tension-induced changes in FRET signals were monitored in the aorta and tail tendon fascicles, as well as aortic smooth muscle cells isolated from these mice. The pattern of FRET changes was distinctive, depending on tissue type. Indeed, aortic smooth muscle cells exhibit different sensitivity to macroscopic tensile strain in situ and in an isolated state. This mouse strain will enable novel types of biomechanical investigations of cell functions in important physiological events." ;
    schema1:funder <https://ssbd.riken.jp/v3/project/380-Wang-ActininTensionSensor#grant-001> ;
    schema1:identifier "380-Wang-ActininTensionSensor" ;
    schema1:keywords "Cytoskeleton",
        """Fluorescence Resonance Energy Transfer, 
Microscopy, Confocal,
Time-Lapse Imaging""",
        "Muscle, Smooth, Vascular",
        "Osmotic Pressure" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Changes of tension in smooth muscle cell after treatment with water, calyculin A, or Y27632" ;
    schema1:publisher <https://ssbd.riken.jp/database> ;
    schema1:size <https://ssbd.riken.jp/v3/project/380-Wang-ActininTensionSensor#file-count>,
        <https://ssbd.riken.jp/v3/project/380-Wang-ActininTensionSensor#total-dataset-size> ;
    schema1:thumbnailUrl "https://ssbd.riken.jp/ssbd-omero/v1/projects/1361/render_thumbnail/" ;
    rdf:seeAlso <https://doi.org/10.1038/s41598-023-50142-z> .

