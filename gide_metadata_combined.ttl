<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD888> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000251,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD888#2f3b4721-5907-417a-b3c3-ec4282b3227e> ;
    schema1:about obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD888#628722fc-e00f-490a-80e6-5414216ef0e9> ;
    schema1:author <https://orcid.org/0000-0001-8260-1421>,
        <https://orcid.org/0000-0002-1685-9499>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD888#0252d31f-e739-4b5d-994c-19655acacece>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD888#0af31774-27e3-4165-a435-d4d0ccbe5ddb>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD888#0d5981a3-037e-4239-953f-7c72eb3c98bf>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD888#16319138-d7bf-46bb-a4d9-57150e956e46>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD888#3bc9b9c4-7f98-4ed5-9c07-648c7f83b796>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD888#7a276aa5-14ce-4b71-b2ed-92446aa4f6f6>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD888#ddd09f56-197e-4b73-9adb-fdcddad3ec77> ;
    schema1:datePublished "2023-09-15" ;
    schema1:description "ER-phagy is a selective autophagy process which targets specific regions of the endoplasmic reticulum (ER) for removal via lysosomal degradation. During cellular stress induced by starvation, cargo receptors concentrate at distinct ER-phagy sites (ERPHS) to recruit core autophagy proteins and initiate ER-phagy. However, the molecular mechanism responsible for ERPHS formation remains unclear. In our study, we discovered that the UV radiation Resistance-Associated Gene (UVRAG) plays a crucial role in orchestrating the assembly of ERPHS. Upon starvation, UVRAG localizes to ERPHS and interacts with specific ER-phagy cargo receptors such as FAM134B, ATL3, and RTN3L. UVRAG regulates the oligomerization of cargo receptors and facilitates the recruitment of Atg8 family proteins. Consequently, UVRAG promotes the efficient ERPHS assembly and turnover of both ER sheets and tubules. Importantly, UVRAG-mediated ER-phagy contributes to the clearance of pathogenic proinsulin aggregates. Remarkably, the involvement of UVRAG in ER-phagy initiation is independent of its canonical function as a subunit of class III phosphatidylinositol 3-kinase complex II." ;
    schema1:identifier "S-BIAD888" ;
    schema1:keywords "Atg8 family protein; Beclin-1; cargo receptor; ER-phagy; UVRAG" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "UVRAG cooperates with cargo receptors to assemble the ER-phagy site" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD888#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD888#480bb0bc-db43-46e5-88ae-071380b9d63c> .

