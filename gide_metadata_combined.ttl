<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1023#1be4cfcd-9523-4ace-87cc-cd9f273b4e83> a schema1:LabProtocol ;
    schema1:description "The sample was imaged in PBS on a Zeiss LSM 980 inverse point scanning confocal microscope with a Plan-Apochromat 63x/1.4 Oil DIC, WD 0.19 mm objective. The microscope is operated by the Zeiss ZEN 3.3 microscope software. mNG and Atto549 were excited by the 488 nm and 561 nm laser diodes of the microscope, respectively. Image processing was performed in ImageJ" ;
    schema1:labEquipment "Zeiss LSM 980 inverse point scanning confocal microscope " ;
    schema1:measurementTechnique obo:FBbi_00000251 ;
    schema1:name "Confocal Imaging of Mouse Embryonic Fibroblasts expressing human IRE1a and its mutants tagged with mNeonGreen" .

