    schema1:about obo:NCBITaxon_10116,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1445#0586bd02-d3e5-4582-b42c-9e12106f265b>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1445#15d3a6e3-0352-40c6-a3cc-3e971a4a0be8>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1445#41d9c0ee-b4ed-493f-b5cb-1f36413a8d71>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1445#457c745c-c29e-49ca-b9af-f11d043ca0e6>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1445#5bc2929e-1180-4fe6-9c6f-f32cd47f26ee>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1445#6ab58d71-a127-4db2-bb52-2c393eb12c44> ;
    schema1:author <https://orcid.org/0000-0001-6113-6946>,
        <https://orcid.org/0000-0002-4099-0278>,
        <https://orcid.org/0000-0002-5599-807X>,
        <https://orcid.org/0000-0003-0597-4923>,
