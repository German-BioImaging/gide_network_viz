<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2279> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000345,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2279#768f2bbc-551e-4edf-be42-935fa490b812> ;
    schema1:about obo:NCBITaxon_10090,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2279#56cc2bc1-33bb-4e19-8342-4c704a7b2eda> ;
    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2279#ca9f84e0-0db6-499d-bacc-757507021163> ;
    schema1:datePublished "2025-09-11" ;
    schema1:description """• Acute otitis media (AOM) is a common
disease with causative organisms including
H. influenzae and S. pneumoniae. A possible
consequence of AOM is chronic otitis media
(COM), which can be caused by organisms
including S. aureus and P. aeruginosa.
• Current diagnostics cannot differentiate
between bacterial and non-bacterial cases
• ICG-maltotriose is a fluorescent probe that
binds specifically to the maltodextrin
transporter found in bacterial cells
• This study explores the use of ICG-
maltotriose, which binds to bacterial cells,
combined with SWIR imaging to distinguish
between bacterial and nonbacterial AOM in
murine models.""" ;
    schema1:identifier "S-BIAD2279" ;
    schema1:keywords "Acute otitis media, H. influenzae, S. pneumoniae, SWIR, ICG-Maltotriose" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name """Detection of Bacterial vs Inflammatory Acute Otitis Media using
ICG-Maltotriose in Short-wave Infrared (SWIR)""" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2279#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
