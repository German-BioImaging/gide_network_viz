<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1943> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1943#14d5b48a-bd12-4af0-8be5-7c8aadc747c6>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1943#3a8344f1-ce7e-422e-b57e-c0dd3e67ebae> ;
    schema1:about obo:NCBITaxon_10090,
        obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1943#149c8d81-403c-42a2-8e8c-b70e0c271068>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1943#7b961b88-7742-4a54-916d-2a6330277cfd> ;
    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1943#c1d9f50f-8682-4a1a-a302-ec2449c17196> ;
    schema1:datePublished "2025-05-28" ;
    schema1:description "Lung cancer is preceded by premalignant lesions, and what factors drive this transformation and the potential regulatory mode in the context of tumor initiation remain to be elucidated. In the course of precancerous lesions in mice, we found a phasic shift in metabolic patterns. Macrophages are a heterogeneous cell population with high plasticity in the tumor microenvironment. Single-cell interaction and metabolic analyses highlighted a cellular state, S100a4+ alveolar macrophages, which exhibited distinct fatty acid metabolic activity, such as palmitic acid metabolism, at the atypical adenomatous hyperplasia stage, accompanied by an angiogenic-promoting function in a pre-neoplastic setting of mice. These findings were reproducible in human single-cell transcriptomes and had been confirmed by histopathological staining and in vitro cell coculture assays. Taken together, the results from this study demonstrated that the S100a4+ alveolar macrophage subset contributes to tumorigenesis by altering its metabolic state, suggesting that metabolic interventions targeting this cell state in the early stage of disease may delay neoplastic transformation of the lung epithelium." ;
    schema1:identifier "S-BIAD1943" ;
    schema1:keywords "precancerous lesion, atypical adenomatous hyperplasia, alveolar macrophage, fatty acid metabolism, angiogenesis, lung cancer" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "S100a4+ alveolar macrophages accelerate the progression of precancerous atypical adenomatous hyperplasia by promoting fatty acid metabolism" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1943#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1943#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
    schema1:thumbnailUrl "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD1943/50aa8b9d-8623-465a-867b-1aa23677de37/static_display_512_512.png" .

