<https://ssbd.riken.jp/repository/ssbd-repos-000302/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000265,
        <https://ssbd.riken.jp/repository/ssbd-repos-000302/#imaging-protocol-1> ;
    schema1:about obo:NCBITaxon_10090 ;
    schema1:author <https://ssbd.riken.jp/repository/ssbd-repos-000302/#auth-001> ;
    schema1:datePublished "2023-06-09" ;
    schema1:description """We performed live imaging of the nuclear shape of the upper layer neurons of the visual cortex in young and aged NexCre;SUN1-GFP mice in vivo with two-photon microscopy before, during, and after visual light exposure following the prior preparations of craniotomy on the visual cortex for time-lapse imaging. NexCre;SUN1-GFP mice expressed the GFP-fused SUN1 protein, a protein on the outer nuclear membrane, in the excitatory neurons under the control of the NeuroD6/Nex gene locus.\r
Keywords; time-lapse imaging, two-photon microscopy, nucleus, excitatory neuron, visual cortex, visual stimulation, aging.""" ;
    schema1:identifier "ssbd-repos-000302" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Nuclear shape of excitatory neurons in the visual cortex upon visual stimulation of young and aged mice" ;
    schema1:publisher <https://ssbd.riken.jp/repository> ;
    schema1:size <https://ssbd.riken.jp/repository/ssbd-repos-000302/#file-count>,
