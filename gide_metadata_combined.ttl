<https://idr.openmicroscopy.org/study/idr0015/#screen-biosample-1> a schema1:BioSample ;
    schema1:description "eHCFM: a 3D-fluorescence imaging and classification tool for high throughput analysis of microbial eukaryotes in environmental samples. The method generates for each given sample a mosaic of multi-dimentional fields of view (3D, 5 channels). We propose here the exploration of raw images of plankton samples from the Tara Oceans expeditions." ;
    schema1:name "cell" ;
    schema1:taxonomicRange obo:NCBITaxon_1427524 .

<https://idr.openmicroscopy.org/study/idr0015/#screen-protocol-1-0> a schema1:LabProtocol ;
    schema1:description "eHCFM: a 3D-fluorescence imaging and classification tool for high throughput analysis of microbial eukaryotes in environmental samples. The method generates for each given sample a mosaic of multi-dimentional fields of view (3D, 5 channels). We propose here the exploration of raw images of plankton samples from the Tara Oceans expeditions." ;
    schema1:measurementTechnique obo:FBbi_00000251 ;
    schema1:name "confocal microscopy" .

