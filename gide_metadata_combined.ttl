<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD861> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000251,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD861#206a1e48-8cf9-44fd-af24-64697e29d8cf> ;
    schema1:about obo:NCBITaxon_1427524,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD861#07b872f3-d3bd-4d2b-b4be-8b258b4eef39> ;
    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD861#9c928c0b-0417-4fce-bfad-419b2531b47c> ;
    schema1:datePublished "2023-08-25" ;
    schema1:description "OME-NGFF converted study from idr0015.  We present a 3D-fluorescence imaging and classification tool for high throughput analysis of microbial eukaryotes in environmental samples. It entails high-content feature extraction that permits accurate automated taxonomic classification and quantitative data about organism ultrastructures and interactions. Using plankton samples from the Tara Oceans expeditions, we validate its applicability to taxonomic profiling and ecosystem analyses, and discuss its potential for future integration of eukaryotic cell biology into evolutionary and ecological studies. This study is subject to the data release policy described here: http://www.embl.de/tara-oceans/start/Tara-Oceans-Data-Release-Policy.pdf" ;
    schema1:identifier "S-BIAD861" ;
    schema1:keywords "Automated microscopy",
        "Environmental cell biology",
        "Machine learning",
        "Marine plankton biodiversity",
        "Microbial eukaryotes",
        "Symbioses" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Quantitative 3D-imaging for cell biology and ecology of environmental microbial eukaryotes (OME-NGFF)" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD861#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
