<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1134#b64ae7e2-c038-4420-90a1-c87ed1647a66> a schema1:LabProtocol ;
    schema1:description """5 min time interval

3 imaging channels:
- mRuby2
- mTurquoise
- miRFP703

Images are 2x cropped and binned in post, leading to a final isotropic pixel size of 0.29μm/px.""" ;
    schema1:labEquipment "Light-sheet microscope" ;
    schema1:measurementTechnique obo:FBbi_00000246,
        obo:FBbi_00000249 ;
    schema1:name "Image acquisition" .

