<https://ssbd.riken.jp/v3/project/320-Spratt-dMetRaman> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000589,
        <https://ssbd.riken.jp/v3/project/320-Spratt-dMetRaman#imaging-protocol-1> ;
    schema1:about <https://ssbd.riken.jp/v3/project/320-Spratt-dMetRaman#biosample-1>,
        <https://ssbd.riken.jp/v3/project/320-Spratt-dMetRaman#biosample-2>,
        <https://ssbd.riken.jp/v3/project/320-Spratt-dMetRaman#biosample-3>,
        <https://www.ncbi.nlm.nih.gov/datasets/taxonomy/7215> ;
    schema1:author <https://ssbd.riken.jp/v3/project/320-Spratt-dMetRaman#auth-001>,
        <https://ssbd.riken.jp/v3/project/320-Spratt-dMetRaman#auth-002>,
        <https://ssbd.riken.jp/v3/project/320-Spratt-dMetRaman#auth-003>,
        <https://ssbd.riken.jp/v3/project/320-Spratt-dMetRaman#auth-004>,
        <https://ssbd.riken.jp/v3/project/320-Spratt-dMetRaman#auth-005>,
        <https://ssbd.riken.jp/v3/project/320-Spratt-dMetRaman#auth-006> ;
    schema1:datePublished "2025-04-10" ;
    schema1:description "Introduction: Visualizing small individual biomolecules at subcellular resolution in live cells and tissues can provide valuable insights into metabolic activity in heterogeneous cells, but is challenging. Methods: Here, the authors used stimulated Raman scattering (SRS) microscopy to image deuterated methionine (d-Met) incorporated into Drosophila tissues in vivo. Results: Their results demonstrate that SRS can detect a range of previously uncharacterized cell-to-cell differences in d-Met distribution within a tissue at the subcellular level. Discussion: These results demonstrate the potential of SRS microscopy for metabolic imaging of less abundant but important amino acids such as methionine in tissue." ;
    schema1:funder <https://ssbd.riken.jp/v3/project/320-Spratt-dMetRaman#grant-001> ;
    schema1:identifier "320-Spratt-dMetRaman" ;
    schema1:keywords "Brain",
        "Fat Body",
        """Imaginal Discs,
Wings, Animal""",
        "Lysosomes" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Stimulated Raman images of deuterated methionine incorporated into adult and larval Drosophila" ;
    schema1:publisher <https://ssbd.riken.jp/database> ;
    schema1:size <https://ssbd.riken.jp/v3/project/320-Spratt-dMetRaman#file-count>,
        <https://ssbd.riken.jp/v3/project/320-Spratt-dMetRaman#total-dataset-size> ;
    schema1:thumbnailUrl "https://ssbd.riken.jp/ssbd-omero/v1/projects/1654/render_thumbnail/" ;
    rdf:seeAlso <https://doi.org/10.3389/fchem.2023.1141920> .

