<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1075> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        obo:FBbi_00000247,
        obo:FBbi_00000251,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1075#14672fdb-4b85-44ab-97c8-409f1abb756f> ;
    schema1:about obo:NCBITaxon_3702,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1075#c22c87df-46d4-4cb8-ba04-16604f987074> ;
    schema1:author <https://orcid.org/0000-0002-1451-5967>,
        <https://orcid.org/0000-0003-3679-7595> ;
    schema1:datePublished "2024-03-07" ;
    schema1:description "TRAPP (transport protein particle) tethering complexes are known for their function as Rab-GTPase exchange factors (GEFs). In yeast and animal cells, TRAPPIII is an activator the Rab1 family (RabD in plants) which regulates ER-to-Golgi trafficking and autophagy. In Arabidopsis thaliana, the TRAPPIII complex has been identified and its subunit composition established, but little is known about its functions. We study here the TRAPPC8 subunit of the Arabidopsis thaliana TRAPPIII complex. The purpose of this experiment was to establish whether loss-of-function mutations of TRAPPC8 cause an impairment in autophagy in Arabidopsis thaliana. Methodology described in detail in accompanying preprint (BioRxiv): doi: https://doi.org/10.1101/2024.01.11.575191." ;
    schema1:identifier "S-BIAD1075" ;
    schema1:keywords "ATG8",
        "TRAPPC8",
        "TRAPPIII",
        "autophagy",
        "plant" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
