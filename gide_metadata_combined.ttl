    schema1:keywords "DL-based 3D semgentation",
        "Follicle",
        "Medaka",
        "Ovary",
        "miR-187" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Unveiling the role of mir-187 in adult ovarian follicle growth in medaka (Oryzias latipes)" ;
