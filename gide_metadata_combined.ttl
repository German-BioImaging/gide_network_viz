<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1407> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000243,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1407#dd77370e-cac6-48eb-8cbe-daf61236d970> ;
