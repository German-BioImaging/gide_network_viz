<https://ssbd.riken.jp/repository/ssbd-repos-000435/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000251,
        obo:FBbi_00000345,
        <https://ssbd.riken.jp/repository/ssbd-repos-000435/#imaging-protocol-1>,
        <https://ssbd.riken.jp/repository/ssbd-repos-000435/#imaging-protocol-2> ;
    schema1:about obo:GO_0060070,
        obo:NCBITaxon_7955,
        <https://ssbd.riken.jp/repository/ssbd-repos-000435/#biosample-1> ;
    schema1:author <https://ssbd.riken.jp/repository/ssbd-repos-000435/#auth-001> ;
    schema1:datePublished "2025-05-19" ;
    schema1:description "Cells functioning at a specific zone by clustering according to gene expression are recognized as zonated cells. Here, we demonstrate anatomical and functional zones in the zebrafish heart. The cardiomyocytes (CMs) at the atrioventricular canal between the atrium and ventricle could be grouped into three zones according to the localization of signal-activated CMs: Wnt/β-catenin signal+, Bmp signal+, and Tbx2b+ zones. Endocardial endothelial cells changed their characteristics, penetrated the Wnt/β-catenin signal+ CM zone, and became coronary ECs covering the heart. Coronary vessel length was reduced when the Wnt/β-catenin signal+ CMs were depleted. Collectively, we demonstrate the importance of anatomical and functional zonation of CMs in the zebrafish heart." ;
    schema1:funder <https://ssbd.riken.jp/repository/ssbd-repos-000435/#grant-001> ;
    schema1:identifier "ssbd-repos-000435" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Images of coronary vessels and Wnt/βcatenin signaling-activated cardiomyocytes in zebrafish." ;
    schema1:publisher <https://ssbd.riken.jp/repository> ;
    schema1:size <https://ssbd.riken.jp/repository/ssbd-repos-000435/#file-count>,
        <https://ssbd.riken.jp/repository/ssbd-repos-000435/#total-dataset-size> ;
    rdf:seeAlso <https://doi.org/10.1016/j.devcel.2024.09.012> .

