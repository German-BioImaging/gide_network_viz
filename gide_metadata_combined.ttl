<https://idr.openmicroscopy.org/study/idr0067/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://idr.openmicroscopy.org/study/idr0067/#experiment-protocol-1-0>,
        <https://idr.openmicroscopy.org/study/idr0067/#experiment-protocol-1-1>,
        <https://idr.openmicroscopy.org/study/idr0067/#experiment-protocol-1-2>,
        <https://idr.openmicroscopy.org/study/idr0067/#experiment-protocol-1-3>,
        <https://idr.openmicroscopy.org/study/idr0067/#experiment-protocol-1-4> ;
    schema1:about obo:NCBITaxon_4932,
        <https://idr.openmicroscopy.org/study/idr0067/#experiment-biosample-1> ;
    schema1:author <https://orcid.org/0000-0002-6768-609X> ;
    schema1:copyrightNotice "King et al., CC-BY-4.0, 2019" ;
    schema1:datePublished "2019-12-10" ;
    schema1:description "Production of healthy gametes in meiosis relies on the quality control and proper distribution of both nuclear and cytoplasmic contents. Meiotic differentiation naturally eliminates age-induced cellular damage by an unknown mechanism. Using time-lapse fluorescence microscopy in budding yeast, we found that nuclear senescence factors - including protein aggregates, extrachromosomal ribosomal DNA circles, and abnormal nucleolar material - are sequestered away from chromosomes during meiosis II and subsequently eliminated. A similar sequestration and elimination process occurs for the core subunits of the nuclear pore complex in both young and aged cells. Nuclear envelope remodeling drives the formation of a membranous compartment containing the sequestered material. Importantly, de novo generation of plasma membrane is required for the sequestration event, preventing the inheritance of long-lived nucleoporins and senescence factors into the newly formed gametes. Our study uncovers a new mechanism of nuclear quality control and provides insight into its function in meiotic cellular rejuvenation." ;
    schema1:identifier "idr0067" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Meiotic cellular rejuvenation is coupled to nuclear remodeling in budding yeast" ;
    schema1:publisher <https://idr.openmicroscopy.org/> ;
    schema1:thumbnailUrl "https://idr.openmicroscopy.org/webgateway/render_thumbnail/9036345/" ;
    rdfs:seeAlso <https://doi.org/10.7554/eLife.47156> .

<https://idr.openmicroscopy.org/study/idr0067/#experiment-biosample-1> a schema1:BioSample ;
    schema1:description "Time-lapse and fixed cell fluorescence microscopy or transmission electron microscopy images depicting budding yeast cells progressing through meiosis. The goal of this study was to characterize nuclear remodeling during budding yeast meiosis, with a focus on determining how various nuclear senescence factors are eliminated." ;
    schema1:name "cell" ;
    schema1:taxonomicRange obo:NCBITaxon_4932 .

<https://idr.openmicroscopy.org/study/idr0067/#experiment-protocol-1-0> a schema1:LabProtocol ;
    schema1:description "Time-lapse and fixed cell fluorescence microscopy or transmission electron microscopy images depicting budding yeast cells progressing through meiosis. The goal of this study was to characterize nuclear remodeling during budding yeast meiosis, with a focus on determining how various nuclear senescence factors are eliminated." ;
    schema1:measurementTechnique obo:FBbi_00000246 ;
    schema1:name "fluorescence microscopy" .

