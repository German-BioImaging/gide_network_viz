<https://idr.openmicroscopy.org/study/idr0034/#person-1> a schema1:Person ;
    schema1:address "Centre for Stem Cells & Regenerative Medicine, King's College London, Tower Wing, Guy's Hospital, Great Maze Pond, London SE1 9RT, United Kingdom" ;
    schema1:familyName "Danovi" ;
