        "Mice, Knockout",
        "Microscopy, Electron, Transmission",
        "Multigene Family",
        "Muscle Cells/metabolism",
        "Neurons/metabolism",
        "Single-Cell Analysis",
        "Transcriptome/genetics[major]" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Mapping the molecular and structural specialization of the skin basement membrane for inter-tissue interactions" ;
    schema1:publisher <https://ssbd.riken.jp/repository> ;
    schema1:size <https://ssbd.riken.jp/repository/ssbd-repos-000170/#file-count>,
