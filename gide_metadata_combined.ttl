<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD725#e2dbafec-44fe-4a53-89d2-0351c077cb03> a schema1:LabProtocol ;
    schema1:description "Stained embryos are imaged on a Zeiss LSM900 Inverted Laser Scanning Confocal Microscope with Airyscan detector. Excitation is achieved using a 488 nm laser line through a 63x/1.4 OIL DICII PL APO objective. Emission is collected through a 525/50 band pass filter onto an airyscan photomultiplier (PMT) allowing to increase the resolution up to a factor 1.7." ;
    schema1:labEquipment "Stained embryos are imaged on a Zeiss LSM900 Inverted Laser Scanning Confocal Microscope with Airyscan detector. Excitation is achieved using a 488 nm laser line through a 63x/1.4 OIL DICII PL APO objective. Emission is collected through a 525/50 band pass filter onto an airyscan photomultiplier (PMT) allowing to increase the resolution up to a factor 1.7." ;
    schema1:measurementTechnique obo:FBbi_00000345 ;
    schema1:name "Imaging of stained embryos" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD728> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000251,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD728#0b640d36-36ff-4f15-8074-91d4f2492b6a> ;
