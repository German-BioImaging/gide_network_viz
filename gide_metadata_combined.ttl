<https://ssbd.riken.jp/repository/ssbd-repos-000413/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000243,
        <https://ssbd.riken.jp/repository/ssbd-repos-000413/#imaging-protocol-1> ;
    schema1:about obo:GO_0099563,
        obo:NCBITaxon_10090,
        obo:UBERON_0010291,
        <https://ssbd.riken.jp/repository/ssbd-repos-000413/#biosample-1> ;
    schema1:author <https://ssbd.riken.jp/repository/ssbd-repos-000413/#auth-001> ;
    schema1:datePublished "2025-02-01" ;
    schema1:description """The mouse (Mus musculus) is the most standard model organism among mammals, but descriptive studies on its development are limited. This dataset was created to provide a deeper understanding of craniofacial morphogenesis in mice. \r
\r
The histological sections were prepared from wild-type mice at developmental stages 8.5, 9.5, 10.5, 11.5, 12.5, 13.5, 14.5, and 15.5 dpc (days post-coitum), with a focus on the head region. The samples were fixed using Serra's fixative and stored in 70% ethanol. Paraffin sections were prepared following standard protocols. All sections were sagittal, with a thickness of 6 µm for 8.5 and 9.5 dpc, and 9 µm for 10.5 to 15.5 dpc. Peripheral nerves were stained using immunohistochemistry with anti-acetylated tubulin antibody and visualized with DAB. Subsequent staining included alcian blue, hematoxylin, and eosin, performed according to standard procedures.""" ;
    schema1:funder <https://ssbd.riken.jp/repository/ssbd-repos-000413/#grant-001> ;
    schema1:identifier "ssbd-repos-000413" ;
    schema1:keywords "Animals",
        "Biological Evolution",
        "Maxilla/anatomy & histology",
        "Maxilla/embryology",
        "Maxillofacial Development[major]",
        "Mice/anatomy & histology",
        "Skull/anatomy & histology",
        "Skull/embryology" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
