<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2215> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        obo:FBbi_00000251,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2215#39d9ae96-802f-41af-b1b6-687c44b2eebd> ;
    schema1:about obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2215#f2bd5995-980f-4adf-925e-b35a29e4373b> ;
    schema1:author <https://orcid.org/0000-0001-9967-5398>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2215#31e2bece-13e2-4b03-9edb-86631790b3e8>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2215#63d2ab91-b395-4854-9cce-6faaab82caa5>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2215#72b7fa0d-289a-42cc-a34b-d7690d959c0e>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2215#cefc5db2-fec9-4417-bd7a-5f0b3b5cc946>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2215#d4c21970-3da7-41fa-b973-eab6578a396a> ;
    schema1:datePublished "2025-08-01" ;
    schema1:description "Loss of polarity is a hallmark of cancer, and the related epithelial-to-mesenchymal transition (EMT) phenotype also impacts prognosis and therapy outcomes, particularly in colorectal cancer (CRC). However, the mechanisms and drugs that impact these morphological changes are understudied, due to the complete failure of typical live/dead 2D high-throughput screens to capture morphology or the lack of robustness of 3D screens. We designed a high-throughput screen using 3D type I collagen cultures of CRC cells to assess morphological changes in colonies and identified several FDA-approved drugs that re-epithelialize CRC colonies (images uploaded here are images from screen). One of these drugs, azithromycin, increased colony circularity, enhanced E-cadherin membrane localization and ZO-1 localization to tight junctions, caused transcriptomic changes consistent with downregulation of epithelial-to-mesenchymal transition, and elevated sensitivity to the chemotherapeutic, irinotecan. A retrospective analysis of patient data demonstrated that the use of azithromycin in patients undergoing treatment for CRC with irinotecan had improved the 5-year survival compared to the chemotherapy alone. These results highlight the importance of morphological screens to identify novel drug candidates and synergistic mechanisms. " ;
    schema1:identifier "S-BIAD2215" ;
    schema1:keywords "3D Collagen Cultures",
        "Chemotherapy",
        "Colorectal Cancer",
        "Drug Resistance",
        "EMT",
        "Epithelial Polarity",
        "Epithelial-to-Mesenchymal Transition",
        "High-Content Imaging",
        "High-Throughput Screen" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "3D collagen high-throughput screen identifies drugs that induce epithelial polarity and enhance chemotherapy response in colorectal cancer" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2215#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2215#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
    schema1:thumbnailUrl "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD2215/d615fd3f-35aa-474f-915b-664af8553446/static_display_512_512.png" .

