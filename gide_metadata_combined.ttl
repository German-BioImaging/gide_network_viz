<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2254#c04450cd-1f30-4551-9ad5-d22bedba7e25> a schema1:LabProtocol ;
    schema1:description "Spheroids were detected using a custom Nikon JOBS/GA3 protocol. Each well was first scanned at 4× in the SYTO channel to locate spheroids by thresholding. Identified spheroids were then scanned at 20× to determine the Z-position based on changes in focus, after which imaging was performed in five channels with 5 µm spacing across 12 optical sections. Protocols are available in the image_acquisition folder, as well as the filter_settings. " ;
    schema1:labEquipment "Nikon ECLIPSE Ti2-E inverted microscope (Nikon) equipped with a PLAN APO λD 20×/0.8 NA OFN25 DIC N2 objective (working distance 0.8 mm) combined with a 1.5× additional zoom (effective magnification 30×, resolution 0.227 µm/pixel), a Celesta light engine with 50 µm spinning disk (250 µm spacing). Images were acquired as 16-bit OME-TIFF files (1048 × 1048 pixels)." ;
    schema1:measurementTechnique obo:FBbi_00000253 ;
    schema1:name "Image acquisition 3D Cell Painting" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2255> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2255#673875d3-258e-42fb-bb69-2f42040f842c> ;
    schema1:about obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2255#db734852-e6b0-4384-bbc4-82e296a93e8d> ;
    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2255#3a63f237-e56d-4ae9-a640-a86941063abb> ;
    schema1:datePublished "2025-08-29" ;
    schema1:description """T cells are critical effector cells against infections and malignancies. To achieve this, they produce pro-inflammatory cytokines, including IFN-γ and TNF. Cytokine production is a tightly regulated process. The relative contribution of transcriptional and post-transcriptional regulation to mRNA expression is, however, unknown. We therefore optimized single-molecule FISH for primary human T cells (T-cell smFISH) to simultaneously quantify nascent RNA, mature mRNA levels and its localization with single-cell resolution. T-cell smFISH uncovered heterogeneous cytokine mRNA levels, with high cytokine producers displaying biallelic IFNG/TNF RNA transcription activity. Throughout activation, nuclear cytokine mRNAs accumulated, whereas cytoplasmic cytokine mRNA was degraded through translation-dependent decay. Lastly, T-cell smFISH uncovered cytokine-specific regulation by the RNA-binding protein HuR. Thus, T-cell smFISH provides novel insights in the intricate (post)-transcriptional processes in T cells.  
""" ;
    schema1:identifier "S-BIAD2255" ;
    schema1:keywords "Post-transcriptional regulation, smFISH, T cells, cytokine regulation" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "Single molecule imaging of transcription dynamics, RNA localization and fate in T cells " ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2255#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2255#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
