<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1176> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000345,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1176#3ca1c627-5044-4d3b-a6aa-a5393a736c30>,
