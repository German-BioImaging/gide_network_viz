<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1410> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1410#bd6bc985-f444-4451-a8d1-0e050835f958>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1410#fca79910-db9e-4cee-8fe6-d9785e9496c7> ;
    schema1:about obo:NCBITaxon_7227,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1410#1f06a200-0204-4d21-b538-b5b2a6e70103>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1410#9e2c4e6e-97d6-4477-88fe-11a2eddedbad>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1410#b1732b4d-e027-4584-ac92-c2296cf0edd6> ;
    schema1:author <https://orcid.org/0000-0001-8644-6633>,
        <https://orcid.org/0000-0002-5204-3227>,
        <https://orcid.org/0000-0002-6495-8598>,
        <https://orcid.org/0000-0002-8191-7528>,
        <https://orcid.org/0000-0003-0770-744X> ;
    schema1:datePublished "2024-10-30" ;
    schema1:description """Segmenting multi-dimensional microscopy data requires high accuracy across many images (e.g. timepoints) and is thus a labour-intensive part of biological image processing pipelines. We present ReSCU-Nets, recurrent convolutional neural networks that use the segmentation results from the previous frame as a prompt to segment the current frame. We demonstrate that ReSCU-Nets outperform state-of-the-art image segmentation models in different segmentation tasks on time-lapse microscopy sequences. 

This study contains three datasets containing timelapse fluorescence microscopy videos of cell migration processes during Drosophila embryonic development, with accompanying ground truth segmentations. The first dataset shows the nuclei of cardioblasts as they migrate to form the early heart tube. The second and third datasets show epithelial cell outlines during embryonic wound healing. The second dataset provides ground truth segmentations of the wound itself, while the third dataset contains ground truth segmentations of cell areas around the wound.""" ;
    schema1:identifier "S-BIAD1410" ;
    schema1:keywords "cell migration",
        "developmental biology",
        "fluorescence microscopy" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "ReSCU-Nets: recurrent U-Nets for segmentation of multidimensional microscopy data" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1410#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1410#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
    schema1:thumbnailUrl "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD1410/2c43429c-f314-4734-bf52-d5e0950f1450/static_display_512_512.png",
        "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD1410/464d0759-7720-481a-8786-feaed22a08be/static_display_512_512.png",
        "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD1410/8b17a724-0c47-43bf-ab0c-321f0d7b6231/static_display_512_512.png" .

