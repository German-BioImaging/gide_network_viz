<https://ssbd.riken.jp/v3/project/378-Minegishi-MetastaticNiche> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000249,
        obo:FBbi_00000251,
        <https://ssbd.riken.jp/v3/project/378-Minegishi-MetastaticNiche#imaging-protocol-1>,
