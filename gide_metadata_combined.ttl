    schema1:author <https://orcid.org/0000-0002-8192-869X>,
        <https://orcid.org/0009-0009-7292-7714>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1092#1f8af249-1b5f-4ff4-ba09-6c2b8b582047>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1092#28db646f-d039-458b-80a1-7d166154cec0>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1092#3714af87-aa9d-416d-bc40-9e04f349e34d>,
