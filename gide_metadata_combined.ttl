<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1474> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000243,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1474#31a68388-097c-4faf-9d94-356efa06a36b>,
