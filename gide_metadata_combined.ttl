<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2201> a schema1:Dataset ;
    dwciri:measurementMethod <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2201#b9970d64-5482-4e4f-ae6d-f92630c2253f> ;
    schema1:about <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2201#dd979524-64d0-4726-940a-ff7d165604ca> ;
    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2201#4f29941c-f138-448b-b1d0-f04696a784ac> ;
    schema1:datePublished "2025-07-30" ;
    schema1:description "Stem cell-derived embryo models could greatly facilitate our understanding of embryonic development. Here we developed an in vitro culture system supporting stem cell-derived monkey blastoid developing to day 25 (D25). Morphological and transcriptomic analyses showed that these monkey embryoids underwent gastrulation and largely recapitulated key developmental events of the late gastrulation stage observed in vivo, with the appearance of neural plate, hematopoietic system, allantois, primitive gut, primordial germ cells, yolk sac structures, and progenitors of other organs, excluding extraembryonic tissues. This primate stem cell-derived embryo model provides a valuable platform for dissecting the mechanisms of primate embryonic development from blastocyst to late gastrulation stage. " ;
    schema1:identifier "S-BIAD2201" ;
    schema1:keywords "Primate; Stem cell; Embryo model; Gastrulation" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name """Modeling late gastrulation in stem-cell derived monkey embryo models
""" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2201#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2201#480bb0bc-db43-46e5-88ae-071380b9d63c> .

