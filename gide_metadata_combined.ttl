<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1401#d3506455-94d1-4341-b4f7-335484507a40> a schema1:LabProtocol ;
    schema1:description "Images were acquired directly after FISH protocol or after some days stored at -20 degrees (less than one week). Images were acquired using a Plan-Apochromat 63x/1.4 oil immersion objective and Zeiss 1.518 refractive index (Abbe number: 45) oil immersion media. For excitation, 405 nm (for DAPI), 488 nm (Alexa Fluor 488) and 561 nm (Texas Red) laser diodes were used. The emitted light was detected in a sequential mode with the Airyscan detector with the emission filters: 465 (DAPI), 517 (AF488) and 592 (TR) with an Airyscan detector. Images covered a 20um axial range, covering the complete cell nuclei volume, with stacks of 0.13 um and a voxel size of 73 x 73 x 130 nm3. Zoom factor was 3.6, scanning was unidirectional and line average was set to 2, with an image size of 35.7 x 35.7 um2. " ;
    schema1:labEquipment "Zeiss linescan confocal LSM980 with Airyscan 2" ;
    schema1:measurementTechnique obo:FBbi_00000251 ;
    schema1:name "Image acqusition" .

