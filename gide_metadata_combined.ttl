<https://idr.openmicroscopy.org/study/idr0012/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://idr.openmicroscopy.org/study/idr0012/#screen-protocol-1-0>,
        <https://idr.openmicroscopy.org/study/idr0012/#screen-protocol-1-1>,
