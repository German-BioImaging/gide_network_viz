<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2396#898f716f-544e-4ea2-8cd0-e1ad5a0b2bc1> a schema1:LabProtocol ;
    schema1:description "Whole E.coli BL21(DE3) cells expressing IronSenseR were excited with a 488 nm laser (0.5% laser power). Pixel dwell time was set to 2 µs with a line averaging of 2 and a pinhole diameter of 1 AU. Detector range was set to 500-530 nm for cpsfGFP. Fluorescence of LSSmApple was collected at 600-700 nm." ;
    schema1:labEquipment "Olympus Fluoview 3000 confocal laser scanning microscope equipped with a 60x UPLSAPO water objective (NA 1.2) and a 488 nm laser." ;
    schema1:measurementTechnique obo:FBbi_00000246 ;
    schema1:name "E. coli BL21(DE3) IronSenseR confocal imaging" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2398> a schema1:Dataset ;
    dwciri:measurementMethod <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2398#cf77a131-a919-4692-926e-4644bb31b7fc> ;
    schema1:about obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2398#48cc3aa4-b86e-4587-bea3-d3118b25d322> ;
    schema1:author <https://orcid.org/0000-0002-7988-2055> ;
    schema1:datePublished "2025-11-17" ;
    schema1:description "This dataset comprises live-cell fluorescence resonance energy transfer (FRET) and corresponding bright-field images of MCF-7 cells co-expressing the fluorescently tagged proteins CFP-BCL-XL and YFP-BAK under various drug treatment conditions. The data were acquired using quantitative FRET microscopy to simultaneously capture dynamic drug-target interactions and morphological changes at single-cell resolution. This resource enables the quantitative analysis of drug-induced modulation of BCL-XL/BAK interactions, the correlation between target engagement and phenotypic outcomes, and the development of computational models for drug efficacy scoring. The dataset is an essential resource for researchers in cancer biology, drug discovery, and high-content image analysis, providing a foundation for studying dynamic protein-protein interactions and functional drug responses in a live-cell context." ;
    schema1:identifier "S-BIAD2398" ;
    schema1:keywords "Bright-field images",
        "FRET images" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "Database of FRET and bright-field images for MCF-7 cells co-expressing CFP-BCL-XL and YFP-BAK under drug treatment" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2398#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2398#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
    schema1:thumbnailUrl "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD2398/0231381b-91fc-464e-896e-935057ad9005/static_display_512_512.png" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2398#1037e7dd-b10a-47a1-885c-1f3b2998ff1c> a <https://www.ebi.ac.uk/biostudies/bioimages/studies/QuantitiveValue> ;
