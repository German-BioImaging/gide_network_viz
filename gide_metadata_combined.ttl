    schema1:name "Naoya Yamashita" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD594#b3321103-dfa1-4584-939a-6c40ff5fc3c1> a schema1:Person ;
    schema1:affiliation <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD594#c836f11f-8f11-42a1-bd8e-87991cb29fc1> ;
    schema1:email "gmoyaal1@jhu.edu" ;
    schema1:name "Guillermo Moya-Alvarado" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD594#c4e821e3-df5e-45aa-9192-c96871720989> a schema1:LabProtocol ;
    schema1:description "Sympathetic neurons isolated from P1-P4 TrkAWT or TrkAR685A mice were grown in compartmentalized cultures (Campenot chambers) for 7-9 days in vitro. Neurons were either completely deprived of NGF, or NGF (30 ng/ml) was added only to distal axons. BAF (50 μM) was also included to allow assessment of axon growth without the complications of cell death. Phase contrast images of axons were captured using a Retiga EXi camera in 24-hr intervals for 3 days on a Zeiss Axiovert 200 microscope. Axon growth rate was measured using Openlab 4.0.4 for an average of 10-20 axons per condition. Axons were fixed in 4% PFA and stained with β-III-tubulin for representative images following experiments. Sympathetic ganglia for counting neuron number of Nissl stained tissues were obtained by imaging every 5th section of the ganglia in 10um sections using brightfield microscopy." ;
    schema1:labEquipment "Zeiss Axiovert 200 microscope" ;
    schema1:measurementTechnique obo:FBbi_00000243,
        obo:FBbi_00000244,
        obo:FBbi_00000245,
        obo:FBbi_00000247 ;
    schema1:name "Epiflourescence and Phase contrast imaging" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD594#e30572d1-9799-4e04-bc0f-c8d144f96e86> a schema1:Organization ;
    schema1:name "National Institute of Neurological Disorders and Stroke" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD594#f2016071-9eac-4481-8d73-a7961955ecad> a schema1:Organization ;
