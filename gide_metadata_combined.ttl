<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD712> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000251,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD712#2f586303-206d-403f-915c-e74a90f4c1e7> ;
    schema1:about obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD712#328ca2de-070f-47d8-b0e9-bfb22b0e7e62> ;
    schema1:author <https://orcid.org/0000-0003-0597-4923>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD712#d2b6c167-e546-40ca-99bc-460b0570a469> ;
    schema1:datePublished "2023-05-26" ;
    schema1:description "Live undifferentiated KOLF2.1J human iPSCs were labelled with 7 organelle markers targeted to the nucleus, endoplasmic reticulum (ER), Golgi, mitochondria, peroxisomes, lysosomes, and lipid droplets. Complete z-stack and timelapse images were acquired in lambda mode (410-695 nm, 8.9 nm resolution) and subsequently linear unmixed into 8 different channels (channel 1 to 7 correspond to organelles, while channel 8 is the residual of the unmixing)." ;
    schema1:identifier "S-BIAD712" ;
    schema1:keywords "live iPSCs",
        "multispectral ",
        "organelles" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Multispectral imaging of 7 organelles in live undifferentiated human induced pluripotent stem cells (hiPSCs)." ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD712#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD712#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
    schema1:thumbnailUrl "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD712/bf237c4b-55f0-4326-aabe-6f4ea48f2ed3/40f610f2-9841-4a51-ab39-f00fadfd1dd4.png" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD712#1037e7dd-b10a-47a1-885c-1f3b2998ff1c> a <https://www.ebi.ac.uk/biostudies/bioimages/studies/QuantitiveValue> ;
