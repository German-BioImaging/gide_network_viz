    schema1:author <https://orcid.org/0000-0002-8501-8028>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1752#216f0994-ee5f-44bf-9832-3b81fd82f72c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1752#500dc991-bb71-4f13-9ffa-748332743f33>,
