<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD594#6a2fed3f-0ae5-42d6-ab82-1c7bc4b76986> a schema1:Person ;
    schema1:affiliation <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD594#c836f11f-8f11-42a1-bd8e-87991cb29fc1> ;
