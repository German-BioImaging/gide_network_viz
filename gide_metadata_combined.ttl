<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD829> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD829#972a16a1-5b04-40be-a2a4-28cc010d82d8> ;
    schema1:about obo:NCBITaxon_10090,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD829#34b8a40e-8c01-47e5-a7ba-00f010d2d532> ;
    schema1:author <https://orcid.org/0000-0001-9201-7173> ;
    schema1:datePublished "2023-08-31" ;
    schema1:description "A high-salt diet (HSD) elicits sustained sterile inflammation and worsens tissue injury. However, how this occurs after stroke, a leading cause of morbidity and mortality, remains unknown. Here, we report that HSD impaired long-term brain recovery after intracerebral hemorrhage, a severe form of stroke, despite salt withdrawal prior to the injury. Mechanistically, HSD induced innate immune priming and training in hematopoietic stem and progenitor cells (HSPCs) by downregulation of NR4a family and mitochondrial oxidative phosphorylation. This training compromised alternative activation of monocyte-derived macrophages (MDMs) without altering the initial inflammatory responses of the stroke brain. Healthy mice transplanted with bone marrow from HSD-fed mice retained signatures of reduced MDM reparative functions, further confirming a persistent form of innate immune memory that originates in the bone marrow. Lack of NR4a1 in macrophages recapitulated HSD-induced negative impacts on stroke outcomes while gain of NR4a1 enabled stroke recovery in HSD animals. Together, we provide the first evidence that links HSD-induced innate immune memory to the acquisition of persistent dysregulated inflammatory responses and unveils NR4a1 as a potential therapeutic target." ;
    schema1:identifier "S-BIAD829" ;
    schema1:keywords "high salt diet/intracerebral hemorrhage/nr4a1/macrophages/trained immunity" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "Trained immunity induced by high salt diet impedes stroke recovery" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD829#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD829#480bb0bc-db43-46e5-88ae-071380b9d63c> .

