        <https://idr.openmicroscopy.org/study/idr0157/#experiment-protocol-1-3>,
        <https://idr.openmicroscopy.org/study/idr0157/#experiment-protocol-1-4> ;
    schema1:about obo:NCBITaxon_122615,
        obo:NCBITaxon_122620,
        obo:NCBITaxon_122635,
        obo:NCBITaxon_122636,
