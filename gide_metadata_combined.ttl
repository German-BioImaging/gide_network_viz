<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1287> a schema1:Dataset ;
    dwciri:measurementMethod <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1287#8e312f2d-8150-4a8f-acbb-548d11e5c043> ;
    schema1:about obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1287#3fe3dc4b-6ce0-4a8b-a01e-84b643354eaa>,
