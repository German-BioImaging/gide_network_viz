<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1013#40d2b2f4-ea11-4b4a-9df1-42556aeefdfc> a schema1:LabProtocol ;
    schema1:description "Cell monolayers were imaged on an Operetta CLS LIVE (Revvity) high content microscope, using a 20x N.A. 0.8 air objective. The 355-385 nm LED was used to image nuclei (Hoechst H33258), the 460-490 nm LED was used to image phospho-Ser807/811 Rb, the 530-560 nm LED was used to detect either p21 or p27 CDK inhibitory proteins (depending on the specific stain used) and the 615-645nm nm LED was used to detect EdU. " ;
    schema1:labEquipment "Operetta CLS LIVE (Revvity) high content microscope in widefield mode using a 20x N.A. 0.8 air objective." ;
    schema1:measurementTechnique obo:FBbi_00000246 ;
    schema1:name "Secondary Screen Image Acquisition" .

