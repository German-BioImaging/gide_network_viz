<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2239#ec54aeda-c142-444a-9854-40802bcc4359> a schema1:LabProtocol ;
    schema1:description "Following immunohistochemistry, sectioned mouse brains were imaged on a Nikon confocal AX microscope, using 10x, 20x or 40x magnification settings. The 488 nm laser was used to image microglia (Iba1) and the 561 nm laser was used to image T cells (CD4), both at 6% laser power. Z Stack settings are as follows: 1.554 μm, 20 steps, 1697.70 μm (bottom) and 1727.22 μm (top). For brightfield images, 10x or 20x magnification settings were used on a Zeiss Imager. " ;
    schema1:labEquipment "Nikon Confocal AX, Zeiss AxioImager M2 Microscope" ;
    schema1:measurementTechnique obo:FBbi_00000243,
        obo:FBbi_00000251 ;
    schema1:name "Co-pathology manuscript image acquisition" .

