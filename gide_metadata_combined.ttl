<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2140#5319bcf9-32bd-4f0c-aff5-c39c5b2c24a8> a schema1:LabProtocol ;
    schema1:description "The fixed brain tissue slides were processed immunostaining staining according to standard procedures and imaged withand imaged with ZEISS Axioscan 7 Microscope Slide Scanner equipped with a 20X /0.8 M27 Objective. Select a pre-defined profile FL: fluorescence. Select three channelsfor scanning with LED light source module 385nm, 475nm 567nm. Choose the sample detection mode : manual mode and delineate the sample detection area. Correct focus strategy by adding or removing focus points within the sample detection area. Set 10 layers of Z-stack with 3um interval. Start to automaticly scan the slides." ;
    schema1:labEquipment "ZEISS Axioscan 7 with Axiocam 705 color camera, Plan Apochromat 20X /0.8 M27 Objective. Fluorescence image taken by Axiocam 712 mono camera with Colibri 7 light source and the filter set: 412-438, 501-527, 583-601." ;
    schema1:measurementTechnique obo:FBbi_00000246 ;
    schema1:name "mouse brain section" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2140#5471b2b2-0328-4ebc-9dad-83c0971cf010> a schema1:BioSample ;
    schema1:description "Primary cortical neurons" ;
    schema1:name "Primary Neuron Cultures" ;
    schema1:taxonomicRange obo:NCBITaxon_10116 .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2140#6fad545d-410d-4ce2-91c0-9d157cb62bcc> a schema1:LabProtocol ;
    schema1:description "The fixed brain tissue slides were processed staining according to BaseScope (Advanced Cell Diagnostics) procedures and imaged with ZEISS Axioscan 7 Microscope Slide Scanner equipped with a 20X /0.8 M27 Objective. Select a pre-defined profile BF: brightfield. Choose the sample detection mode : manual mode and delineate the sample detection area. Correct focus strategy by adding or removing focus points within the sample detection area. Start to automaticly scan the slides." ;
    schema1:labEquipment "ZEISS Axioscan 7 with Axiocam 705 color camera, Plan Apochromat 20X /0.8 M27 Objective. Color bright field light source is TL LED lamp." ;
    schema1:measurementTechnique obo:FBbi_00000345 ;
    schema1:name "BaseScope" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2140#ea7116aa-03cb-4333-a6df-06081f491fc5> a schema1:LabProtocol ;
    schema1:description "The fixed cells were processed further for immunostaining according to standard procedures and imaged with a confocal microscope (Zeiss LSM700) equipped with a  40 × water immersion objective (NA1.1; Zeiss). Surface rendering of three-dimensional images was performed using ZEN software (Zeiss) and Imaris software (Bitplane) without Z-correction. Images were analyzed and processed for presentation in figures using brightness and contrast adjustments in ImageJ software (NIH) and following the guidelines of (Rossner and Yamada, 2004)." ;
    schema1:labEquipment "The fixed cells were processed further for immunostaining according to standard procedures and imaged with a confocal microscope (Zeiss LSM700) equipped with a  40 × water immersion objective (NA1.1; Zeiss). " ;
    schema1:measurementTechnique obo:FBbi_00000253 ;
    schema1:name "Fixed primary neurons" .

