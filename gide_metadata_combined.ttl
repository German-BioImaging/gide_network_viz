        "Spindle Apparatus/metabolism[major]" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Artificial kinetochore beads establish a biorientation-like state in the spindle" ;
    schema1:publisher <https://ssbd.riken.jp/repository> ;
    schema1:size <https://ssbd.riken.jp/repository/ssbd-repos-000422/#file-count>,
