<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1426> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000251,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1426#68148636-7a31-41ef-bcd7-9c72c7b55477>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1426#a3a2454d-f9d7-4395-a346-79a33e58b881>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1426#d194a407-4171-479f-af5f-2c6dc128f2b7> ;
    schema1:about obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1426#e0291e34-b5e2-40e3-bffc-ba52c5a5a069> ;
    schema1:author <https://orcid.org/0000-0001-7558-7916>,
        <https://orcid.org/0000-0002-1226-2636>,
        <https://orcid.org/0000-0002-2185-7068>,
