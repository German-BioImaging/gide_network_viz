<https://idr.openmicroscopy.org/study/idr0018/#experiment-protocol-1-1> a schema1:LabProtocol ;
    schema1:description "Protocols used were those of the International Mouse Phenotyping Resource. Gross Pathology and Tissue Collection: https://www.mousephenotype.org/impress/protocol/99/9. Tissue Embedding and Block Banking: https://www.mousephenotype.org/impress/protocol/101/9.Histopathology: https://www.mousephenotype.org/impress/protocol/102/9.  Images are of hematoxylin and eosin(HE) stained paraffin embedded tissue slides." ;
    schema1:measurementTechnique <http://www.ebi.ac.uk/efo/EFO_0003969> ;
    schema1:name "treatment protocol" .

<https://idr.openmicroscopy.org/study/idr0018/#experiment-protocol-1-2> a schema1:LabProtocol ;
    schema1:description "Protocols used were those of the International Mouse Phenotyping Resource. Phenotyping Protocols for Pipeline: TCP Pipeline (Adult, unrestricted): https://www.mousephenotype.org/impress/procedures/9.  Images were manually annotated with Cellular Microscopy Phenotype Ontology terms.  'Repoductive system' in females covers uterus, vagina, cervix, oviduct, ovaries, bladder, in males testis, epididymis, funiculus spermaticus, accessory glands, prostate, bladder, penis." ;
    schema1:name "data analysis protocol" .

