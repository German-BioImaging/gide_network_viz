<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2416> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000253,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2416#11cf1e7c-c530-4cf3-8ea5-43a5d606098b> ;
    schema1:about obo:NCBITaxon_8355,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2416#d46f0768-56a6-4cbf-8a27-d7e5e06061c2> ;
    schema1:author <https://orcid.org/0000-0003-1364-9610> ;
    schema1:datePublished "2025-11-21" ;
    schema1:description """Eukaryotic chromosome segregation requires attachment of chromosomes to microtubules through the kinetochore so that chromosomes can align and move in mitosis. Kinetochores assemble on the centromere which is epigenetically defined by the histone H3 variant CENtromere Protein A (CENP-A). During DNA replication CENP-A is equally divided between replicated chromatids and new CENP-A nucleosomes are re-assembled during the subsequent G1 phase. How cells regulate the cell cycle timing of CENP-A assembly is a central question in the epigenetic maintenance of centromeres. CENP-A nucleosome assembly requires the Mis18 complex (Mis18α, Mis18β, and M18BP1) which is regulated in its localization to centromeres between metaphase and G1. Here, we define a new regulatory mechanism that works through phosphorylation of Xenopus laevis M18BP1 between metaphase and interphase. This switch disrupts binding of M18BP1 to CENP-A nucleosomes in metaphase, and when relieved enables M18BP1 binding to CENP-A nucleosomes in interphase. We show that this phosphorylation dependent mechanism regulates CENP-A nucleosome assembly. We propose that the phospho-regulated binding of M18BP1 to CENP-A nucleosomes restricts new CENP-A assembly to interphase. 
""" ;
    schema1:identifier "S-BIAD2416" ;
    schema1:keywords "CENP-A",
        "centromere" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "Regulation of X. laevis M18BP1 centromeric localization and CENP-A assembly (EMBO Reports)" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2416#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2416#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
    schema1:thumbnailUrl "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD2416/5be71061-f410-4e42-9aba-25df858ca26f/static_display_512_512.png" .

