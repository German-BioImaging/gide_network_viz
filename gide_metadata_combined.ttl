        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1045#c9549043-03af-44fc-a7fd-d3625feb4f51> ;
    schema1:author <https://orcid.org/0000-0001-8189-842X>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1045#00f0b271-48cd-4fca-971a-b8c5f7fd6aa7>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1045#3b955379-5d80-47c2-8a73-d11e3e1bcf7a>,
