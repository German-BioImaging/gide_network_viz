<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1104#f207165d-e9a7-4f71-adfd-39af3ffde905> a schema1:Person ;
    schema1:affiliation <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1104#9f0bf84e-7b5e-40e6-bff9-cc44187a9a59> ;
