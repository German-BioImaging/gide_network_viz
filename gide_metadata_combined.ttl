    schema1:name "Dane Cheasley" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1069#071697d1-273b-456b-9b1e-2b6b109a9b7e> a schema1:LabProtocol ;
    schema1:description "Plates were imaged in widefield mode using the Blue excitation LED (386/23nm) and BGRFRN emission filter. Images were acquired at 10X magnification and 2 x 2 binning (9 fields/well comprising the entire area of the well). Exposure times were calculated to an image saturation target of 35%." ;
    schema1:labEquipment "CellInsight CX7 LED High-Content Screening (HCS) Platform (Thermo Fisher Scientific)" ;
    schema1:measurementTechnique obo:FBbi_00000246 ;
    schema1:name "Image acquisition" .

