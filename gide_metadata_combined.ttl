<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1878#aba3de65-162e-4f9b-bd33-e0512226847c> a schema1:LabProtocol ;
    schema1:description "Imaging was conducted using a Cytation C10 spinning disc confocal microscope (Agilent BioTek) equipped with a 20× objective and a 60 µm pinhole aperture disc. The focal plane was set 50 µm into the hydrogel before capturing 25 z-stacks at 8.4 µm intervals, yielding a total imaging depth of approximately 200 µm. The DAPI laser filter was used to image nuclear stain (DAPI). The TRITC laser filter was used to image F-actin (rhodamine phalloidin). Laser intensity was kept consistent within each condition, but possibly varied between conditions and time points. " ;
    schema1:labEquipment "Cytation C10 spinning disc confocal microscope (Agilent BioTek)" ;
    schema1:measurementTechnique obo:FBbi_00000246,
        obo:FBbi_00000253 ;
    schema1:name "Acquisition 1" .

