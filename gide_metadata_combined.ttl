<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2197#7c12a491-f670-4677-b4ce-1adcec89d6a7> a schema1:LabProtocol ;
    schema1:description "Confocal images were recorded on a Leica SP8 microscope based on an upright DM6 stand using solid state laser excitation at 488 and 638 nm with a Leica DFC365FX with Sony ICX285 interline CCD chip. Hybrid photo detectors with detection bands of 500 - 550 nm and 650 - 700 nm were used. Images were acquired with a 63x1.4 or a 40x PL APO oil immersion objective at a scan speed of 200 or 400 Hz with a pixel size of of 0.075μm and a frame size of 1024 x 1024 (for measuring mitochondrial length) or with a pixel size of 0.4μm and a frame size of 512 x 512 (for determining mitochondrial translocation to the immune synapse). For each image, 3D stacks were recorded (Z-Stack size: 0.3 - 0.5μm). Analysis was performed on projections of the image stacks. For image visualization, Leica Application Suite X (LASX) was used." ;
    schema1:labEquipment "Leica SP8" ;
    schema1:name "Image Aquisition" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2197#8a36d24f-c1c9-4186-a8c4-648f55f182c9> a schema1:BioSample ;
    schema1:description "Human T cells" ;
    schema1:name "T cells before and after major surgery" ;
    schema1:taxonomicRange obo:NCBITaxon_9606 .

