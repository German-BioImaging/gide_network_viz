<https://idr.openmicroscopy.org/study/idr0146/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000369,
        <https://idr.openmicroscopy.org/study/idr0146/#experiment-protocol-1-0>,
        <https://idr.openmicroscopy.org/study/idr0146/#experiment-protocol-1-1>,
        <https://idr.openmicroscopy.org/study/idr0146/#experiment-protocol-1-2>,
        <https://idr.openmicroscopy.org/study/idr0146/#experiment-protocol-1-3>,
        <https://idr.openmicroscopy.org/study/idr0146/#experiment-protocol-1-4> ;
    schema1:about obo:NCBITaxon_10090,
        <https://idr.openmicroscopy.org/study/idr0146/#experiment-biosample-1> ;
    schema1:author <https://orcid.org/0000-0002-0804-7597>,
        <https://orcid.org/0000-0002-1960-7190> ;
    schema1:copyrightNotice "Dominguez et al, CC-BY-4.0, 2023" ;
    schema1:datePublished "2023-02-06" ;
    schema1:description "Using four-dimensional whole-embryo light sheet imaging with improved and accessible computational tools, we longitudinally reconstruct early murine cardiac development at single-cell resolution. Nascent mesoderm progenitors form opposing density and motility gradients, converting the temporal birth sequence of gastrulation into a spatial anterolateral-to-posteromedial arrangement. Migrating precardiac mesoderm doesn’t strictly preserve cellular neighbor relationships; spatial patterns only become solidified as the cardiac crescent emerges. Progenitors undergo a heretofore unknown mesenchymal-to-epithelial transition, with an anchored first heart field (FHF) ridge apposing a motile juxtacardiac field (JCF). The nascent heart tube forms as the JCF rotates forward, due to push-pull morphodynamics of the second heart field transmitted through the FHF epithelium. In Mesp1 mutants that fail to make a cardiac crescent, mesoderm remains highly motile but directionally incoherent, resulting in density gradient inversion. Our practicable live embryo imaging approach defines spatial origins and behaviors of cardiac progenitors, and identifies their unanticipated morphological transitions." ;
    schema1:identifier "idr0146" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Time lapse imaging of mesoderm and early cardiac progenitors in mouse embryos" ;
    schema1:publisher <https://idr.openmicroscopy.org/> ;
    schema1:thumbnailUrl "https://idr.openmicroscopy.org/webgateway/render_thumbnail/14788631/" ;
    rdfs:seeAlso <https://doi.org/10.1016/j.cell.2023.01.001> .

