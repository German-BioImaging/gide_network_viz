<https://idr.openmicroscopy.org/study/idr0005/#screen-biosample-1> a schema1:BioSample ;
    schema1:description "A genome-wide RNAi screen for loss of DE- cadherin-mediated, Ca2+-dependent cell-cell adhesion in DECAD-S2 cells . This initial screen yielded 1,201 RNAi's that produced defective cell-cell aggregation in DECAD-S2 cells." ;
    schema1:name "cell" ;
    schema1:taxonomicRange obo:NCBITaxon_7227 .

<https://idr.openmicroscopy.org/study/idr0005/#screen-biosample-2> a schema1:BioSample ;
    schema1:description "Re-screen of 803 hits from the first screen, using RNAis to regions of the genes that were different from those targeted by RNAi in the first screen.  Some hits from the primary screen where not investigated further due to their likely involvement in generic protein expression pathways, the genes were obsolete or because it was not possible to design nonoverlapping RNAis." ;
    schema1:name "cell" ;
    schema1:taxonomicRange obo:NCBITaxon_7227 .

<https://idr.openmicroscopy.org/study/idr0005/#screen-protocol-1-0> a schema1:LabProtocol ;
    schema1:description "A genome-wide RNAi screen for loss of DE- cadherin-mediated, Ca2+-dependent cell-cell adhesion in DECAD-S2 cells . This initial screen yielded 1,201 RNAi's that produced defective cell-cell aggregation in DECAD-S2 cells." ;
    schema1:measurementTechnique obo:FBbi_00000246 ;
    schema1:name "fluorescence microscopy" .

<https://idr.openmicroscopy.org/study/idr0005/#screen-protocol-1-1> a schema1:LabProtocol ;
    schema1:description "Drosophila S2U cells were maintained in Schneider's medium (Invitro- gen) supplemented with 10% heat-inactivated fetal bovine serum (Sigma- Aldrich), penicillin, streptomycin, and kanamycin (Goshima et al., 2007). Full-length DE-cadherin was cloned into pAc5.1/V5 His B (Invitrogen) and cotransfected with blasticidin and hygromycin plasmids in S2U cells to generate stable expression lines (Millar et al., 1994). For RNAi treatment, DE-cadherin-expressing S2 cells were treated with 625 _g/ml trypsin for 20 min at 25C and then resuspended in serum-free Schneider's medium. 1 ug RNA was incubated with 6 x 105 cells for 30 min in serum-free Schneider's medium followed by a 5-d recovery in Schneider's medium supplemented with 20% heat-inactivated fetal bovine serum (Goshima et al., 2007). RNAi-treated cells were maintained in plasticware coated with a 10% Pluronic 127 (Sigma-Aldrich) solution to minimize cell-substrate interactions. After 5 d of RNAi treatment, 1 _g/ml Hoechst 33342 (Thermo Fisher Sci- entific) was added to each well. 96-well plates were shaken for 5 min at 800 rpm on a vortex mixer (MixMate; Eppendorf). 96-well plates were then placed on a platform that rotated around a 3-cm radius (D. Proffit, Molecular and Cellular Physiology, Stanford Institute for Neuro-Innovation and Translational Neuroscience Engineering Shop, Stanford School of Medicine, Stanford, CA) for 20 min at 250 rpm and were next shaken for 30 s at 650 rpm on a MixMate." ;
    schema1:measurementTechnique <http://www.ebi.ac.uk/efo/EFO_0003789> ;
    schema1:name "growth protocol" .

<https://idr.openmicroscopy.org/study/idr0005/#screen-protocol-1-2> a schema1:LabProtocol ;
    schema1:description "The initial genome-wide screen used the V2 RNAi library (Thermo Fisher Scientific; Goshima et al., 2007)." ;
    schema1:measurementTechnique <http://www.ebi.ac.uk/efo/EFO_0007571> ;
    schema1:name "HCS library protocol" .

<https://idr.openmicroscopy.org/study/idr0005/#screen-protocol-1-3> a schema1:LabProtocol ;
    schema1:description "Plates were imaged using an automated microscope (ImageXpress Micro; Molecular Devices) with a 4_ objective. Images were acquired with MetaMorph (Molecular Devices) and a camera (CoolSNAP HQ; Photometrics)." ;
    schema1:measurementTechnique <http://www.ebi.ac.uk/efo/EFO_0007572> ;
    schema1:name "HCS image acquistion and feature extraction protocol" .

<https://idr.openmicroscopy.org/study/idr0005/#screen-protocol-1-4> a schema1:LabProtocol ;
    schema1:description "For scoring, three images/well were ranked by eye based on aggregation (0 = strong aggregation; 4 = no ag- gregation). A score of >1.5 was considered defective aggregation." ;
    schema1:measurementTechnique <http://www.ebi.ac.uk/efo/EFO_0007573> ;
    schema1:name "HCS data analysis protocol" .

<https://idr.openmicroscopy.org/study/idr0005/#screen-protocol-2-0> a schema1:LabProtocol ;
    schema1:description "Re-screen of 803 hits from the first screen, using RNAis to regions of the genes that were different from those targeted by RNAi in the first screen.  Some hits from the primary screen where not investigated further due to their likely involvement in generic protein expression pathways, the genes were obsolete or because it was not possible to design nonoverlapping RNAis." ;
    schema1:measurementTechnique obo:FBbi_00000246 ;
    schema1:name "fluorescence microscopy" .

<https://idr.openmicroscopy.org/study/idr0005/#screen-protocol-2-1> a schema1:LabProtocol ;
    schema1:description "Drosophila S2U cells were maintained in Schneider's medium (Invitro- gen) supplemented with 10% heat-inactivated fetal bovine serum (Sigma- Aldrich), penicillin, streptomycin, and kanamycin (Goshima et al., 2007). Full-length DE-cadherin was cloned into pAc5.1/V5 His B (Invitrogen) and cotransfected with blasticidin and hygromycin plasmids in S2U cells to generate stable expression lines (Millar et al., 1994). For RNAi treatment, DE-cadherin-expressing S2 cells were treated with 625 _g/ml trypsin for 20 min at 25C and then resuspended in serum-free Schneider's medium. 1 ug RNA was incubated with 6 x 105 cells for 30 min in serum-free Schneider's medium followed by a 5-d recovery in Schneider's medium supplemented with 20% heat-inactivated fetal bovine serum (Goshima et al., 2007). RNAi-treated cells were maintained in plasticware coated with a 10% Pluronic 127 (Sigma-Aldrich) solution to minimize cell-substrate interactions. After 5 d of RNAi treatment, 1 ug/ml Hoechst 33342 (Thermo Fisher Sci- entific) was added to each well. 96-well plates were shaken for 5 min at 800 rpm on a vortex mixer (MixMate; Eppendorf). 96-well plates were then placed on a platform that rotated around a 3-cm radius (D. Proffit, Molecular and Cellular Physiology, Stanford Institute for Neuro-Innovation and Translational Neuroscience Engineering Shop, Stanford School of Medicine, Stanford, CA) for 20 min at 250 rpm and were next shaken for 30 s at 650 rpm on a MixMate." ;
    schema1:measurementTechnique <http://www.ebi.ac.uk/efo/EFO_0003789> ;
    schema1:name "growth protocol" .

<https://idr.openmicroscopy.org/study/idr0005/#screen-protocol-2-2> a schema1:LabProtocol ;
    schema1:description "Nonoverlapping RNAis that were 100- 800 bp in length and minimized repeated sequences were generated for rescreening DECAD-S2 cells (Goshima et al., 2007)." ;
    schema1:name "library selection protocol" .

<https://idr.openmicroscopy.org/study/idr0005/#screen-protocol-2-3> a schema1:LabProtocol ;
    schema1:description "Plates were imaged using an automated microscope (ImageXpress Micro; Molecular Devices) with a 4_ objective. Images were acquired with MetaMorph (Molecular Devices) and a camera (CoolSNAP HQ; Photometrics)." ;
    schema1:name "image aquistion and feature extraction protocol" .

<https://idr.openmicroscopy.org/study/idr0005/#screen-protocol-2-4> a schema1:LabProtocol ;
    schema1:description "For scoring, three images/well were ranked by eye based on aggregation (0 = strong aggregation; 4 = no ag- gregation). A score of >1.5 was considered defective aggregation." ;
    schema1:name "hit detection protocol" .

