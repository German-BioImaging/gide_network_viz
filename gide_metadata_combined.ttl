<https://idr.openmicroscopy.org/study/idr0111/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000247,
        <https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-1-0>,
        <https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-1-1>,
        <https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-1-2>,
        <https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-1-3>,
        <https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-1-4>,
        <https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-2-0>,
        <https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-2-1>,
        <https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-2-2>,
        <https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-2-3>,
        <https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-2-4> ;
    schema1:about obo:NCBITaxon_9606,
        <https://idr.openmicroscopy.org/study/idr0111/#experiment-biosample-1>,
        <https://idr.openmicroscopy.org/study/idr0111/#experiment-biosample-2> ;
    schema1:author <https://orcid.org/0000-0001-9359-0422>,
        <https://orcid.org/0000-0002-4378-4381> ;
    schema1:copyrightNotice "Lee et al, CC-BY-4.0, 2021" ;
    schema1:datePublished "2021-06-30" ;
    schema1:description "Recent evidence suggests that groups of cells are more likely to form clinically dangerous metastatic tumors, emphasizing the importance of understanding mechanisms underlying collective behavior. The emergent collective behavior of migrating cell sheets in vitro has been shown to be disrupted in tumorigenic cells but the connection between this behavior and in vivo tumorigenicity remains unclear. We use particle image velocimetry to measure a multidimensional migration phenotype for genetically defined human breast epithelial cell lines that range in their in vivo behavior from non-tumorigenic to aggressively metastatic. By using cells with controlled mutations, we show that PTEN deletion enhances collective migration, while Ras activation suppresses it, even when combined with PTEN deletion. These opposing effects on collective migration of two mutations that are frequently found in patient tumors could be exploited in the development of novel treatments for metastatic disease. Our methods are based on label-free phase contrast imaging, and thus could easily be applied to patient tumor cells. The short time scales of our approach do not require potentially selective growth, and thus in combination with label-free imaging would allow multidimensional collective migration phenotypes to be utilized in clinical assessments of metastatic potential." ;
    schema1:identifier "idr0111" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Distinct Roles of Tumor Associated Mutations in Collective Cell Migration" ;
    schema1:publisher <https://idr.openmicroscopy.org/> ;
    schema1:size <https://idr.openmicroscopy.org/study/idr0111/#file-count>,
        <https://idr.openmicroscopy.org/study/idr0111/#total-dataset-size> ;
    schema1:thumbnailUrl "https://idr.openmicroscopy.org/webgateway/render_thumbnail/13416991/" ;
    rdfs:seeAlso <https://doi.org/10.1038/s41598-021-89130-6> .

<https://idr.openmicroscopy.org/study/idr0111/#experiment-biosample-1> a schema1:BioSample ;
    schema1:description "MCF10A, PTEN-/-, KRas, and KRas/PTEN-/- cell lines or the MCF10A and MDA-MB-231 cell lines were plated in a collective migration assay that uses circular cell sheets.  Tiled images of each full cell sheet were taken before and after a set of time lapse images was taken of two ROIs in each cell sheet." ;
    schema1:name "cell" ;
    schema1:taxonomicRange obo:NCBITaxon_9606 .

<https://idr.openmicroscopy.org/study/idr0111/#experiment-biosample-2> a schema1:BioSample ;
    schema1:description "MCF10A, PTEN-/-, KRas, and KRas/PTEN-/- cell lines were plated in a collective migration assay that uses circular cell sheets.  Duplicates plates were used to create fixed samples at t=0 (plate 1) and t=15 h (plate 2).  The fixed samples were stained with DAPI." ;
    schema1:name "cell" ;
    schema1:taxonomicRange obo:NCBITaxon_9606 .

<https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-1-0> a schema1:LabProtocol ;
    schema1:description "MCF10A, PTEN-/-, KRas, and KRas/PTEN-/- cell lines or the MCF10A and MDA-MB-231 cell lines were plated in a collective migration assay that uses circular cell sheets.  Tiled images of each full cell sheet were taken before and after a set of time lapse images was taken of two ROIs in each cell sheet." ;
    schema1:measurementTechnique obo:FBbi_00000247 ;
    schema1:name "phase contrast microscopy" .

<https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-1-1> a schema1:LabProtocol ;
    schema1:description "For comparisons between the MCF10A, PTEN-/-, KRas, and KRas/PTEN-/- cell lines, the cells were were maintained in DMEM/F12 medium with 5% horse serum, 10 µg/ml insulin, 10 ng/ml EGF, 0.5 µg/ml hydrocortison, 100 ng/ml cholera toxin and 0.5 µg/ml puromycin at 37 C and 5% CO2.  For comparisons between the MCF10A and MDA-MB-231 cell lines, the MCF10A were mainted in DMEM/F12 medium with 5% horse serum, 10 µg/ml insulin, 10 ng/ml EGF, 0.5 µg/ml hydrocortison, and 100 ng/ml cholera toxin. MDA-MB-231 cells were maintained in DMEM with 10% fetal bovine serum." ;
    schema1:measurementTechnique <http://www.ebi.ac.uk/efo/EFO_0003789> ;
    schema1:name "growth protocol" .

<https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-1-2> a schema1:LabProtocol ;
    schema1:description "Cells were plated as a circular monolayer on collagen IV coated (3.25 µg/cm^2) glass coverslips in a 12 well plate.  Cells were allowed to adhere overnight before imaging.  Additional details are available in the study publication." ;
    schema1:measurementTechnique <http://www.ebi.ac.uk/efo/EFO_0003969> ;
    schema1:name "treatment protocol" .

<https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-1-3> a schema1:LabProtocol ;
    schema1:description "Cells were imaged overnight on a PerkinElmer UltraView VoX spinning-disk confocal microscope. Before time-lapse imaging, a single snapshot of the entire cell sheet was recorded by tiling multiple phase contrast images. A motorized x-y stage and Nikon Perfect Focus System were used to acquire images at multiple positions over time. The microscope was equipped with a Tokai Hit environmental chamber with a humidity reservoir and was set to 37 °C and 5% CO2. Images were taken using a 10× phase-contrast objective (Nikon CFl Plan Fluor, NA 0.3). Images were collected using PerkinElmer’s Volocity software (version 6.4.0) with a Hamamatsu C10600-10B ORCA-R2 camera that recorded 12-bit images (1024 pixels × 1344 pixels, 0.582 µm/pixel). Images were recorded every 3 min for 12 h." ;
    schema1:name "image acquisition and feature extraction protocol" .

<https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-1-4> a schema1:LabProtocol ;
    schema1:description "Images were analyzed using the workflow described at https://github.com/ScientistRachel/multiScalePIVanalysis" ;
    schema1:name "data analysis protocol" .

<https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-2-0> a schema1:LabProtocol ;
    schema1:description "MCF10A, PTEN-/-, KRas, and KRas/PTEN-/- cell lines were plated in a collective migration assay that uses circular cell sheets.  Duplicates plates were used to create fixed samples at t=0 (plate 1) and t=15 h (plate 2).  The fixed samples were stained with DAPI." ;
    schema1:measurementTechnique obo:FBbi_00000247 ;
    schema1:name "phase contrast microscopy" .

<https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-2-1> a schema1:LabProtocol ;
    schema1:description "Cells were maintained in DMEM/F12 medium with 5% horse serum, 10 µg/ml insulin, 10 ng/ml EGF, 0.5 µg/ml hydrocortison, 100 ng/ml cholera toxin and 0.5 µg/ml puromycin at 37 C and 5% CO2." ;
    schema1:measurementTechnique <http://www.ebi.ac.uk/efo/EFO_0003789> ;
    schema1:name "growth protocol" .

<https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-2-2> a schema1:LabProtocol ;
    schema1:description "Cells were plated as a circular monolayer on collagen IV coated (3.25 µg/cm^2) glass coverslips in a 12 well plate.  Cells were allowed to adhere overnight before imaging.  Additional details are available in the study publication." ;
    schema1:measurementTechnique <http://www.ebi.ac.uk/efo/EFO_0003969> ;
    schema1:name "treatment protocol" .

<https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-2-3> a schema1:LabProtocol ;
    schema1:description "Cells were imaged on a PerkinElmer UltraView VoX spinning-disk confocal microscope. A single snapshot of the entire cell sheet was recorded by tiling multiple images of both phase contrast and 405 nm imaging (for the DAPI stain). Images were taken using a 10× phase-contrast objective (Nikon CFl Plan Fluor, NA 0.3). Images were collected using PerkinElmer’s Volocity software (version 6.4.0) with a Hamamatsu C10600-10B ORCA-R2 camera that recorded 12-bit images (1024 pixels × 1344 pixels, 0.582 µm/pixel)." ;
    schema1:name "image acquisition and feature extraction protocol" .

<https://idr.openmicroscopy.org/study/idr0111/#experiment-protocol-2-4> a schema1:LabProtocol ;
    schema1:description "Nuclei were found and counted using functions from the Crocker-Grier tracking algorithm, available at http://site.physics.georgetown.edu/matlab/code.html" ;
    schema1:name "data analysis protocol" .

