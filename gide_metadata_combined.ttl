<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2229> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000243,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2229#0e86d9fd-4727-4f47-8189-d3db3001bc9c> ;
    schema1:about obo:NCBITaxon_4932,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2229#b25d3e17-7a0a-406d-a5ac-bd39a1f4b38f> ;
    schema1:author <https://orcid.org/0000-0003-1283-2130> ;
    schema1:datePublished "2025-08-08" ;
    schema1:description "The fast emergence of multi-resistant pathogenic yeasts is caused by the extensive—and sometimes unnecessary—use of broad-spectrum antimicrobial drugs. To rationalise the use of broad-spectrum antifungals, it is essential to have a rapid and sensitive system to identify the most appropriate drug. Here, we developed a microfluidic chip to apply the recently developed optical nanomotion detection (ONMD) method as a rapid antifungal susceptibility test. The microfluidic chip contains no-flow yeast imaging chambers in which the growth medium can be replaced by an antifungal solution without disturbing the nanomotion of the cells in the imaging chamber. This allows for recording the cellular nanomotion of the same cells at regular time intervals of a few minutes before and throughout the treatment with an antifungal. Hence, the real-time response of individual cells to a killing compound can be quantified. In this way, this killing rate provides a new measure to rapidly assess the susceptibility of a specific antifungal. It also permits the determination of the ratio of antifungal resistant versus sensitive cells in a population." ;
    schema1:identifier "S-BIAD2229" ;
    schema1:keywords " cellular nanomotion",
        " optical nanomotion detection ",
        "Saccharomyces cerevisiae",
        "antifungal",
        "microfluidic chip",
        "no-flow chamber",
        "single cell",
        "yeast " ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "The Dynamics of Single-Cell Nanomotion Behaviour of Saccharomyces cerevisiae in a Microfluidic Chip for Rapid Antifungal Susceptibility Testing" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2229#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2229#480bb0bc-db43-46e5-88ae-071380b9d63c> .

