<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1077> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000345,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1077#07f742d0-243a-4a8d-bca3-c91d050ef394> ;
    schema1:about obo:NCBITaxon_10090,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1077#d6f7bf1a-6550-426a-bdb3-76bd3db193d4> ;
    schema1:author <https://orcid.org/0000-0001-8772-0294>,
        <https://orcid.org/0000-0002-2023-1207>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1077#029c1e31-d643-4192-a6d7-1b0b6932d95e>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1077#4c146eba-5efc-42d9-adcc-ad0394982765>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1077#c531197d-a59c-4158-8ddf-50a33cc90f11>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1077#d232b551-dfeb-485d-bc76-b6880d44325b> ;
    schema1:datePublished "2024-03-13" ;
    schema1:description """With this dataset, we present light sheet microscopical datasets of iDISCO+ cleared adult mouse auditory and visual cortex. They feature an immunohistochemical staining of neuronal cell bodies (HuC/HuD), cell nuclei (TO-PRO-3), myelinated neurites (Myelin Basic Protein), and an autofluorescence channel. For all channels, we provide cell-level datasets including sensory cortical areas on cellular level (0.54 x 0.54 x 4µm XYZ). The data provide insight into cell distribution, cell densities and fibre directions in the neocortex.
""" ;
    schema1:identifier "S-BIAD1077" ;
    schema1:keywords "Clearing",
        "Light sheet Fluorescence Microscopy",
        "auditory",
        "cortex",
        "idisco",
        "visual" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Cell-Level 3D data of Auditory Cortex of adult mice: Neurons, nuclei, myelination imaged with light sheet microscopy" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1077#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1077#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
    schema1:thumbnailUrl "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD1077/4a65738d-8774-48d7-8786-53f6eb104b33/103bcf3a-8af6-4951-811c-9760c11d7872.png" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1077#029c1e31-d643-4192-a6d7-1b0b6932d95e> a schema1:Person ;
    schema1:affiliation <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1077#0de67ad0-191f-4795-bba3-7e2f37e86695> ;
    schema1:name "Nico Scherf" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1077#07f742d0-243a-4a8d-bca3-c91d050ef394> a schema1:LabProtocol ;
    schema1:description """The data were acquired with a Lavision Biotec Ultramicroscope II with a Neo 5.5 sCMOS camera, with BABB as imaging medium and a MI Plan 12x objective (NA=0.53, voxel size 0.54 x 0.54 x 4 µm XYZ). Image data were acquired in a 2x3 stack mosaic acquisition, including primary auditory and primary visual cortex and surrounding areas. Light sheet NA was set to 0.165 (minimum sheet thickness 3.4µm), with a sheet width of 40% (~1.2cm) and an exposure time of 97 ms. Laser power for the respective lasers were set to 7.5mW (488nm), 22.5mW (555nm), 3.25mW (640nm), 75mW (785nm). To minimize a potential bias from the optical system, all samples but one were scanned with light sheets from the right side. 
""" ;
    schema1:labEquipment "Miltenyi UltraII LSFM." ;
    schema1:measurementTechnique obo:FBbi_00000345 ;
    schema1:name "Light Sheet Fluorescence Microscopy" .

