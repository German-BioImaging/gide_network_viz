<https://idr.openmicroscopy.org/study/idr0118/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000369,
        <https://idr.openmicroscopy.org/study/idr0118/#experiment-protocol-1-0>,
        <https://idr.openmicroscopy.org/study/idr0118/#experiment-protocol-1-1>,
        <https://idr.openmicroscopy.org/study/idr0118/#experiment-protocol-1-2>,
        <https://idr.openmicroscopy.org/study/idr0118/#experiment-protocol-1-3>,
        <https://idr.openmicroscopy.org/study/idr0118/#experiment-protocol-1-4> ;
    schema1:about obo:NCBITaxon_7227,
        <https://idr.openmicroscopy.org/study/idr0118/#experiment-biosample-1> ;
    schema1:author <https://orcid.org/0000-0002-9152-9334> ;
    schema1:copyrightNotice "Keenan et al, CC-BY-4.0, 2021" ;
    schema1:datePublished "2021-11-10" ;
    schema1:description "During early Drosophila embryogenesis, a network of gene regulatory interactions orchestrates terminal patterning, playing a critical role in the subsequent formation of the gut. We utilized CRISPR gene editing at endogenous loci to create live reporters of transcription and light-sheet microscopy to monitor the individual components of posterior patterning network across 90 minutes prior to gastrulation. We developed a computational pipeline for fusing imaging datasets of the individual components into a common multivariable trajectory. This heterogeneous data fusion approach revealed low intrinsic dimensionality of posterior patterning and cell fate specification in wild type embryos." ;
    schema1:identifier "idr0118" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Dynamics of Drosophila endoderm specification" ;
    schema1:publisher <https://idr.openmicroscopy.org/> ;
    schema1:size <https://idr.openmicroscopy.org/study/idr0118/#file-count> ;
    schema1:thumbnailUrl "https://idr.openmicroscopy.org/webgateway/render_thumbnail/13461595/" ;
    rdfs:seeAlso <https://doi.org/10.1073/pnas.2112892119> .

<https://idr.openmicroscopy.org/study/idr0118/#experiment-biosample-1> a schema1:BioSample ;
    schema1:description "Time-lapse microscopy was performed on Drosophila embryos containing an endogenous transcriptional reporter for the genes tailless (tll), huckebein (hkb), brachyenteron (byn), forkhead (fkh), and wingless (wg) using a light-sheet microscope.  Images were taken once every minute from the start of nuclear cycle 11 to the start of gastrulation (approximately 90 minutes total) in order to track transcription of genes in individual nuclei in the posterior third of the embryo." ;
    schema1:name "tissue" ;
    schema1:taxonomicRange obo:NCBITaxon_7227 .

<https://idr.openmicroscopy.org/study/idr0118/#experiment-protocol-1-0> a schema1:LabProtocol ;
    schema1:description "Time-lapse microscopy was performed on Drosophila embryos containing an endogenous transcriptional reporter for the genes tailless (tll), huckebein (hkb), brachyenteron (byn), forkhead (fkh), and wingless (wg) using a light-sheet microscope.  Images were taken once every minute from the start of nuclear cycle 11 to the start of gastrulation (approximately 90 minutes total) in order to track transcription of genes in individual nuclei in the posterior third of the embryo." ;
    schema1:measurementTechnique obo:FBbi_00000369 ;
    schema1:name "light sheet fluorescence microscopy" .

<https://idr.openmicroscopy.org/study/idr0118/#experiment-protocol-1-1> a schema1:LabProtocol ;
    schema1:description "Virgin females maternally expressing Histone-GFP and MCP-mCherry (genotype: +;+;His-GFP/MCP-mCherry) were crossed to males with one of the endogenous transcriptional reporters (genotypes: +;+;tll-ms2/tll-ms2, +;+;hkb-ms2/hkb-ms2, +;+;byn-ms2/byn-ms2, +;+;fkh-ms2/fkh-ms2, or +;wg-ms2/wg-ms2;tll-ms2/+). An embryo from this cross was used in this experiment." ;
    schema1:measurementTechnique <http://www.ebi.ac.uk/efo/EFO_0003789> ;
    schema1:name "growth protocol" .

<https://idr.openmicroscopy.org/study/idr0118/#experiment-protocol-1-2> a schema1:LabProtocol ;
    schema1:description "No treatment was performed on embryos" ;
    schema1:measurementTechnique <http://www.ebi.ac.uk/efo/EFO_0003969> ;
    schema1:name "treatment protocol" .

<https://idr.openmicroscopy.org/study/idr0118/#experiment-protocol-1-3> a schema1:LabProtocol ;
    schema1:description "Embryos were imaged on a Luxendo MuVi SPIM light-sheet microscope, using 30x magnification setting on the Nikon 10x/0.3 water objective.  The 488 nm laser was used to image nuclei (His-GFP), and the 561 nm laser was used to image transcriptional dots (MCP-mCherry),  both at 5% laser power. Exposure time for the green channel was 55 ms and exposure for the red channel was 70 ms.  The line illumination tool was used to improve background levels and was set to 40 pixels. Image segmentation was performed for each 2D slice using a program called ilastik, which utilizes semantic segmentation. 3D object creation from 2D binary images and feature extraction was performed in a program called Arivis." ;
    schema1:name "image acquisition and feature extraction protocol" .

