<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#1f0e3a6a-235a-4f1b-b4c3-c5daa6fcddb8> a schema1:LabProtocol ;
    schema1:description "sfGFP fluorescence lifetime was measured at 920 nm wavelength and the filters suitable for GFP. Each measurement was acquired for 40-120 sec with laser intensities adjusted to achieve Constant Fraction Discriminator (CFD) rate between 5x10^5 and 1x10^6 events per second, with time resolution of 256 time-channels and spatial resolution of 512x512 or 256x256 pixels. The duration of acquisition and resolution were kept constant among all samples of the same experiment." ;
    schema1:labEquipment "SPC-150 Time-Correlated Single Photon Counter (TCSPC) module (Becker&Hickl) attached to LSM 710 microscope (Zeiss) equipped with 2-photon Chameleon laser with pulse repetition rate 80 MHz (Coherent) and HPM-100-40GaAsP detector that feeds to TCSPC module. " ;
    schema1:measurementTechnique obo:FBbi_00000368 ;
    schema1:name "2-photon FLIM" .

