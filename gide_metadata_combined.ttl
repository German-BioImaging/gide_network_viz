<https://www.ebi.ac.uk/biostudies/bioimages/studies/EMPIAR-10819#aab97ba1-f73c-49ab-810e-768f0efc4005> a schema1:BioSample ;
    schema1:description "Human cervical cancer epithelial cells (HeLa) obtained from the Cell Services Science Technology Platform at The Francis Crick Institute, originated from the American Type Culture Collection (ATCC; CCL-2)" ;
    schema1:name "HeLa cells" ;
    schema1:taxonomicRange obo:NCBITaxon_9606 .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/EMPIAR-10819#df3681d4-5f9f-4649-bb53-d581abb73f63> a schema1:LabProtocol ;
    schema1:description "Cells were first mapped with a 10x objective (NA 0.3) using brightfield microscopy to determine their position on the grid and tile scans were generated. The cells of interest were then imaged at high resolution in Airyscan mode with a 63x oil objective (NA 1.4). Smart setup was used to set up the imaging conditions. A sequential scan of each channel was used to limit crosstalk and z-stacks were acquired throughout the whole volume of the cells. For FIB-SEM, images were acquired at 5 nm isotropic resolution throughout the cell of interest, using a 6 µs dwell time. During acquisition, the SEM was operated at an accelerating voltage of 1.5 kV with 1.5 nA current. The EsB detector was used with a grid voltage of 1.2 kV. Ion beam milling was performed at an accelerating voltage of 30 kV and a current of 700 pA." ;
    schema1:labEquipment "Zeiss AxioObserver 7 LSM900 with Airyscan 2 microscope, Crossbeam 540 FIB-SEM" ;
    schema1:measurementTechnique obo:FBbi_00000251,
        obo:FBbi_00050000 ;
    schema1:name "CLEM imaging with Airyscan and FIB-SEM" .

