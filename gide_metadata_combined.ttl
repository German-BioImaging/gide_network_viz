<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2091#97f95637-274b-4aa8-ba3b-94ee378fb81f> a schema1:BioSample ;
    schema1:description "Human cell lines Huh7 (hepatocellular carcinoma), AC16 (human cardiomyocyte), and Mel624 (melanoma)" ;
