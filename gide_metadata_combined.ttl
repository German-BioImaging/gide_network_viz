        "Phosphatidylinositol 4,5-Diphosphate/metabolism[major]",
        "Phospholipase C gamma/metabolism",
        "Phosphorylation",
        "Single Molecule Imaging/methods" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "TIRF imaging of EGFR and PIP2 on Hela cells" ;
