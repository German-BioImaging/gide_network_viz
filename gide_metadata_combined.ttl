        obo:FBbi_00000251,
        obo:FBbi_00000345,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1704#ac6d5891-1667-43f4-9413-507b1747d0c5> ;
    schema1:about obo:NCBITaxon_10090,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1704#67780abb-220d-4b13-a380-cf60c6cb5ae2> ;
    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1704#5879ec8a-e73e-4c05-a9d1-e7865217783e>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1704#a1170750-be92-453e-a433-b0d7c12640b7> ;
    schema1:datePublished "2025-03-26" ;
    schema1:description "Fibrosis is a key feature of a broad spectrum of cystic kidney diseases, especially autosomal recessive kidney disorders such as nephronophthisis (NPHP). However, its contribution to kidney function decline and the underlying molecular mechanism(s) remains unclear. Here, we show that kidney-specific deletion of Fbxw7, the recognition receptor of the SCFFBW7 E3 ubiquitin ligase, results in a juvenile-adult NPHP-like pathology characterized by slow-progressing corticomedullary cysts, tubular degeneration, severe fibrosis, and gradual loss of kidney function. Expression levels of SOX9, a known substrate of FBW7, and WNT4, a potent pro-fibrotic factor and downstream effector of SOX9, were elevated upon loss of FBW7. Heterozygous deletion of Sox9 in compound mutant mice led to the normalization of WNT4 levels, reduced fibrosis, and preservation of kidney function without significant effects on cystic dilatation and tubular degeneration. These data suggest that FBW7-SOX9-WNT4-induced fibrosis drives kidney function decline in NPHP and, possibly, other forms of autosomal recessive kidney disorders.    " ;
    schema1:identifier "S-BIAD1704" ;
    schema1:keywords "FBW7",
        "Fibrosis",
        "Nephronophthisis",
        "SOX9",
        "kidney function" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "SOX9-dependent fibrosis drives renal function in nephronophthisis" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1704#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1704#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
