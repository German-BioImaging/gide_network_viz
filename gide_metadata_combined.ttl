<https://idr.openmicroscopy.org/study/idr0003/#person-1> a schema1:Person ;
    schema1:address "Department of Molecular Genetics, Weizmann Institute of Science, Rehovot 7610001, Israel." ;
    schema1:email "michalbreker@gmail.com" ;
