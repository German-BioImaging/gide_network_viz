<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2070> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000251,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2070#667614cf-b1a5-4e53-afc3-98ebc97ff45c> ;
    schema1:about obo:NCBITaxon_10090,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2070#73a188aa-2a20-426f-a58d-aab577fbcc06> ;
    schema1:author <https://orcid.org/0000-0001-5666-5173>,
        <https://orcid.org/0000-0002-2569-4200> ;
    schema1:datePublished "2025-08-29" ;
    schema1:description "Single cell profiling studies and research on both postmortem Parkinson’s disease (PD) tissues and preclinical mouse models demonstrated that the Sox6/Aldh1a1 markers molecularly define the vulnerable ventral dopamine neurons, while Calbindin1 (Calb1) marks the resilient dorsal neurons.  These distinct dopamine neuronal subtypes not only differ in their molecular profiling but also exhibit unique projection patterns and functional responses. Therefore, studying these neurons in a subtype-specific manner can yield important insights into cell-intrinsic mechanisms of vulnerability in PD. We first addressed whether LRRK2 is expressed in dopamine neurons, as this is a prerequisite for any cell-autonomous effects. We performed immunolabeling on mouse brain sections and confirmed LRRK2 expression in SNc dopamine neurons" ;
    schema1:identifier "S-BIAD2070" ;
    schema1:keywords "LRRK2 ",
        "Parkinson’s disease ",
        "dopamine neurons" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "LRRK2 is expressed in dopamine neurons and is enriched in the vulnerable subpopulation." ;
