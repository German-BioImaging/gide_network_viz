    schema1:value 6 .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2324#276212e5-aa84-482d-a1f6-243eb5826628> a schema1:LabProtocol ;
    schema1:description "Tissues samples underwent standard chemical H&E staining using standard histopathology protocols. Stained slides were digitized at 40× magnification using a transmission brightfield slide scanner (Morpholens 1; Morphle Digital Pathology, New York, NY, USA). This produced high-resolution images of the chemically stained tissue to serve as ground truth for both training and validation." ;
    schema1:labEquipment "Morpholens 1,Morphle Digital Pathology" ;
    schema1:measurementTechnique obo:FBbi_00000243 ;
    schema1:name "Chemical H&E Image" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2324#480bb0bc-db43-46e5-88ae-071380b9d63c> a <https://www.ebi.ac.uk/biostudies/bioimages/studies/QuantitiveValue> ;
