<https://ssbd.riken.jp/repository/ssbd-repos-000397/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000284,
        obo:FBbi_00000383,
        <https://ssbd.riken.jp/repository/ssbd-repos-000397/#imaging-protocol-1>,
        <https://ssbd.riken.jp/repository/ssbd-repos-000397/#imaging-protocol-2>,
        <https://ssbd.riken.jp/repository/ssbd-repos-000397/#imaging-protocol-3>,
        <https://ssbd.riken.jp/repository/ssbd-repos-000397/#imaging-protocol-4>,
        <https://ssbd.riken.jp/repository/ssbd-repos-000397/#imaging-technique-1>,
        <https://ssbd.riken.jp/repository/ssbd-repos-000397/#imaging-technique-3> ;
    schema1:about obo:GO_0014042,
        obo:GO_0060156,
        obo:NCBITaxon_10090,
        <https://ssbd.riken.jp/repository/ssbd-repos-000397/#biosample-1> ;
    schema1:author <https://ssbd.riken.jp/repository/ssbd-repos-000397/#auth-001> ;
    schema1:datePublished "2024-12-17" ;
    schema1:description "Oxytocin (OT) neurons in the hypothalamic paraventricular nucleus (PVH) play an important role in a range of physiological and behavioral processes, including the initiation of milk ejection and the regulation of parental behaviors in mothers. However, their activity patterns at the single-cell level remain poorly understood. Using microendoscopic Ca2+ imaging in freely moving mother mice, we demonstrate highly correlated pulsatile activity among individual OT neurons during lactation. The number of OT neurons engaged in the pulsatile activity, along with the characteristics of individual waveforms, was dynamically modulated by lactation and weaning experiences. Notably, only 10% of the imaged OT neurons exhibited a significantly elevated response during pup retrieval, a hallmark of maternal behaviors, with a magnitude 18 times smaller than that observed during lactation. Collectively, these findings demonstrate the utility of microendoscopic imaging for PVH OT neurons and highlight the flexible adjustments of their individual activity patterns in freely behaving mother mice." ;
    schema1:funder <https://ssbd.riken.jp/repository/ssbd-repos-000397/#grant-001> ;
    schema1:identifier "ssbd-repos-000397" ;
    schema1:keywords "Animals",
        "Calcium/metabolism",
        "Endoscopy/methods",
        "Female",
        "Lactation/physiology[major]",
        "Maternal Behavior/physiology",
        "Mice",
        "Neurons/metabolism[major]",
        "Neurons/physiology[major]",
        "Oxytocin/metabolism[major]",
        "Paraventricular Hypothalamic Nucleus/cytology[major]",
        "Paraventricular Hypothalamic Nucleus/metabolism[major]",
        "Paraventricular Hypothalamic Nucleus/physiology[major]" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Flexible Adjustment of Oxytocin Neuron Activity in Mother Mice Revealed by Microendoscopy" ;
    schema1:publisher <https://ssbd.riken.jp/repository> ;
    schema1:size <https://ssbd.riken.jp/repository/ssbd-repos-000397/#file-count>,
        <https://ssbd.riken.jp/repository/ssbd-repos-000397/#total-dataset-size> ;
    rdf:seeAlso <https://doi.org/10.1101/2024.09.18.613777>,
        <https://doi.org/10.1126/sciadv.adt1555> .

