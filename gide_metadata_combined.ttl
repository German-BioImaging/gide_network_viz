<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1090> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1090#daf0b38d-4f3e-471c-bba2-b4690d2e61dd> ;
    schema1:about obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1090#c4a735dd-e72b-43be-8a2d-39da15f846e0> ;
    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1090#63b4d29d-e88c-4fbc-a731-9aeec23db9d1> ;
    schema1:datePublished "2024-03-25" ;
    schema1:description "Nodal B-cell non-Hodgkin lymphomas (B-NHL) are a clinically diverse set of cancers thought to originate from distinct stages of B-cell maturation. To spatially profile intratumor heterogeneity across B-NHL entities, we performed co-detection by indexing (CODEX), a highly multiplexed immunohistochemistry technique imaging 54 markers, on FFPE tissue sections from 19 patient lymph nodes (two 4.5 mm cores per lymph node) including 5 mantle cell lymphoma (MCL), 5 follicular lymphoma (FL), 5 diffuse large B-cell lymphoma (DLBCL), and 2 marginal zone lymphoma (MZL) tumors, in addition to 4 reactive lymph nodes (rLN)." ;
    schema1:identifier "S-BIAD1090" ;
    schema1:keywords "immunohistochemistry",
        "lymph node",
        "lymphomas" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Highly multiplexed immunohistochemistry of nodal B-cell non-Hodgkin lymphomas" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1090#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
