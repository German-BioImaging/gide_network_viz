<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1936#54948553-f52f-4bf7-a592-583d10ac69e7> a schema1:Organization ;
    schema1:name "California Institute of Technology" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1936#da3ed50a-dcd8-4df9-b504-6b79be08a029> a schema1:LabProtocol ;
    schema1:description "All samples were imaged after staining and slide mounting on a Zeiss LSM 880 with Fast Airyscan using a 40x Nikon water/oil immersion lens. 405, 488, 561, and 594 nm lasers (to detect, DAPI, GFP, PGP9.5 - neurons, and anti-GFP respectively) were set to the minimum power needed to resolve structures with as low of a gain as possible. All exposure times were set to 100 ms and 4 scans of each horizontal line were averaged for acquisition. Z stacks were collected as close together as possible and summed for analysis across the whole tissue sample as set by PGP9.5 stain detection. " ;
    schema1:labEquipment "Zeiss LSM 880 with Fast Airyscan" ;
    schema1:measurementTechnique obo:FBbi_00000393 ;
    schema1:name "Myenteric Neurons With Nuclear GFP Expression" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1936#e450c313-4c69-4d02-be01-fff6bfe8cd32> a schema1:Organization ;
    schema1:name "Massachusetts Institute of Technology" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1936#ef790421-d5db-41ef-b238-82ad13eb36d0> a schema1:Organization ;
    schema1:name "University of Florida" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1936#f270c395-b369-47cc-8f34-862290942b7f> a schema1:Organization ;
    schema1:name "University of California, Los Angeles" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1941> a schema1:Dataset ;
    dwciri:measurementMethod <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1941#7e57658f-3a2d-4c4b-8115-944c2f71d90e> ;
    schema1:about obo:NCBITaxon_10090,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1941#3e2e9271-60f2-45be-9954-f4933107c3fd> ;
    schema1:author <https://orcid.org/0000-0002-1876-7432> ;
    schema1:datePublished "2025-06-04" ;
    schema1:description "In this study, we demonstrate the effectiveness of dodecaLSFM by achieving high-resolution imaging of whole mouse brain vasculature with tissue clearing, allowing precise morphometric analysis of vascular networks without stripe artifacts. Furthermore, we show that combining dodecaLSFM with expansion microscopy (ExM) enables whole-organ 3D imaging at cellular resolution. This approach provides an advanced, scalable solution for large-volume imaging, facilitating detailed structural and functional studies across diverse biological applications." ;
    schema1:identifier "S-BIAD1941" ;
    schema1:keywords "Expansion microscopy (ExM)",
        "Light Sheet microscopy" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "Dodecagon light sheet fluorescence microscopy for large volume imaging without striping artifacts" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1941#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1941#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
    schema1:thumbnailUrl "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD1941/1ff7fc10-ed05-447c-987f-50f410b6ec52/static_display_512_512.png" .

