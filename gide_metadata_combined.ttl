<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2260#22e83b63-7f9d-4f73-bb4d-3e0ebcbb776b> a schema1:LabProtocol ;
    schema1:description "3D images of cells were captured as z stacks with 0.3 µm spacing between planes, spanning 12 µm in total. Live HEK293T cells were imaged at 37 °C in phenol red-free DMEM with high glucose (Gibco) supplemented with 1× penicillin/streptomycin, 10% FBS, 6 mmol/L l-glutamine, and 25 mmol/L HEPES.  " ;
    schema1:labEquipment "3i Marianas system (Denver, CO) configured with a Yokogawa CSU-W spinning disk confocal microscope utilizing a 100x Zeiss objective, 405 nm (Hoechst) and 488 nm (mEGFP) laser lines, and Slidebook (RRID: SCR_014300) 6.0 (3i)." ;
    schema1:measurementTechnique obo:FBbi_00000251 ;
    schema1:name "Confocal Microscopy" .

