<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1029> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1029#18b46534-41b4-4566-bed3-66224351eb98> ;
    schema1:about obo:NCBITaxon_10090,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1029#77ab476f-4d9b-4def-b91e-5fb2620bc031> ;
    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1029#9c9b5ee4-a354-4555-9edc-460348aa49bd> ;
    schema1:datePublished "2024-01-30" ;
    schema1:description "We found that the number of primordial germ cells (PGCs) decreased dramatically after MCM8 deficiency due to proliferation defects. We further demonstrated that MCM8 interacted with two known helicases DDX5 and DHX9 in PGCs, and loss of MCM8 led to R-loop accumulation by reducing the retention of these helicases at R-loops, thus inducing genome instability." ;
    schema1:identifier "S-BIAD1029" ;
    schema1:keywords "primordial germ cells, MCM8, R-loop, genome stability, fertility" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "MCM8 interacts with DDX5 to promote R-loop resolution in primordial germ cells" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1029#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
