<https://ssbd.riken.jp/repository/ssbd-repos-000290/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000243,
        <https://ssbd.riken.jp/repository/ssbd-repos-000290/#imaging-protocol-1> ;
    schema1:about <https://ssbd.riken.jp/repository/ssbd-repos-000290/#biosample-1>,
        <https://ssbd.riken.jp/repository/ssbd-repos-000290/#biosample-2> ;
    schema1:author <https://ssbd.riken.jp/repository/ssbd-repos-000290/#auth-001> ;
    schema1:datePublished "2023-04-13" ;
    schema1:description """Keywords: bright-field microscopy, Marchantia polymorpha\r
Time points: Days 0, 1, 2, 3, 4, and 7 after plating gemmae.\r
Accessions: (1) Tak-1 (Takaragaike-1) and Tak-2 (Takaragaike-2) (Bowman et al., 2017). (2) Rit-1 (Recombinant inbred line from Tak-1/Tak-2 accessions-1) and Rit-2 (Recombinant inbred line from Tak-1/Tak-2 accessions-2). Rit-1 and Rit-2 are inbred accessions which has constructed by crossing Tak-1 and Tak-2 and inbreeding the resulting shiblings for 4 generations. (3) male and female of  Australian/Melbourne (Flores-Sandoval et al., 2015).\r
Culture: Plants were cultured from gemmae on 1/2×Gamborg’s B5 medium containing 1.0% agar at 22 degrees centigrade under continuous white light. \r
Image acquisition: Images were acquired by the digital microscope KH-7700 (HIROX) equipped with the lens MXG-2016Z (day 0-3: ×60, day 4: ×40, day 7: ×20).\r
\r
The dataset includes 199-200 plants for Australian/Melbourne and Tak-1/Tak-2, and 600-602 for Rit-1/Rit-2, respectively, with the same numbers of female and male individuals, except 99 females and 100 males in Aus 7-day-old gemmalings.""" ;
    schema1:identifier "ssbd-repos-000290" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Bright-field images of the liverwort Marchantia polymorpha ssp. ruderalis in gemmalings (dorsal view)." ;
    schema1:publisher <https://ssbd.riken.jp/repository> ;
    schema1:size <https://ssbd.riken.jp/repository/ssbd-repos-000290/#file-count>,
        <https://ssbd.riken.jp/repository/ssbd-repos-000290/#total-dataset-size> .

