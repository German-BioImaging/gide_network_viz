    schema1:author <https://idr.openmicroscopy.org/study/idr0043/#person-1> ;
    schema1:copyrightNotice "Uhlen et al, https://v18.proteinatlas.org/about/licence, 2018" ;
    schema1:datePublished "2018-11-01" ;
    schema1:description "Sequencing the human genome gave new insights into human biology and disease. However, the ultimate goal is to understand the dynamic expression of each of the approximately 20,000 protein-coding genes and the function of each protein. Uhlen et al. now present a map of protein expression across 32 human tissues. They not only measured expression at an RNA level, but also used antibody profiling to precisely localize the corresponding proteins." ;
    schema1:identifier "idr0043" ;
    schema1:license "https://v18.proteinatlas.org/about/licence" ;
    schema1:name "Tissue-based map of the human proteome" ;
    schema1:publisher <https://idr.openmicroscopy.org/> ;
    schema1:thumbnailUrl "https://idr.openmicroscopy.org/webgateway/render_thumbnail/3977054/" ;
    rdfs:seeAlso <https://doi.org/10.1126/science.1260419> .

