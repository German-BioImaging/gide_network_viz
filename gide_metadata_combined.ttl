<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1672> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000368,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1672#e2a15bcc-cce6-4576-8115-4e5804ced50d> ;
