<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1822#420d7197-3fd6-4237-b099-606daf4f9f81> a schema1:BioSample ;
    schema1:description "fetal musculus ovaries - The Rosa26rbw/+ and mTmG mice (007576, Jackson Laboratory) were generated as previously reported (Zhang et al, 2012; Zheng et al, 2014), and Rosa26rbw/+ mice as a gift from Dr. Kui Liu. The Oct4-CreERT2 mice (Greder et al, 2012) were gifted from Dr. Ping Zheng at Yunnan Key Laboratory of Animal Reproduction, Kunming Institute of Zoology, Chinese Academy of Sciences, Kunming, China." ;
    schema1:name "Animals" ;
    schema1:taxonomicRange obo:NCBITaxon_10090 .

