<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2455> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000243,
        obo:FBbi_00000246,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2455#43eb0f89-deb4-4f36-9195-0c6e49a0f600> ;
