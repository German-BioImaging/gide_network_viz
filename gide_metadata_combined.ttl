<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2461#365a2479-fb93-45fa-8c3e-375c60ca1534> a schema1:LabProtocol ;
    schema1:description "Image acquisition was performed using a Nikon AX R laser scanning confocal microscope (Nikon, Japan) and the software Nikon NIS-Elements C (version 5.42.06). Images were acquired with a 60X oil objective at 2048x2048 pixel format size (field of view: 294.6278x294.6278 m) and an averaging of 4 images. Pinhole size was set to 0.3 airy units, yielding an optical sectioning of 0.32 µm. Fluorescence acquisition was performed sequentially in two passes to minimize crosstalk: E2-crimson (ex. 561 nm–em. 623-750 nm) and GFP (ex. 488 nm–em. 499-551 nm), followed by DAPI (ex. 405 nm–em. 420-551 nm)." ;
    schema1:labEquipment "Image acquisition was performed using a Nikon AX R laser scanning confocal microscope (Nikon, Japan) and the software Nikon NIS-Elements C (version 5.42.06). " ;
    schema1:measurementTechnique obo:FBbi_00000251 ;
    schema1:name "Nikon confocal microscopy" .

