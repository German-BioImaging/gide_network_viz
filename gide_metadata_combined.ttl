<https://ssbd.riken.jp/v2/project/332-Miyabara-tumor> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000265,
        <https://ssbd.riken.jp/v2/project/332-Miyabara-tumor#imaging-protocol-1> ;
    schema1:about obo:GO_0070483,
        <https://ssbd.riken.jp/v2/project/332-Miyabara-tumor#biosample-1>,
        <https://www.ncbi.nlm.nih.gov/datasets/taxonomy/10090> ;
    schema1:author <https://ssbd.riken.jp/v2/project/332-Miyabara-tumor#auth-001>,
        <https://ssbd.riken.jp/v2/project/332-Miyabara-tumor#auth-002>,
        <https://ssbd.riken.jp/v2/project/332-Miyabara-tumor#auth-003>,
        <https://ssbd.riken.jp/v2/project/332-Miyabara-tumor#auth-004>,
        <https://ssbd.riken.jp/v2/project/332-Miyabara-tumor#auth-005>,
        <https://ssbd.riken.jp/v2/project/332-Miyabara-tumor#auth-006> ;
    schema1:datePublished "2024-12-14" ;
    schema1:description "Tumors contain various stromal cells, such as immune cells, endothelial cells, and fibroblasts, which contribute to the development of a tumor-specific microenvironment characterized by hypoxia and inflammation, and are associated with malignant progression. The authors investigated the activity of intratumoral hypoxia-inducible factor (HIF), which functions as a master regulator of the cellular response to hypoxia and inflammation. They constructed the HIF activity-monitoring reporter gene hypoxia-response element-Venus-Akaluc (HVA) that expresses the green fluorescent protein Venus and modified firefly luciferase Akaluc in a HIF activity-dependent manner, and created transgenic mice harboring HVA transgene (HVA-Tg). By orthotopic transplantation of E0771, a mouse triple negative breast cancer cell line without a reporter gene, into HVA-Tg, they succeeded in noninvasively monitoring bioluminescence signals from HIF-active stromal cells as early as 8 days after transplantation. The HIF-active stromal cells initially clustered locally and then spread throughout the tumors with growth." ;
    schema1:identifier "332-Miyabara-tumor" ;
    schema1:keywords "Hypoxia-Inducible Factor 1 alpha Subunit",
        "Neoplasms",
        "Tumor Hypoxia",
        "Tumor Microenvironment",
        "Tumor hypoxia" ;
    schema1:license "https://creativecommons.org/licenses/by-nc/4.0/" ;
    schema1:name "In vivo optical imaging of tumor stromal cells with hypoxia-inducible factor activity" ;
    schema1:publisher <https://ssbd.riken.jp/database> ;
    schema1:size <https://ssbd.riken.jp/v2/project/332-Miyabara-tumor#file-count>,
        <https://ssbd.riken.jp/v2/project/332-Miyabara-tumor#total-dataset-size> ;
    schema1:thumbnailUrl "https://ssbd.riken.jp/ssbd-omero/v1/projects/1351/render_thumbnail/" ;
    rdf:seeAlso <https://doi.org/10.1111/cas.15907> .

