<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1536#2f2a4cd7-7719-4e44-8912-e7f7d05a56f9> a schema1:LabProtocol ;
    schema1:description "Xy positions were first predetermined and then treatments were added before live cell imaging experiment was initiated.  Live cell imaging was performed using a 20x dry objective (NA 0.75) or 40x dry objective (NA 0.95) and a Nikon DS-Qi2 high-sensitive CMOS monochrome camera. Multipoint acquisition was controlled by NIS-Elements 5.1 software. Image stacks were recorded every 1 hour or 15 minutes for up to 18-24 hours or 2 hours respectively in an OkoLab environmental chamber at 37 °C and 5% CO2. Where used, the cells were imaged with brightfield with an exposure time of 40 ms and lamp intensity of 10%. The H2B-mCherry (where used) was imaged using a TRITC filter at an exposure time of 500 ms and analog gain of 1x, the SIRF biosensor was imaged using a FITC filter at an exposure time of 1 second and analog gain of 1x and the TOTO3/pCS2+ vector was imaged using a Cy5 filter at an exposure time of 1 second and analog gain of 1x." ;
    schema1:labEquipment "Automated Nikon Eclipse Ti2 microscope" ;
    schema1:measurementTechnique obo:FBbi_00000246,
        obo:FBbi_00000249 ;
    schema1:name "TiHCS" .

