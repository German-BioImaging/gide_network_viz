<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2203#fce60a12-f875-4335-a402-ceba3363b21e> a schema1:LabProtocol ;
    schema1:description """Microscope, camera, and software settings were the same for all samples across all blocks and replicates:
a.	Optical zoom: 1.25x
b.	Side lamp intensity (wheel on the side of the microscope) set at max
c.	No lamp filter (microscope’s base wheel) – brightest
d.	Objective aperture – black lever on right over the objective – completely closed
e.	Lowest magnification objective – 0.5X
f.	Microscope turret is on eye-camera (not only eye)
g.	Image plates lid-side down with the lid on""" ;
    schema1:labEquipment "Olympus SZX16 microscope and Olympus DP80 camera together with cellSens software version 1.15 (Olympus, Tokyo, Japan)" ;
    schema1:measurementTechnique obo:FBbi_00000243 ;
    schema1:name "Image aquisition 1" .

