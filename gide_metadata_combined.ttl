<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2132#8a7becdb-c2c9-4134-aa5a-fb785e6d9d06> a schema1:BioSample ;
    schema1:description "Normal human tissue from the following organs: Adrenal gland, Appenix, Bladder, Bone marrow, Breast, Bronchus, Caudate/Cerebellum, Cervix, Colon, Cortex, Duodenum, Endometrium-pre, Endometrium-post, Epididymis, Esophagus, Fallopian tube, Gall bladder, Heart muscle, Hippocampus, Kidney, Liver, Lung, Lymph node, Nasopharynx, Oral tissue, Ovary, Pancreas, Parathyroid, Placenta, Prostate, Rectum, Seminal vesicle, Salivary gland, Skeletal muscle, Small intestine, Smooth muscle, Soft tissue, Skin, Spleen, Stomach, Testis, Thyriod gland, Tonsil, Vagina, Vulva/anal." ;
    schema1:name "Normal human tissue" ;
