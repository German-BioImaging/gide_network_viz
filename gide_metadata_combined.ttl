        "Metamorphosis, Biological/physiology",
        "Receptors, Invertebrate Peptide/genetics",
        "Receptors, Invertebrate Peptide/metabolism",
        "Signal Transduction[major]" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Reduction of endocytosis and EGFR signaling is associated with the switch from isolated to clustered apoptosis during epithelial tissue remodeling in Drosophila." ;
    schema1:publisher <https://ssbd.riken.jp/repository> ;
