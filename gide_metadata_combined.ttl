<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2279#768f2bbc-551e-4edf-be42-935fa490b812> a schema1:LabProtocol ;
    schema1:description """SWIR fluorescence images of the tympanic
membranes obtained using a custom SWIR
setup with laser excitation at 793 nm.""" ;
    schema1:labEquipment """ICG-maltotriose (10 nmol) was administered
POD1 retroorbitally.
• In-vivo fluorescence images were taken at 5
hours.
• SWIR fluorescence images of the tympanic
membranes obtained using a custom SWIR
setup with laser excitation at 793 nm.
• Middle ears were harvested and imaged on
the Pearl Trilogy (LICOR).""" ;
    schema1:measurementTechnique obo:FBbi_00000345 ;
    schema1:name "Image Aquisition 1" .

