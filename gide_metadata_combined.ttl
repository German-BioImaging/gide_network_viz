<https://idr.openmicroscopy.org/study/idr0033/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://idr.openmicroscopy.org/study/idr0033/#screen-protocol-1-0>,
        <https://idr.openmicroscopy.org/study/idr0033/#screen-protocol-1-1>,
        <https://idr.openmicroscopy.org/study/idr0033/#screen-protocol-1-2>,
        <https://idr.openmicroscopy.org/study/idr0033/#screen-protocol-1-3>,
        <https://idr.openmicroscopy.org/study/idr0033/#screen-protocol-1-4>,
        <https://idr.openmicroscopy.org/study/idr0033/#screen-protocol-1-5> ;
    schema1:about obo:NCBITaxon_9606,
        <https://idr.openmicroscopy.org/study/idr0033/#screen-biosample-1> ;
    schema1:author <https://idr.openmicroscopy.org/study/idr0033/#person-1> ;
    schema1:copyrightNotice "Rohban et al, CC-BY-4.0, 2017" ;
    schema1:datePublished "2017-03-16" ;
    schema1:description "We hypothesized that human genes and disease-associated alleles might be systematically functionally annotated using morphological profiling of cDNA constructs, via a microscopy-based Cell Painting assay. Indeed, 50% of the 220 tested genes yielded detectable morphological profiles, which grouped into biologically meaningful gene clusters consistent with known functional annotation (e.g., the RAS-RAF-MEK-ERK cascade). We used novel subpopulation-based visualization methods to interpret the morphological changes for specific clusters. This unbiased morphologic map of gene function revealed TRAF2/c-REL negative regulation of YAP1/WWTR1-responsive pathways. We confirmed this discovery of functional connectivity between the NF-kB pathway and Hippo pathway effectors at the transcriptional level, thereby expanding knowledge of these two signaling pathways that critically regulate tumor initiation and progression. We make the images and raw data publicly available, providing an initial morphological map of major biological pathways for future study." ;
    schema1:identifier "idr0033" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Systematic morphological profiling of human gene and allele function via Cell Painting" ;
    schema1:publisher <https://idr.openmicroscopy.org/> ;
    schema1:size <https://idr.openmicroscopy.org/study/idr0033/#file-count>,
        <https://idr.openmicroscopy.org/study/idr0033/#total-dataset-size> ;
    schema1:thumbnailUrl "https://idr.openmicroscopy.org/webgateway/render_thumbnail/3245579/" ;
    rdfs:seeAlso <https://doi.org/10.7554/eLife.24060> .

