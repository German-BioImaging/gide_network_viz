<https://ssbd.riken.jp/repository/ssbd-repos-000315/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000265,
        <https://ssbd.riken.jp/repository/ssbd-repos-000315/#imaging-protocol-1> ;
    schema1:about obo:NCBITaxon_6239 ;
    schema1:author <https://ssbd.riken.jp/repository/ssbd-repos-000315/#auth-001> ;
    schema1:datePublished "2023-08-15" ;
    schema1:description "Behavioral persistency reflects internal brain states, which are the foundations of multiple brain functions. However, experimental paradigms enabling genetic analyses of behavioral persistency and its associated brain functions have been limited. Here we report novel persistent behavioral responses caused by electric stimuli in the nematode Caenorhabditis elegans. When the animals on bacterial food are stimulated by alternating current, their movement speed suddenly increases two- to three-fold, persisting for more than one minute even after a five-second stimulation. Genetic analyses reveal that voltage-gated channels in the neurons are required for the response, possibly as the sensors, and neuropeptide signaling regulates the duration of the persistent response. Additional behavioral analyses implicate that the animal's response to electric shock is scalable and has a negative valence. These properties, along with persistence, have been recently regarded as essential features of emotion, suggesting that C. elegans response to electric shock may reflect a form of emotion, akin to fear." ;
    schema1:identifier "ssbd-repos-000315" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "x-y coordinates of Caenorhabditis elegans centroids stimulated with electric shock" ;
    schema1:publisher <https://ssbd.riken.jp/repository> ;
    schema1:size <https://ssbd.riken.jp/repository/ssbd-repos-000315/#file-count>,
        <https://ssbd.riken.jp/repository/ssbd-repos-000315/#total-dataset-size> ;
    rdf:seeAlso <https://doi.org/10.1093/genetics/iyad148> .

