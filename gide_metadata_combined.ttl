    schema1:about obo:NCBITaxon_10090,
        <https://idr.openmicroscopy.org/study/idr0170/#experiment-biosample-1> ;
    schema1:author <https://idr.openmicroscopy.org/study/idr0170/#person-2>,
        <https://orcid.org/0000-0001-5828-3259> ;
    schema1:copyrightNotice "Rose et al, CC0-1.0, 2025" ;
    schema1:datePublished "2025-08-06" ;
    schema1:description "SCLC_IMC is a dataset containing images from mouse SCLC tumors and their tumor environments, acquired with imaging mass cytometry.  Lung tumors were induced in two mouse lines differing by their tumor mutation burden (TMB). After appearance of the tumors, each mouse was treated with one of the five considered treatment." ;
    schema1:identifier "idr0170" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
