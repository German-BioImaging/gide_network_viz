<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD609> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD609#34d47349-b111-4218-abc8-467a38e74ce3> ;
    schema1:about obo:NCBITaxon_10090,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD609#b33e4038-34c2-44d1-9a03-b9cc125a1198> ;
    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD609#0de02b54-51be-4cc9-bbe9-42b27639d35e>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD609#3b02c579-9e95-4c5e-9624-f5890b31c889>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD609#4b62646e-cbd8-402e-9947-2624efce74f6>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD609#768ca611-5915-4274-a78a-45589a2d629f>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD609#80bf3858-0430-47f2-a8b1-09a1838e0998>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD609#e38b27a8-5d20-4cc1-9e33-e9121a25995a>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD609#f05c1df4-6d02-4c79-9b21-aaf1e18877fd>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD609#f9b68439-2ae4-4dd4-9094-c1a2d2138e79> ;
    schema1:datePublished "2022-12-14" ;
    schema1:description "In this study, we found that mice lacking gut microbiota displayed increased blood-cerebrospinal fluid (CSF) barrier permeability associated with disorganized tight junctions (TJs), which can be rescued by recolonization with gut microbiota or supplementation with short-chain fatty acids (SCFAs). We further confirmed that the vagus nerve plays an important role in this process but SCFAs can also bypass the vagus nerve and affect blood-CSF barrier functionality. Strikingly, the administration of SCFAs in AppNL-G-F AD mice also improved the localization of TJs in the blood-CSF barrier. This was accompanied by a pronounced reduction in β-amyloid (Aβ) burden, which could be achieved by regulating microglial phenotype. Altogether, our results suggest that modulating the microbiota or administering SCFAs might have therapeutic potential in AD via tightening blood-CSF barrier and maintaining microglial activity." ;
    schema1:identifier "S-BIAD609" ;
    schema1:keywords "Alzheimer’s disease",
        "Gut microbiota",
        "blood-cerebrospinal fluid barrier",
        "short-chain fatty acids" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "The importance of the blood-cerebrospinal fluid interface in the gut-brain axis and Aβ pathology" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD609#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
