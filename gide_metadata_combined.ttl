<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1119> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000251,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1119#46f3f31f-b482-4474-8147-1d970cef7327> ;
    schema1:about obo:NCBITaxon_9606,
