<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD815#6e61a04d-829a-4b5f-a8bc-e973203691cc> a schema1:Person ;
    schema1:affiliation <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD815#e48e3a75-7a48-4224-bca9-fb3493c562b2> ;
