<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1274#6a748651-1314-49f8-9089-03061a0ce002> a schema1:Person ;
    schema1:affiliation <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1274#9f378507-5f3b-44e5-b0d3-580765b827e9> ;
