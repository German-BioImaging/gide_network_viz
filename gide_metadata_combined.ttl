<https://idr.openmicroscopy.org/study/idr0097/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000253,
        <https://idr.openmicroscopy.org/study/idr0097/#experiment-protocol-1-0>,
