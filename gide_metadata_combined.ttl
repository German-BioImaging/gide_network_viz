    schema1:description "493 5D images" ;
    schema1:unitCode "http://purl.obolibrary.org/obo/UO_0000189" ;
    schema1:unitText "file count" ;
    schema1:value 493 .

<https://idr.openmicroscopy.org/study/idr0085/> a schema1:Dataset ;
    dwciri:measurementMethod <https://idr.openmicroscopy.org/study/idr0085/#experiment-protocol-1-0>,
        <https://idr.openmicroscopy.org/study/idr0085/#experiment-protocol-1-1>,
        <https://idr.openmicroscopy.org/study/idr0085/#experiment-protocol-1-2>,
        <https://idr.openmicroscopy.org/study/idr0085/#experiment-protocol-1-3>,
        <https://idr.openmicroscopy.org/study/idr0085/#experiment-protocol-1-4>,
        <https://idr.openmicroscopy.org/study/idr0085/#term> ;
    schema1:about obo:NCBITaxon_10090,
        <https://idr.openmicroscopy.org/study/idr0085/#experiment-biosample-1> ;
    schema1:author <https://orcid.org/0000-0003-3769-3392> ;
    schema1:copyrightNotice "Walsh et al., CC-BY-4.0, 2020" ;
    schema1:datePublished "2020-08-12" ;
    schema1:description "Multi-fluorescent High Resolution Episcopic Microscopy (MF-HREM) is a serial-sectioning, block-facing, wide-field fluorescence technique. It can image large volumes (>0.5mm3) at high resolution (~2um) without the need for tissue clearing or optical sectioning. We detail developments in sample processing including stain penetration, resin embedding and imaging. In addition, we describe image post-processing methods needed to segment and further quantify these data. Finally, we demonstrate the wide applicability of MF-HREM by: 1) quantifying adult mouse glomeruli. 2) identifying injected cells and vascular networks in tumour xenograft models; 3) quantifying vascular networks and white matter track orientation in mouse brain." ;
    schema1:identifier "idr0085" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Multi-fluorescence high-resolution episcopic microscopy (MF-HREM) for three dimensional imaging of adult murine organs" ;
    schema1:publisher <https://idr.openmicroscopy.org/> ;
    schema1:thumbnailUrl "https://idr.openmicroscopy.org/webgateway/render_thumbnail/9846157/" .

<https://idr.openmicroscopy.org/study/idr0085/#experiment-biosample-1> a schema1:BioSample ;
    schema1:description "Application of MF-HREM to imaging and analysis of adult mouse: kidney glomeruli, xenograft tumour vasculature and cell migration, brain microsvasculature and white matter orientation, brain white matter orientation and cell nuclei distribution" ;
    schema1:name "tissue" ;
    schema1:taxonomicRange obo:NCBITaxon_10090 .

<https://idr.openmicroscopy.org/study/idr0085/#experiment-protocol-1-0> a schema1:LabProtocol ;
    schema1:description "Application of MF-HREM to imaging and analysis of adult mouse: kidney glomeruli, xenograft tumour vasculature and cell migration, brain microsvasculature and white matter orientation, brain white matter orientation and cell nuclei distribution" ;
    schema1:measurementTechnique <https://idr.openmicroscopy.org/study/idr0085/#term> ;
    schema1:name "Multi-fluorescence high-resolution episcopic microscopy (MF-HREM)" .

<https://idr.openmicroscopy.org/study/idr0085/#experiment-protocol-1-1> a schema1:LabProtocol ;
    schema1:description "For tumour xenograft model cells from the FaDu human breast cancer cell line were cultured in complete medium (Dulbecco's minimum essential medium Eagle with L-glutamine (DMEM) (Lonza)+10% fetal  bovine serum (Invitrogen)) in the ratio 1:10 (vol/vol) and incubated at 37'C and 5% CO2." ;
    schema1:measurementTechnique <http://www.ebi.ac.uk/efo/EFO_0003789> ;
    schema1:name "growth protocol" .

<https://idr.openmicroscopy.org/study/idr0085/#experiment-protocol-1-2> a schema1:LabProtocol ;
    schema1:description "Tumour cells were stained with CMDiI prior to innoculation." ;
    schema1:measurementTechnique <http://www.ebi.ac.uk/efo/EFO_0003969> ;
    schema1:name "treatment protocol" .

<https://idr.openmicroscopy.org/study/idr0085/#experiment-protocol-1-3> a schema1:LabProtocol ;
    schema1:description "In all cases vasculature was stained via tail vein i.v. with Dyelight649 conjugated to tomato Lectin (Vector), brain white matter was stained ex vivo by immersion in CMDiI, Cell nuceli were stained ex vivo by immersion in HCS CellMask." ;
    schema1:name "image acquisition and feature extraction protocol" .

<https://idr.openmicroscopy.org/study/idr0085/#experiment-protocol-1-4> a schema1:LabProtocol ;
    schema1:description "Kidney glomeruil were segmented via gradient vector flow algorithm, deconvolution of datasets was performed using Richardonson-lucy algorithm, iterations and PSF details given for each image set." ;
    schema1:name "data analysis protocol" .

<https://idr.openmicroscopy.org/study/idr0086/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000257,
