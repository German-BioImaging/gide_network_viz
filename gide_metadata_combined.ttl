<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1702#c4ef2d2a-ce79-4225-b8eb-7f8f1c2adeb2> a schema1:LabProtocol ;
    schema1:description "Brightfield and fluorescence volumes of live cells are acquired on a wide-field fluorescence microscope  with a 63x magnification, 1.3 NA glycerol-immersion objective to collect training data. For testing robustness to different imaging conditions, additional volumes are imaged with a 40x magnification, 1.1 NA water-immersion objective, and a 100x magnification, 1.47 NA oil-immersion objective, at 0.25 µm Z-steps, for 96 Z-slices. For testing generalization to the Zernike phase contrast, image volumes are acquired with a 40x magnification, 0.6 NA Ph2 air objective, at 0.4 µm Z-steps, for 58 Z-slices. The images are sampled on a camera with 6.5 µm pixel size and 2048x2048 sensor." ;
    schema1:labEquipment "Leica Dmi8" ;
    schema1:measurementTechnique obo:FBbi_00000243,
        obo:FBbi_00000246 ;
    schema1:name "HEK293T cells" .

