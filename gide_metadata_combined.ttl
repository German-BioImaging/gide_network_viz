        "Lung/pathology",
        "Mutation",
        "Tumor Microenvironment" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Xenium In Situ Gene Expression and Multiplex Fluorescence Immunostaining data of Lung adenocarcinoma" ;
    schema1:publisher <https://ssbd.riken.jp/repository> ;
