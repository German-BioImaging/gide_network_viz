<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2227> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000243,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2227#432cb7cd-577b-41b7-96c4-b140837c2aef> ;
    schema1:about obo:NCBITaxon_4932,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2227#f0b65155-7cd7-415a-970a-bceb9f7ad860> ;
    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2227#9a8879f5-f676-426d-838f-883e0adbba51>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2227#a665f05e-8441-48f0-aafc-7491355956c7> ;
    schema1:datePublished "2025-08-08" ;
    schema1:description "We present a novel optical nanomotion-based rapid antibiotic and antifungal susceptibility test. The technique consisted of studying the effects of antibiotics or antifungals on the nanometric scale displacements of bacteria or yeasts to assess their sensitivity or resistance to drugs. The technique relies on a traditional optical microscope, a video camera, and custom-made image analysis software. It provides reliable results in a time frame of 2-4 h and can be applied to motile, non-motile, fast, and slowly growing microorganisms. Due to its extreme simplicity and low cost, the technique can be easily implemented in laboratories and medical centers in developing countries." ;
    schema1:identifier "S-BIAD2227" ;
    schema1:keywords "antimicrobials",
        "bacteria",
        "nanomotion",
        "optical microscope",
        "yeast" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "A simplified version of rapid susceptibility testing of bacteria and yeasts using optical nanomotion detection" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2227#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2227#480bb0bc-db43-46e5-88ae-071380b9d63c> .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2227#1037e7dd-b10a-47a1-885c-1f3b2998ff1c> a <https://www.ebi.ac.uk/biostudies/bioimages/studies/QuantitiveValue> ;
    schema1:unitCode "http://purl.obolibrary.org/obo/UO_0000189" ;
    schema1:unitText "file count" ;
    schema1:value 341 .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2227#432cb7cd-577b-41b7-96c4-b140837c2aef> a schema1:LabProtocol ;
    schema1:description "For these experiments, we used a Zeiss inverted traditional optical microscope (Observer Z.1) with a 63x oil immersion objective, coupled with a PCO Edge 5.5 camera. Several (3–5) 10 s-long videos of different fields of view were recorded at 30 fps of both the control and exposed samples for each replicate. " ;
    schema1:labEquipment "Zeiss inverted traditional optical microscope (Observer Z.1) coupled with a PCO Edge 5.5 camera" ;
    schema1:measurementTechnique obo:FBbi_00000243 ;
    schema1:name "Image acquisition 1" .

