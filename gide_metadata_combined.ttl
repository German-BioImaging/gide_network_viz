<https://ssbd.riken.jp/v2/project/319-Shou-RESORT> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000589,
        <https://ssbd.riken.jp/v2/project/319-Shou-RESORT#imaging-protocol-1> ;
    schema1:about obo:CLO_0003684,
        obo:GO_0005739,
        <https://ssbd.riken.jp/v2/project/319-Shou-RESORT#biosample-1>,
        <https://ssbd.riken.jp/v2/project/319-Shou-RESORT#biosample-2>,
        <https://www.ncbi.nlm.nih.gov/datasets/taxonomy/7215>,
        <https://www.ncbi.nlm.nih.gov/datasets/taxonomy/9606> ;
    schema1:author <https://ssbd.riken.jp/v2/project/319-Shou-RESORT#auth-001>,
        <https://ssbd.riken.jp/v2/project/319-Shou-RESORT#auth-002>,
        <https://ssbd.riken.jp/v2/project/319-Shou-RESORT#auth-003>,
        <https://ssbd.riken.jp/v2/project/319-Shou-RESORT#auth-004>,
        <https://ssbd.riken.jp/v2/project/319-Shou-RESORT#auth-005>,
        <https://ssbd.riken.jp/v2/project/319-Shou-RESORT#auth-006>,
        <https://ssbd.riken.jp/v2/project/319-Shou-RESORT#auth-007>,
        <https://ssbd.riken.jp/v2/project/319-Shou-RESORT#auth-008>,
        <https://ssbd.riken.jp/v2/project/319-Shou-RESORT#auth-009> ;
    schema1:datePublished "2024-11-25" ;
    schema1:description "The authors first describe a bright photoswitchable Raman probe (DAE620) and validate its signal activation and depletion characteristics when exposed to low-power (microwatt level) continuous-wave laser light. By harnessing the SRS signal depletion of DAE620 through a donut-shaped beam, they demonstrate super-resolution vibrational imaging of mammalian cells with excellent chemical spe- cificity and spatial resolution beyond the optical diffraction limit. These results indicate RESORT microscopy to be an effective tool with high potential for multiplexed super-resolution imaging of live cells." ;
    schema1:identifier "319-Shou-RESORT" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Super-resolution vibrational imaging based on photoswitchable Raman probe" ;
    schema1:publisher <https://ssbd.riken.jp/database> ;
    schema1:size <https://ssbd.riken.jp/v2/project/319-Shou-RESORT#file-count>,
        <https://ssbd.riken.jp/v2/project/319-Shou-RESORT#total-dataset-size> ;
    schema1:thumbnailUrl "https://ssbd.riken.jp/ssbd-omero/v1/projects/1251/render_thumbnail/" ;
    rdf:seeAlso <https://doi.org/10.1126/sciadv.ade9118> .

