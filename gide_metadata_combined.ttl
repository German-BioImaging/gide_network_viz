<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2120#d04c5ae8-b52e-4fb5-8ffd-0d2c41e1edf7> a schema1:BioSample ;
    schema1:description "ovule primordia stage 1-II to 2-II collected 5 days post induction (Dex, 5dpi) " ;
