<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1483#a6e39445-ed6a-4c86-afd2-9a822abb7485> a schema1:LabProtocol ;
    schema1:description "All brain sections were imaged using a UPLXAPO 20X objective (NA 0.8) and a Hamamatsu ORCA-Fusion camera (2304 × 2304), producing 16-bit grayscale images with approximately 0.3 µm/pixel resolution. We optimized our imaging parameters, adjusting exposure time and laser intensity to capture the full spectrum of MBP staining intensities within the 16-bit scale. " ;
    schema1:labEquipment "Olympus SLIDEVIEW VS200 slide scanner equipped with a SILA 4-line laser combiner (405 nm, 488 nm, 561 nm, and 638 nm) and scrambler unit (Evident Scientific, Inc. Waltham, MA)" ;
    schema1:measurementTechnique obo:FBbi_00000345 ;
    schema1:name "Image acquisition" .

