<https://www.ebi.ac.uk/biostudies/bioimages/studies/EMPIAR-11380#5183b83d-8579-4f00-a208-e61238eeff63> a schema1:BioSample ;
    schema1:description "BT-474 human breast cancer spheroids and patient-derived colorectal cancer organoids cultured in 3D" ;
    schema1:name "Human cancer organoids" ;
    schema1:taxonomicRange obo:NCBITaxon_9606 .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/EMPIAR-11380#84f6f363-0695-4ec6-82bd-2c1ced2f72d0> a schema1:LabProtocol ;
    schema1:description "FIB-SEM imaging was performed on a Zeiss CrossBeam XB540 or XB550. Platinum was deposited over the laser-branded area. Auto-tuning marks were milled on the platinum surface and highlighted with carbon. Large trenches were milled with 30 nA FIB current and surface polished with 7 or 15 nA. Precise milling during the run was achieved with currents of either 700 pA or 1.5 nA. SEM imaging was done with an acceleration voltage of 1.5 kV and a current of 700 pA, using a back-scattered electron detector. For single cells within organoids, data were acquired at 10 nm isotropic (x,y,z) sampling. For entire organoids, voxels of 15x15x20 nm³ were used." ;
    schema1:labEquipment "Zeiss CrossBeam XB540 or XB550, Carl Zeiss AG" ;
    schema1:measurementTechnique obo:FBbi_00050000 ;
    schema1:name "FIB-SEM imaging" .

