    schema1:keywords "Human blastocyst",
        "Live imaging",
        "Time-lapse imaging",
        "mRNA electroporation" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name """Live imaging of late-stage preimplantation human embryos reveals late-stage de novo mitotic errors
""" ;
