<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD679#92e05f89-d366-483c-99a0-7f9517c6e7d2> a schema1:LabProtocol ;
    schema1:description "The cell nuclei observed under the microscope were randomly selected and NBS1-GFP fluorescence was excited by 120 ms exposure to 488 nm light from a Polychrome IV monochromator (TILL Photonics, Gräfelfing, Germany) and registered by an CCD camera (PCO Sensicam, Kelheim, Germany). Time-lapse movies were recorded with 120-ms-per-frame exposures at 1-minute intervals over 300 mins.  The observed images were recorded using the TILL Photonics Imaging System software (TILLvisION v3.3, Gräfelfing, Germany) installed on the microscope’s PC." ;
    schema1:labEquipment "inverted fluorescence microscope Carl Zeiss Axiovert 200" ;
    schema1:measurementTechnique obo:FBbi_00000246 ;
    schema1:name "Image acquisition" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD680> a schema1:Dataset ;
    dwciri:measurementMethod <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD680#2edee593-1128-4736-a2c5-af18769a8ec9>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD680#4a88a475-58fa-4792-bfbf-97cd5d4c54a5> ;
    schema1:about obo:NCBITaxon_10090,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD680#8f10eb8d-bb4b-49e2-82a9-a6aa9a90c54b> ;
    schema1:author <https://orcid.org/0000-0001-6132-7793>,
        <https://orcid.org/0000-0002-5738-0126> ;
    schema1:datePublished "2023-05-26" ;
    schema1:description "Extracting biological information from awake and unrestrained mice is imperative to in vivo basic and pre-clinical research. Accordingly, imaging methods which preclude invasiveness, anesthesia, and/or physical restraint enable more physiologically relevant biological data extraction by eliminating these extrinsic confounders. In this article we discuss the recent development of shortwave infrared (SWIR) fluorescent imaging to visualize peripheral organs in freely-behaving mice, as well as propose potential applications of this imaging modality in the neurosciences." ;
    schema1:identifier "S-BIAD680" ;
    schema1:keywords " in vivo",
        "awake imaging",
        "fluorescence",
        "fluorescent dyes",
        "in vivo imaging",
        "near infrared (NIR)-II",
        "optical imaging" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Shortwave infrared (SWIR) fluorescence imaging of peripheral organs in awake and freely moving mice" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD680#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
