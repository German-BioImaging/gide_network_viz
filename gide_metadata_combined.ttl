    schema1:about obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD873#28243f36-b164-4355-baff-7128bae4e5b7> ;
    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD873#2e6c58ea-7224-47c2-a32d-1a1f994dbf9e>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD873#ca5f6239-3983-403a-a918-a1eb6e5f4ac9>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD873#dc03e818-6bb5-4f92-a102-9f31908fc8b2> ;
    schema1:datePublished "2023-09-07" ;
    schema1:description """Data for all the experiments described in our paper: "Escalating High-dimensional Imaging using Combinatorial Channel Multiplexing and Deep Learning". For further information, please refer to our paper or visit our git repository.

Link to our paper: https://www.biorxiv.org/content/10.1101/2023.09.09.556962v1
