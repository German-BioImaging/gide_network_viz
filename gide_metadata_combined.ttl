        obo:FBbi_00000368,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#08318e38-5cc0-44fe-b858-0ad8caee4967>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#1f0e3a6a-235a-4f1b-b4c3-c5daa6fcddb8>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#34675ce8-cb23-4061-863f-663b48e9bef1> ;
    schema1:about obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#688683ae-1e60-4820-93f1-034e565616e3>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#88506d96-fb93-4a6a-a090-f8341160dfb1>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#be8db865-d06d-4f7d-a476-0032600b6d8f>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#dba24f9e-9c03-42e4-b71f-04fd2ba15e92>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#de85f267-7cf0-4c07-8744-8d5b8a6d2ff5> ;
    schema1:author <https://orcid.org/0000-0003-3161-3072>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#0ad65cb3-ec46-441b-be1a-d1aab92b3c57>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#1179fe3e-4882-4e04-8b65-f8357e51ac18>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#32342211-cda8-48dd-9930-b3e4392f95cc>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#65522edc-93b2-4f22-836e-b6404a2d4cb6>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#a6d37efd-8f36-4531-84aa-d5463718bb8e>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#a71a71ba-f0fa-4b88-9633-fdea7679540c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#efb5f5ae-bf96-4a9c-ae85-776fcc06d755> ;
    schema1:datePublished "2025-07-23" ;
    schema1:description "Measuring protein turnover in individual cells and subcellular compartments has been greatly assisted by fluorescence timers (FT) whose changing spectra, expressed as the ratio of fluorescence intensities, reflect their molecular age. However, FT quantification requires highly fluorescent samples, prohibiting their use for proteins with low or non-uniform expression. Here we developed a method that utilises fluorescence lifetime, a property largely independent of intensity, of a specifically designed FT (named FLIM-timer). The fluorescence lifetime of FLIM-timer reflected protein turnover in regions of high and low brightness with equally high precision. We demonstrate the versatility of this approach with several versions of FLIM-timer in two distinct experimental systems: 1) as a readout for efficacy of pharmacological inducers of Nrf2, the master regulator of redox homeostasis, and 2) as a tool to monitor cyclin B1 degradation during mitotic exit. Overall, the FLIM-timer methodology expands the applicability of FT for visualisation and quantification of protein turnover." ;
    schema1:identifier "S-BIAD1305" ;
    schema1:keywords "Cyclin B",
        "FLIM",
        "FRET",
        "Fluorescence Lifetime Imaging",
        "Fluorescence timer",
        "Nrf2",
        "Protein Degradation",
        "Protein turnover" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "DESIGN AND VALIDATION OF FLIM-TIMER FOR MEASURING PROTEIN TURNOVER IN CELLS USING FLUORESCENCE LIFETIME" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
    schema1:thumbnailUrl "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD1305/414ecd34-8760-44ea-8ff0-a37b09550e3d/static_display_512_512.png" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1305#08318e38-5cc0-44fe-b858-0ad8caee4967> a schema1:LabProtocol ;
    schema1:description "Life cells were imaged on LSM 710 (Zeiss) confocal microscope operated by ZEN software (Zeiss) equipped with dark environmental chamber maintained at 37 degree C and a humidified source of 5% CO2. Cell growing on glass-bottom dishes (35 mm FluoroDishes, World Precision Instruments, or 35 mm 4-compartment CELLview dishes, Greiner Bio-One) were held in heated Petri-dish holder insert and imaged with 488 nm (for EGFP, sfGFP or mNeonGreen) or 594 nm (for mCherry) confocal lasers using 63x/1.4NA oil immersion objective. " ;
    schema1:labEquipment "LSM 710 (Zeiss)" ;
    schema1:measurementTechnique obo:FBbi_00000251 ;
    schema1:name "confocal microscopy" .

