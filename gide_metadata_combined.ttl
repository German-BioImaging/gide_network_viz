    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1239#d51a550e-b0f8-4515-9710-f76a9b5c4060>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1239#f5a52978-80ca-4cf3-aae9-12ffb233d8ae> ;
    schema1:datePublished "2024-06-25" ;
    schema1:description "The CLP model was used to study polymicrobial sepsis, with sham as a control. Mice were subjected to sham or CLP procedure, and 6h, 24h and 48h later, livers were isolated for immunohistochemisty. As a control, wildtype control (Hnf4aflfl) and liver-specific HNF4a knockout (Hnf4aLiver-i-KO) mice were included, all of which were injected with tamoxifen for 5 consecutive days. Livers were isolated for immunohistochemistry 3 days after the last tamoxifen injection. The images were stained with DAPI (nuclei - blue) and an HNF4a antibody (red) and visualized with Axioscan.Z1 Slide scanner (Zeiss), using a Plan-Apochromat 10x/0.45 M27 objective lens at a pixel size of 0.650 µm." ;
    schema1:identifier "S-BIAD1239" ;
    schema1:keywords "Immunohistochemistry, HNF4a, CLP" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "A critical role for HNF4α in polymicrobial sepsis-associated metabolic reprogramming and death" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1239#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
