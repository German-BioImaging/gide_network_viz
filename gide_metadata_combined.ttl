<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD769> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000251,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD769#06ae6e88-bcef-40f1-98ba-68b02dcf7d32> ;
    schema1:about obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD769#72d62e9a-1a47-45b2-8f9e-dc66095ef3b0> ;
    schema1:author <https://orcid.org/0000-0003-0368-9512> ;
    schema1:datePublished "2023-06-29" ;
    schema1:description "Nix is a membrane-anchored outer mitochondrial protein than induces mitophagy.  While Nix has a LIR motif for binding to ATG8 proteins, it also contains a MER (minimal essential region) that induces mitophagy through an unknown mechanism.  We use chemically induced dimerization (CID) to probe the mechanism of Nix-mediated mitophagy and find that both the LIR and MER are required for robust mitophagy.  We find that the Nix MER interacts with WIPI2 and recruits WIPI2 to mitochondria.  The Nix LIR motif is also required for robust mitophagy and converting WIPI2 coating the mitochondria into puncta, independently of Atg8s. Together this work reveals unanticipated mechanisms in Nix-induced mitophagy and the elusive role of the MER, while also revealing an interesting example of autophagy induction downstream of the Ulk1 initiation and PI3K complexes." ;
    schema1:identifier "S-BIAD769" ;
    schema1:keywords "BNIP3L",
        "LIR",
        "Nix",
        "WIPI2" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "Nix Interacts with WIPI2 to Induce Mitophagy" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD769#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD769#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
    schema1:thumbnailUrl "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD769/adec4b4d-4b77-4e7c-ae60-ff7e9aa7103f/cd49f04a-cd71-4ec1-82bb-1334ac2289b1.png" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD769#06ae6e88-bcef-40f1-98ba-68b02dcf7d32> a schema1:LabProtocol ;
    schema1:description "Cells were imaged on a Nikon Ti-2 CSU-W1 spinning disk confocal system operated by Nikon elements AR microscope imaging software either using a 20× air objective (NA 0.75) or a 40x water objective (NA 1.15) with the automated TI2-N-WID water immersion dispenser.  The microscope is equipped with a live cell chamber that was set to 37°C and 50% CO2 with constant humidity.  Cells were imaged in MGB096-1-2-LG-L 96-well imaging plates (DOT Scientific Inc).  mKeima was excited with 488 and 561 lasers for neutral and acidic pH compartments, respectively, and each assessed with a 698/70nm emission filter." ;
    schema1:labEquipment "Nikon Ti-2 CSU-W1 spinning disk confocal system " ;
    schema1:measurementTechnique obo:FBbi_00000251 ;
    schema1:name "Nix Interacts with WIPI2 to Induce Mitophagy" .

