<https://ssbd.riken.jp/v2/project/317-Narita-Argonaute2Aggrigate> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        obo:FBbi_00000249,
        <https://ssbd.riken.jp/v2/project/317-Narita-Argonaute2Aggrigate#imaging-protocol-1>,
        <https://ssbd.riken.jp/v2/project/317-Narita-Argonaute2Aggrigate#imaging-protocol-2> ;
    schema1:about obo:GO_0065003,
        <https://ssbd.riken.jp/v2/project/317-Narita-Argonaute2Aggrigate#biosample-1>,
        <https://www.ncbi.nlm.nih.gov/datasets/taxonomy/7215> ;
    schema1:author <https://ssbd.riken.jp/v2/project/317-Narita-Argonaute2Aggrigate#auth-001>,
        <https://ssbd.riken.jp/v2/project/317-Narita-Argonaute2Aggrigate#auth-002>,
        <https://ssbd.riken.jp/v2/project/317-Narita-Argonaute2Aggrigate#auth-003> ;
    schema1:datePublished "2024-12-23" ;
    schema1:description """Argonaute proteins play a central role in RNA silencing by forming protein-small RNA complexes responsible for the silencing process. While most Argonaute proteins have a short N-terminal region, Argonaute2
in Drosophila melanogaster (DmAgo2) harbors a long and unique N-terminal region. The N-terminal region is highly rich in glutamine and glycine residues, which is a well-known property for prion-like domains, a subclass of amyloid-forming peptides. Therefore, the possibility of the N-terminal region func- tioning as an amyloid was tested.""" ;
    schema1:identifier "317-Narita-Argonaute2Aggrigate" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Aggregates formation of Drosophila melanogaster Argonaute2 N-terminal region" ;
    schema1:publisher <https://ssbd.riken.jp/database> ;
    schema1:size <https://ssbd.riken.jp/v2/project/317-Narita-Argonaute2Aggrigate#file-count>,
        <https://ssbd.riken.jp/v2/project/317-Narita-Argonaute2Aggrigate#total-dataset-size> ;
    schema1:thumbnailUrl "https://ssbd.riken.jp/ssbd-omero/v1/projects/1402/render_thumbnail/" ;
    rdf:seeAlso <https://doi.org/10.1186/s12915-023-01569-3> .

