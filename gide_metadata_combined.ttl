<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1183> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000251,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1183#206cf1f3-f02b-4a7a-9f99-1251c79b5f5f> ;
    schema1:about obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1183#95f02b23-3e5e-446c-9d5f-5c1870d47e3a> ;
    schema1:author <https://orcid.org/0000-0001-5333-0837>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1183#0a1a1302-2f3e-48ef-91c8-f9e065ba0b7c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1183#227a7f3d-8e6f-4b86-8359-3721f5e1f709>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1183#4fb1d489-1c1c-4470-abc9-a70bea315845>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1183#6c64062f-f576-4a5c-b701-9718f38ac4ce>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1183#876c44d8-fd15-4a6e-8d6c-099af9f1ce99>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1183#9667836a-c487-407c-8c54-4740dc2c73d1>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1183#a65d7ab1-e58f-422a-8e38-33a1cd82a7d7>,
