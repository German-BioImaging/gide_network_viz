    dwciri:measurementMethod obo:FBbi_00000246,
        obo:FBbi_00000253,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1752#2572d6b3-cbd8-46d8-a458-dc4e63db4346>,
