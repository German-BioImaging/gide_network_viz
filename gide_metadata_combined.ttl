<https://idr.openmicroscopy.org/study/idr0139/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000249,
        obo:FBbi_00000253,
        <https://idr.openmicroscopy.org/study/idr0139/#screen-protocol-1-0>,
