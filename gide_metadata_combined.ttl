<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1019#b96e4f05-0cea-406d-b185-f9fddf6067ae> a schema1:LabProtocol ;
    schema1:description "Light-sheet imaging for c-Fos labelled brains was conducted through a 4× objective lens (Olympus XLFLUOR 340) equipped with an immersion corrected dipping cap mounted on an UltraMicroscope II (LaVision BioTec) coupled to a white light laser module (NKT SuperK Extreme EXW-12). The antibody signal was visualized using a 640/40nm excitation and 690/50nm emission filter. Tiling scans (3 by 3 tiles) were acquired with a 15-20% overlap, 60% sheet width and 0.027 NA. The images were taken in 16-bit depth and at a nominal resolution of 1.625 μm/voxel on the XY axes. In z-dimension we took images in 6 μm steps using left and right sided illumination." ;
    schema1:labEquipment "UltraMicroscope II (LaVision BioTec)" ;
    schema1:name "Light-Sheet Imaging" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1019#de7ee26e-30d9-4187-a765-52a69efa7187> a schema1:Organization ;
