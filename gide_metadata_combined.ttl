<https://ssbd.riken.jp/v3/project/393-Fujimoto-CoV2Infect> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        obo:FBbi_00000251,
        <https://ssbd.riken.jp/v3/project/393-Fujimoto-CoV2Infect#imaging-protocol-1>,
        <https://ssbd.riken.jp/v3/project/393-Fujimoto-CoV2Infect#imaging-protocol-2> ;
    schema1:about <https://ssbd.riken.jp/v3/project/393-Fujimoto-CoV2Infect#biosample-1>,
        <https://www.ncbi.nlm.nih.gov/datasets/taxonomy/9606> ;
    schema1:author <https://ssbd.riken.jp/v3/project/393-Fujimoto-CoV2Infect#auth-001>,
        <https://ssbd.riken.jp/v3/project/393-Fujimoto-CoV2Infect#auth-002>,
        <https://ssbd.riken.jp/v3/project/393-Fujimoto-CoV2Infect#auth-003>,
        <https://ssbd.riken.jp/v3/project/393-Fujimoto-CoV2Infect#auth-004>,
        <https://ssbd.riken.jp/v3/project/393-Fujimoto-CoV2Infect#auth-005> ;
    schema1:datePublished "2025-11-26" ;
    schema1:description "Blood vessels show various COVID-19-related conditions including thrombosis and cytokine propagation. Existing in vitro blood vessel models cannot represent the consequent changes in the vascular structure or determine the initial infection site, making it difficult to evaluate how epithelial and endothelial tissues are damaged. Here, the authors developed a microphysiological system (MPS) that co-culture the bronchial organoids and the vascular bed to analyze infection site and interactions. In this system, virus-infected organoids caused damage in vascular structure. However, vasculature was not damaged or infected when the virus was directly introduced to vascular bed. The knockout of interferon-related genes and inhibition of the JAK/STAT pathway reduced the vascular damage, indicating the protective effect of interferon response suppression. The results demonstrate selective infection of bronchial epithelial cells and vascular damage by cytokines and also indicate the applicability of MPS to investigate how the infection influences vascular structure and functions." ;
    schema1:funder <https://ssbd.riken.jp/v3/project/393-Fujimoto-CoV2Infect#grant-001> ;
    schema1:identifier "393-Fujimoto-CoV2Infect" ;
    schema1:keywords "Actin Cytoskeleton",
        "COVID-19",
        "Cell Nucleus",
        "Epithelial Cells",
        "Human Umbilical Vein Endothelial Cells",
        "Microscopy, Confocal" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "SARS-CoV-2 infection to the co-culture of bronchial organoids and vascular beds in a microfluidic device" ;
    schema1:publisher <https://ssbd.riken.jp/database> ;
    schema1:size <https://ssbd.riken.jp/v3/project/393-Fujimoto-CoV2Infect#file-count>,
        <https://ssbd.riken.jp/v3/project/393-Fujimoto-CoV2Infect#total-dataset-size> ;
    schema1:thumbnailUrl "https://ssbd.riken.jp/ssbd-omero/v1/projects/1755/render_thumbnail/" ;
