<https://www.ebi.ac.uk/biostudies/bioimages/studies/EMPIAR-12377#7e9cfe36-d7fe-462a-8181-6d3c86e19b52> a schema1:BioSample ;
    schema1:description "External lymphoid organ located bilaterally posterior to the operculum and dorsal to the base of the pectoral fin in adult zebrafish, containing immune cells, blood vessels, and lymphatic vessels" ;
    schema1:name "Zebrafish axillary lymphoid organ" ;
    schema1:taxonomicRange obo:NCBITaxon_7955 .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/EMPIAR-12377#b0b043a9-8b10-4380-906b-5e00d624264b> a schema1:LabProtocol ;
    schema1:description "Wafers were affixed to a 4-inch stage-decel holder in a Zeiss SEM (GeminiSEM 450) and imaged using ATLAS 5 Array Tomography software. Five wafers were imaged using a four-quadrant backscatter detector, with the electron beam operated at 3 kV EHT with 1 kV beam deceleration and 800pA probe current. Low-resolution overview scans were collected at 3000 nm pixel resolution, medium-resolution section sets were collected at 150 nm pixel resolution, and high-resolution sites were collected at 25 and 10 nm pixel resolution. Once image acquisition was complete, the image stack was locally cropped and aligned using the ATLAS 5 software. The resulting image stack was processed using python-based scripts to produce two aligned and contrast/brightness adjusted image datasets: a stack of images at 10 or 25 nm (xy) x 100 nm (z), and a final binned 100x100x100nm isotropic volume." ;
    schema1:labEquipment "Zeiss GeminiSEM 450, Carl Zeiss" ;
    schema1:measurementTechnique obo:FBbi_00000257 ;
    schema1:name "Array Tomography SEM" .

