<https://ssbd.riken.jp/v2/project/273-Kaise-NeuralStemCell> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        obo:FBbi_00000249,
        <https://ssbd.riken.jp/v2/project/273-Kaise-NeuralStemCell#imaging-protocol-1>,
        <https://ssbd.riken.jp/v2/project/273-Kaise-NeuralStemCell#imaging-protocol-2> ;
    schema1:about obo:GO_0022008,
        obo:GO_0048863,
        <https://ssbd.riken.jp/v2/project/273-Kaise-NeuralStemCell#biosample-1>,
        <https://www.ncbi.nlm.nih.gov/datasets/taxonomy/10090> ;
    schema1:author <https://ssbd.riken.jp/v2/project/273-Kaise-NeuralStemCell#auth-001>,
        <https://ssbd.riken.jp/v2/project/273-Kaise-NeuralStemCell#auth-002> ;
    schema1:datePublished "2024-11-25" ;
    schema1:description "Dentate gyrus of 11-month-old luciferase2 - Ascl1 reporter transgenic mice was injected by inducing Plagl2 and anti Dyrk1a (iPaD) - mCherryNLS lentivrus. iPaD - mCherryNLS expressed mainly at adult neural stem cells (NSCs) of dentate gyrus enhancing the proliferation of NSCs where Ascl1 supposed to express in an oscillatory manner. 4 week after iPaD lentivirus injection, brain slices containg dentate gyrus were exracted and placed in a gel supplemented by culture medium. Time-lapse imaging of the bioluminescent signal derived from Luciferse2 - Ascl1 reporter and the mCherry fluorescent signal derived from lentivirus infected cells were detected by Olympus IX-81 with a CCD camera (iKon-M DU934P-BV, Andor) and a 40x objective lens." ;
    schema1:identifier "273-Kaise-NeuralStemCell" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Bioluminescent time-lapse imaging of Ascl1-Luciferse reporter mice's brain slices after iPaD virus injection" ;
    schema1:publisher <https://ssbd.riken.jp/database> ;
    schema1:size <https://ssbd.riken.jp/v2/project/273-Kaise-NeuralStemCell#file-count>,
        <https://ssbd.riken.jp/v2/project/273-Kaise-NeuralStemCell#total-dataset-size> ;
