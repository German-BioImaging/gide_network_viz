        "Proteoglycans/metabolism[major]" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "HAPLN2 forms aggregates and promotes microglial inflammation during brain aging in mice" ;
    schema1:publisher <https://ssbd.riken.jp/repository> ;
