<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1483> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000345,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1483#a6e39445-ed6a-4c86-afd2-9a822abb7485> ;
    schema1:about obo:NCBITaxon_10090,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1483#2c871cdb-dc19-40e3-8954-04da44562040> ;
    schema1:author <https://orcid.org/0000-0002-8926-8606> ;
    schema1:datePublished "2024-11-26" ;
    schema1:description "Healthy brain development hinges on proper myelination. Disruptions in this process result in a variety of neurological disorders. Myelin basic protein (MBP) immunohistochemistry is a key method for studying myelination and myelin-related disorders. Despite MBP studies dating back to the 1980s, there has been a surprising lack of detailed accounts of normal MBP progression across the developing mouse brain. This study presents a detailed spatiotemporal view of MBP distribution across 12 developmental ages from postnatal day 2 to 60. We used an optimized immunohistochemistry protocol to overcome the challenges of myelin's unique lipid-rich composition, enabling more consistent staining across diverse brain structures and developmental stages. " ;
    schema1:identifier "S-BIAD1483" ;
    schema1:keywords "myelin, MBP (myelin basic protein), postnatal development, white matter" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "Regional expression of myelin basic protein across postnatal brain development of C57BL/6J mice" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1483#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1483#480bb0bc-db43-46e5-88ae-071380b9d63c> .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1483#1037e7dd-b10a-47a1-885c-1f3b2998ff1c> a <https://www.ebi.ac.uk/biostudies/bioimages/studies/QuantitiveValue> ;
