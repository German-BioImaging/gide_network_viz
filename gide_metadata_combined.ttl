<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1155#fbd008b8-dfa2-44ec-a460-14ea5176800e> a schema1:LabProtocol ;
    schema1:description "Micrographs were obtained on an Opera Phenix (PerkinElmer) automated spinning disc confocal microscope. All imaging was done with a 63× water immersion objective. GFP was excited using a 488 nm laser and emission collected through a 520/35 nm filter. tdTomato was excited using a 561 nm laser, and emission collected through a 600/40 nm filter. E2Crimson was excited using a 640 nm laser, and emission collected through a 690/50 nm filter." ;
    schema1:labEquipment "Opera Phenix (PerkinElmer)" ;
    schema1:measurementTechnique obo:FBbi_00000246 ;
    schema1:name "S. cerevisiae microscopy images" .

