<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2403> a schema1:Dataset ;
    dwciri:measurementMethod <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2403#635eac0f-14c9-43c4-83f3-29bc88222d5d> ;
    schema1:about obo:NCBITaxon_10090,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2403#6e0879ba-6d5b-4339-8cdf-9b59e628b3fb> ;
    schema1:author <https://orcid.org/0000-0002-7988-2055> ;
    schema1:datePublished "2025-11-17" ;
    schema1:description "This dataset comprises live-cell fluorescence resonance energy transfer (FRET) and corresponding bright-field images of MCF-7 cells co-expressing the fluorescently tagged proteins CFP-BCL-2 and YFP-BAK under various drug treatment conditions. The data were acquired using quantitative FRET microscopy to simultaneously capture dynamic drug-target interactions and morphological changes at single-cell resolution. This resource enables the quantitative analysis of drug-induced modulation of BCL-2/BAK interactions, the correlation between target engagement and phenotypic outcomes, and the development of computational models for drug efficacy scoring. The dataset is an essential resource for researchers in cancer biology, drug discovery, and high-content image analysis, providing a foundation for studying dynamic protein-protein interactions and functional drug responses in a live-cell context." ;
    schema1:identifier "S-BIAD2403" ;
    schema1:keywords "FRET images, Bright-field images，BCL2/BAK" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "Database of FRET and bright-field images for MCF-7 cells co-expressing CFP-BCL-2 and YFP-BAK under drug treatment" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2403#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
