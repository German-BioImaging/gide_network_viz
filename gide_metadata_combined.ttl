<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2516#51681b67-9ab9-47c3-9d97-d9d36635df7b> a schema1:BioSample ;
    schema1:description "HeLa FlpIn T-REx cells expressing CENP-A SNAP and mNeonGreen-PLK1 or mNeonGreen-Bora - HeLa FlpIn T-REx cells expressing CENP-A SNAP and mNeonGreen-PLK1 or mNeonGreen-Bora" ;
