<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD903#5981d7d4-dca6-421b-8d56-4fe60b8d59e8> a schema1:LabProtocol ;
    schema1:description """All confocal images were obtained by using a Zeiss LSM780 confocal microscope (40x water immersion objective, Zeiss C‐PlanApo, NA1.2). For time series analysis, settings were established in the beginning on mock samples and were kept standard during the experiment. 
Green fluorescence was excited with an argon laser at 488 nm and emission was detected at 490 – 530nm, yellow was excited with an argon laser at 514 nm and emission was detected at 520 – 550nm, and red was excited with Diode-pumped solid state (DPSS) lasers at 514nm and detected at 570 – 650nm. PI was excited at 561nm by DPSS lasers and detected by PMTs at 590 – 650nm. DAPI was excited at 405nm with a laser diode and detected at 410 – 480nm. 
""" ;
    schema1:labEquipment "LSM780/880 (Zeiss CLSM)" ;
    schema1:measurementTechnique obo:FBbi_00000251 ;
    schema1:name "Fluorescence imaging" .

