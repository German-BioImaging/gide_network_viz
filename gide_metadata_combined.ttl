    schema1:author <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2088#02b6bcb1-d328-4dc7-9b3f-f5b3f97f0d54>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2088#2d68bd76-c051-4c73-8b85-98c8de802e2e>,
