<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1405#ba3cd6ed-b111-47bf-a00c-a2b0736e04be> a schema1:Person ;
    schema1:affiliation <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1405#5eda1ae1-e3dc-49a2-84bf-4d09c068cee3> ;
