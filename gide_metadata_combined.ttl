<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1977> a schema1:Dataset ;
    dwciri:measurementMethod <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1977#6631a042-570d-4026-b9ae-e632504f7d72> ;
    schema1:about obo:NCBITaxon_160986,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1977#22f81dfe-5586-4cb5-96ff-ca77d1f26e75> ;
    schema1:author <https://orcid.org/0000-0002-6445-3725> ;
    schema1:datePublished "2025-05-26" ;
    schema1:description """The separated root of Zelkova carpinifolia specimen (BIA Acc. No. S-BIAD1968, DOI:10.6019/S-BIAD1968) was subjected to NextITS sequencing. Ascomatal recognition via stereoscopic microscopy (BIA Acc. No. S-BIAD1947, DOI:10.6019/S-BIAD1947) and spore shape and size examination via optical microscopy (BIA Acc. No. S-BIAD1948, DOI:10.6019/S-BIAD1948) identified the root's symbiont as Tuber aestivum.
The Zelkova carpinifolia and Tuber aestivum sequences were deposited in NCBI GenBank under accession numbers PV663938 and PV665023, respectively.
Ectomycorrhizal evidence of Z. carpinifolia root, including external structures (SEM & stereoscopic binocular microscopy; Acc. No. S-BIAD1974, DOI:10.6019/S-BIAD1974) and internal structures (optical microscopy; Acc. No. S-BIAD1975, DOI:10.6019/S-BIAD1975 and FE-SEM; Acc. No. S-BIAD1976, DOI:10.6019/S-BIAD1976), was deposited on the BIA.""" ;
    schema1:identifier "S-BIAD1977" ;
    schema1:keywords "Ectomycorrhizal association",
        "Hyrcanian temperate forests",
        "Mycobiont evolutionary history",
        "Soil type",
        "Tuber aestivum",
        "Zelkova carpinifolia",
        "brûlé conditions" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name "Tuber aestivum hosted by Zelkova carpinifolia: Geology, pedology, and ecology" ;
