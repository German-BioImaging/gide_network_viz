        "single cell",
        "yeast" ;
    schema1:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    schema1:name """Optical Nanomotion Detection to Rapidly Discriminate between Fungicidal and Fungistatic Effects of Antifungals on Single-Cell Candida albicans
""" ;
