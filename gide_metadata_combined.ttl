<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2326> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000393,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2326#9279e869-9a73-4c7a-84d6-3041f70879bb> ;
    schema1:about obo:NCBITaxon_10090,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2326#95257b24-7366-405f-ad4a-1b83501c8a57> ;
    schema1:author <https://orcid.org/0000-0001-8782-9126> ;
    schema1:datePublished "2025-09-30" ;
    schema1:description "Colocalization of VGLUT1 or VGLUT2 with α-synuclein was analyzed in cortical sections from striatal monomer-injected mice. Sections were co-stained with either VGLUT1/α-synuclein or VGLUT2/α-synuclein and imaged in 3D Airyscan mode. Images were processed to super-resolution (strength = 5.5), with chromatic aberration corrected (1.2 pixels in the z-axis). Background subtraction was performed in Imaris prior to colocalization analysis. The Coloc function was applied to quantify colocalization of VGLUT1 with α-synuclein and, in a separate analysis, VGLUT2 with α-synuclein. Thresholds for each channel were set independently using the automatic “calculate threshold” function. Colocalization was assessed using the Build Coloc Channel tool in Imaris, and parameters including Manders’ coefficients and the percentage of VGLUT1- or VGLUT2-positive voxels above threshold colocalized with α-synuclein were analyzed." ;
    schema1:identifier "S-BIAD2326" ;
    schema1:keywords "Colocolization",
        "VGLUT1",
        "VGLUT2",
        "α-Synuclein," ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Colocalization of VGLUT1/VGLUT2 with α-synuclein in cortical sections of mice injected with α-synuclein monomer in the striatum" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2326#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2326#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
    schema1:thumbnailUrl "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD2326/4b389691-0466-4f02-b441-0540c620e355/static_display_512_512.png" .

