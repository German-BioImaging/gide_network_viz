    schema1:name "Entangled architecture of rough endoplasmic reticulum (RER) and vacuoles enables topological damping in cytoplasm of an ultra-fast giant cell" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD728#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
