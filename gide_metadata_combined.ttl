<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2485#6ce34609-551d-4811-bb0b-6532d2508c89> a schema1:BioSample ;
    schema1:description "Mouse brain sections from the ventral tegmental area, substantia nigra and striatum - Brain tissue sections from 6-month-old M83 A53T transgenic mice (n=5) and age matched wild type controls (n=4) were provided by the Florey Institute of Neuroscience and Mental Health at University of Melbourne and used for analysis. Mice that carry the human A53T mutation driven by the mouse prion promoter (Jax Stock No: 004479; B6;C3-Tg (Prnp-SNCA*A53T)83Vle/J; A53T alpha-synuclein transgenic line M83) were obtained from Jackson Laboratories (Bar Harbor, ME) and a stable breeding colony generated in house (genotype of all mice used in the study confirmed by qPCR)" ;
    schema1:name "Biosample 1" ;
    schema1:taxonomicRange obo:NCBITaxon_10090 .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2485#a977807c-849f-4f57-9658-b2ed592473cc> a schema1:Person ;
    schema1:affiliation <https://ror.org/0384j8v12> ;
    schema1:email "glenda.halliday@sydney.edu.au" ;
    schema1:name "Glenda Halliday" .

<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2485#c37776ea-060d-4f1d-8f09-679b617784cb> a schema1:LabProtocol ;
    schema1:description "Z stack images of these regions were captured at 1μm intervals for 10μm at 40X/NA1.1 magnification (this z distance separated overlapping astrocytes). In the entire ROI images, the widefield fluorescence Z stack images were exported as tiffs. For the midbrain slide, one region in the SNC and one region in the VTA was captured at the three levels in the series - Rostral, Middle and Caudal. For the larger striatum, standardised rostral, mid and caudal levels were selected, and four regions captured per level in the series.  The brightness and contrast of the images was standardised. " ;
    schema1:labEquipment """Leica THUNDER 3D Imager
""" ;
    schema1:measurementTechnique obo:FBbi_00000251 ;
    schema1:name "Image acquisition 1" .

