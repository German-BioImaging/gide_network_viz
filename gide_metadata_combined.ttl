<https://idr.openmicroscopy.org/study/idr0006/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://idr.openmicroscopy.org/study/idr0006/#screen-protocol-1-0>,
        <https://idr.openmicroscopy.org/study/idr0006/#screen-protocol-1-1>,
        <https://idr.openmicroscopy.org/study/idr0006/#screen-protocol-1-2>,
        <https://idr.openmicroscopy.org/study/idr0006/#screen-protocol-1-3>,
        <https://idr.openmicroscopy.org/study/idr0006/#screen-protocol-1-4> ;
    schema1:about obo:NCBITaxon_9606,
        <https://idr.openmicroscopy.org/study/idr0006/#screen-biosample-1> ;
    schema1:author <https://idr.openmicroscopy.org/study/idr0006/#person-1> ;
    schema1:copyrightNotice "Fong et al, CC-BY-NC-SA-3.0, 2016" ;
    schema1:datePublished "2016-04-27" ;
    schema1:description "The nucleus is a unique organelle that contains essential genetic materials in chromosome territories. The interchromatin space is composed of nuclear subcompartments, which are defined by several distinctive nuclear bodies believed to be factories of DNA or RNA processing and sites of transcriptional and/or posttranscriptional regulation. In this paper, we performed a genome-wide microscopy-based screening for proteins that form nuclear foci and characterized their localizations using markers of known nuclear bodies. In total, we identified 325 proteins localized to distinct nuclear bodies, including nucleoli (148), promyelocytic leukemia nuclear bodies (38), nuclear speckles (27), paraspeckles (24), Cajal bodies (17), Sam68 nuclear bodies (5), Polycomb bodies (2), and uncharacterized nuclear bodies (64). Functional validation revealed several proteins potentially involved in the assembly of Cajal bodies and paraspeckles. Together, these data establish the first atlas of human proteins in different nuclear bodies and provide key information for research on nuclear bodies." ;
    schema1:identifier "idr0006" ;
    schema1:license "https://creativecommons.org/licenses/by-nc-sa/3.0/" ;
    schema1:name "Whole-genome screening identifies proteins localized to distinct nuclear bodies" ;
    schema1:publisher <https://idr.openmicroscopy.org/> ;
    schema1:size <https://idr.openmicroscopy.org/study/idr0006/#file-count>,
        <https://idr.openmicroscopy.org/study/idr0006/#total-dataset-size> ;
    schema1:thumbnailUrl "https://idr.openmicroscopy.org/webgateway/render_thumbnail/353185/" ;
    rdfs:seeAlso <https://doi.org/10.1083/jcb.201303145> .

