<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1274#798a5503-7aa4-45ea-93da-7b20a6aa62ef> a schema1:Person ;
    schema1:affiliation <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1274#30d8b0be-02c8-4089-85d2-0a63027c54b6> ;
