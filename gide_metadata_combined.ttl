<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD886#064923b9-3f77-49be-8b04-3b2b43459477> a schema1:LabProtocol ;
    schema1:description "Imaging was performed using a Zeiss LSM 880 with Airyscan equipped with a Zeiss C-Apochromat 40x/1.2W numerical water objective. Imaging was performed at room temperature (approximately 25°C). 633 nm, 561 nm, and 488 nm lasers were used for excitation. Gain was adjusted for different transgenes but kept constant across experiments with the same transgene. Images were collected with physical voxel size of 0.05 x 0.05 x 0.22 µm3. All images were captured using the Zen Black acquisition software (Zeiss)." ;
    schema1:labEquipment "Zeiss 880 airyscan" ;
    schema1:measurementTechnique obo:FBbi_00000393 ;
    schema1:name "airyscan confocal imaging" .

