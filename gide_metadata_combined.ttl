<https://idr.openmicroscopy.org/study/idr0165/> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000380,
        <https://idr.openmicroscopy.org/study/idr0165/#experiment-protocol-1-0>,
        <https://idr.openmicroscopy.org/study/idr0165/#experiment-protocol-1-1>,
        <https://idr.openmicroscopy.org/study/idr0165/#experiment-protocol-1-2> ;
    schema1:about obo:NCBITaxon_9606,
        <https://idr.openmicroscopy.org/study/idr0165/#experiment-biosample-1> ;
    schema1:author <https://orcid.org/0000-0001-5105-5915> ;
    schema1:copyrightNotice "Duinkerken et al, CC-BY-4.0, 2025" ;
    schema1:datePublished "2025-02-18" ;
    schema1:description "Microscopy is a key technique to visualize and understand biology. Electron microscopy (EM) facilitates the investigation of cellular ultrastructure at biomolecular resolution. Cellular EM was recently revolutionized by automation and digitalisation allowing routine capture of large areas and volumes at nanoscale resolution. Analysis, however, is hampered by the greyscale nature of electron images and their large data volume, often requiring laborious manual annotation. Here we demonstrate unsupervised and automated extraction of biomolecular assemblies in conventionally processed tissues using large-scale hyperspectral energy-dispersive X-ray (EDX) imaging. First, we discriminated biological features in the context of tissue based on selected elemental maps. Next, we designed a data-driven workflow based on dimensionality reduction and spectral mixture analysis, allowing the visualization and isolation of subcellular features with minimal manual intervention. Broad implementations of the presented methodology will accelerate the understanding of biological ultrastructure." ;
    schema1:identifier "idr0165" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Automated analysis of ultrastructure through large-scale hyperspectral electron microscopy" ;
    schema1:publisher <https://idr.openmicroscopy.org/> ;
    schema1:thumbnailUrl "https://idr.openmicroscopy.org/webgateway/render_thumbnail/15160019/" ;
    rdfs:seeAlso <https://doi.org/10.1038/s44303-024-00059-7> .

<https://idr.openmicroscopy.org/study/idr0165/#experiment-biosample-1> a schema1:BioSample ;
    schema1:description "Large-scale scanning-transmission EM complemented with EDX imaging (STEM-EDX) on conventionally processed human pancreas and skin EM samples. The hyperspectral EDX output was subsequently used as input for automated ultrasctructure feature recognition." ;
    schema1:name "tissue" ;
    schema1:taxonomicRange obo:NCBITaxon_9606 .

<https://idr.openmicroscopy.org/study/idr0165/#experiment-protocol-1-0> a schema1:LabProtocol ;
    schema1:description "Large-scale scanning-transmission EM complemented with EDX imaging (STEM-EDX) on conventionally processed human pancreas and skin EM samples. The hyperspectral EDX output was subsequently used as input for automated ultrasctructure feature recognition." ;
    schema1:measurementTechnique obo:FBbi_00000380 ;
    schema1:name "scanning-transmission electron microscopy" .

<https://idr.openmicroscopy.org/study/idr0165/#experiment-protocol-1-1> a schema1:LabProtocol ;
    schema1:description "TEM grids containing ultrathin epon embedded tissue sections were mounted in a low background double-tilt scanning transmission electron microscopy (STEM) specimen holder optimised for EDX imaging (4022 190 50334, Thermo Fisher Scientific). Samples were imaged at 80 kiloelectronvolt (keV) on a Thermo Scientific Talos F200i STEM equipped with an S-FEG. High-angle annular dark-field (HAADF) imaging was conducted using a HAADF detector and two Bruker X-Flash 6T-100 EDX detectors for simultaneous EM and EDX imaging. Acquisition was done using Thermo Scientific Velox which also provided the used elemental maps. Thermo Fisher Scientific MAPS software was used for mosaic acquisitions. Analyis and processing: hyperspectral imaging pre-processing, extraction of endmembers, spectral unmixing and visualisation, detection and segmentation; code availability: https://github.com/amjams/Hyperspectraledx" ;
    schema1:measurementTechnique <http://www.ebi.ac.uk/efo/EFO_0003789> ;
    schema1:name "image acquisition and feature extraction protocol" .

