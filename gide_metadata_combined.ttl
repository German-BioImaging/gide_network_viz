        "Myosin Type II/metabolism",
        "Myosin-Light-Chain Phosphatase/metabolism",
        "Optogenetics[major]",
        "Synthetic Biology",
        "Xenopus" ;
    schema1:license "https://creativecommons.org/licenses/by-nc/4.0/" ;
    schema1:name "Imaging dataset for \"Optogenetic relaxation of actomyosin contractility uncovers mechanistic roles of cortical tension during cytokinesis.\"" ;
    schema1:publisher <https://ssbd.riken.jp/repository> ;
    schema1:size <https://ssbd.riken.jp/repository/ssbd-repos-000215/#file-count>,
        <https://ssbd.riken.jp/repository/ssbd-repos-000215/#total-dataset-size> ;
    rdf:seeAlso <https://doi.org/10.1038/s41467-021-27458-3> .

