<https://ssbd.riken.jp/v2/project/323-Kang-ZygoteElongate> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000249,
        obo:FBbi_00000254,
        <https://ssbd.riken.jp/v2/project/323-Kang-ZygoteElongate#imaging-protocol-1>,
        <https://ssbd.riken.jp/v2/project/323-Kang-ZygoteElongate#imaging-protocol-2> ;
    schema1:about obo:GO_0005634,
        obo:GO_0005886,
        obo:GO_0080159,
        <https://ssbd.riken.jp/v2/project/323-Kang-ZygoteElongate#biosample-1>,
        <https://www.ncbi.nlm.nih.gov/datasets/taxonomy/3702> ;
    schema1:author <https://ssbd.riken.jp/v2/project/323-Kang-ZygoteElongate#auth-001>,
        <https://ssbd.riken.jp/v2/project/323-Kang-ZygoteElongate#auth-002>,
        <https://ssbd.riken.jp/v2/project/323-Kang-ZygoteElongate#auth-003>,
        <https://ssbd.riken.jp/v2/project/323-Kang-ZygoteElongate#auth-004> ;
    schema1:datePublished "2024-11-25" ;
    schema1:description "Polarization of the zygote defines the body axis during plant development. In Arabidopsis (Arabidopsis thaliana), the zygote becomes polarized and elongates in the longitudinal direction, ultimately forming the apical–basal axis of the mature plant. Despite its importance, the mechanism for this elongation remains poorly understood. Based on live-cell imaging of the zygote, the authors developed new image analysis methods, referred to as coordinate normalization, that appropriately fix and align positions in an image, preventing fluctuation across a temporal sequence of images. Using these methods, they discovered that the zygote elongates only at its apical tip region, similar to tip-growing cells such as pollen tubes and root hairs. We also investigated the spatiotemporal dynamics of the apical tip contour of the zygote and observed that the zygote tip retains its isotropic, hemispherical apical shape during cell elongation." ;
    schema1:identifier "323-Kang-ZygoteElongate" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Coordinate normalization of Arabidopsis zygote growth." ;
    schema1:publisher <https://ssbd.riken.jp/database> ;
    schema1:size <https://ssbd.riken.jp/v2/project/323-Kang-ZygoteElongate#file-count>,
        <https://ssbd.riken.jp/v2/project/323-Kang-ZygoteElongate#total-dataset-size> ;
    schema1:thumbnailUrl "https://ssbd.riken.jp/ssbd-omero/v1/projects/1261/render_thumbnail/" ;
    rdf:seeAlso <https://doi.org/10.1093/pcp/pcad020> .

<https://ssbd.riken.jp/v2/project/323-Kang-ZygoteElongate#auth-001> a schema1:Person ;
