<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD2419#9d54543e-79fb-4822-9082-9741aaa0df85> a schema1:LabProtocol ;
    schema1:description "Stream acquisitions of 1,000 frames were acquired on a Ti-Eclipse inverted microscope (Nikon) with Spinning Disc unit CSU-X1 (Yokogawa) using a 100×/1.49 NA oil immersion objective (pixel size =  67 nm) and the 49002 ET – EGFP (Chroma) filter set with a 491 nm laser. Images were captured with the following settings: 100 ms exposure time and EM 10 MHz (100 V gain) on a QuantEM512C 512x512pixels 16bit (Photometrics) with the Perfect Focus System (Nikon) switched on. During imaging, cells were maintained under 5%CO2 and 37°C conditions using a Tokai Hit incubator." ;
    schema1:labEquipment "Ti-Eclipse inverted microscope (Nikon) with Spinning Disc unit CSU-X1 (Yokogawa) " ;
    schema1:measurementTechnique obo:FBbi_00000253 ;
    schema1:name "Single locus tracking" .

