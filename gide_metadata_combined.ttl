<https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1520> a schema1:Dataset ;
    dwciri:measurementMethod obo:FBbi_00000246,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1520#77239291-a848-42f5-a339-690372071be4>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1520#8fe82ef0-0292-4390-bc5f-509af7322de9> ;
    schema1:about obo:NCBITaxon_10090,
        obo:NCBITaxon_9606,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1520#43b13694-77b2-4ca3-b985-04b005bff59d>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1520#4e379d07-7d20-468e-9db1-5580961fe8ae> ;
    schema1:author <https://orcid.org/0000-0002-1186-2517>,
        <https://orcid.org/0000-0003-3794-1309> ;
    schema1:datePublished "2024-12-16" ;
    schema1:description "Idiopathic pulmonary fibrosis (IPF) is a progressive and lethal disease characterized by excessive extracellular matrix (ECM) deposition. Current IPF therapies slow disease progression but do not stop or reverse it. The (myo)fibroblasts are thought to be the main cellular contributors to excessive ECM production in IPF. Here we report that fibrotic AT2 cells regulate production and crosslinking of ECM via the co-transcriptional activator YAP. YAP leads to increased expression of Lysyl oxidase (LOX) and subsequent LOX mediated crosslinking by fibrotic AT2 cells. Pharmacological YAP inhibition via verteporfin reverses fibrotic AT2 cell reprogramming and LOX expression in experimental lung fibrosis in vivo and in human fibrotic tissue ex vivo. We thus identify YAP-TEAD/LOX inhibition in AT2 cells as a promising potential new therapy for IPF patients. " ;
    schema1:identifier "S-BIAD1520" ;
    schema1:keywords "Fibrosis",
        "Hippo",
        "LOX ",
        "YAP/TAZ",
        "epithelial cell reprogramming",
        "extracellular matrix",
        "respiratory disorder" ;
    schema1:license "https://creativecommons.org/licenses/by/4.0/" ;
    schema1:name "Inhibition of epithelial cell YAP-TEAD/LOX signaling attenuates pulmonary fibrosis" ;
    schema1:publisher <https://www.ebi.ac.uk/bioimage-archive/> ;
    schema1:size <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1520#1037e7dd-b10a-47a1-885c-1f3b2998ff1c>,
        <https://www.ebi.ac.uk/biostudies/bioimages/studies/S-BIAD1520#480bb0bc-db43-46e5-88ae-071380b9d63c> ;
    schema1:thumbnailUrl "https://uk1s3.embassy.ebi.ac.uk/bia-integrator-data/S-BIAD1520/2f7c28aa-8ee2-4d47-a6d4-e155ce683057/4aecbcfb-ec25-455c-b4ce-7452639e3179.png" .

